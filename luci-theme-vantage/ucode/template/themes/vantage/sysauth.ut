{#
 Vantage theme - login page.
 Rendered with { duser, fuser } for visitors who are not logged in, so it
 shows nothing about the device: no hostname, model or firmware version.
 fuser is attacker-controlled (formvalue also reads the query string): it is
 only tested, never echoed; the error is generic. The form posts back to the
 requested URL (no action attribute). The inline script is data-free: the
 HTTPS probe reads its port list from an entity-encoded data attribute.
-#}
{%
	let tls = uci.get('uhttpd', 'main', 'listen_https') ?? [];
	if (type(tls) == 'string')
		tls = split(tls, /\s+/);
	const tls_ports = uniq(filter(map(tls, e => +(match(e, /\d+$/)?.[0] ?? 0)), p => (p > 0 && p <= 65535)));
-%}
<!DOCTYPE html>
<html lang="{{ entityencode(dispatcher.lang ?? 'en', true) }}" data-darkmode="true">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<meta name="robots" content="noindex">
<title>{{ entityencode(_('Log in'), true) }} · LuCI</title>
<script>
(function (r) {
	var p = 'auto';
	try { p = localStorage.getItem('vantage.theme') || 'auto'; } catch (e) {}
	var dark = (p === 'dark') || (p !== 'light' && !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches));
	r.setAttribute('data-darkmode', dark ? 'true' : 'false');
	r.setAttribute('data-theme', p);
})(document.documentElement);
</script>
<link rel="stylesheet" href="{{ media }}/vantage.css">
<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
</head>
<body class="vt-login-page" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
<main class="vt-login">
	<div class="vt-login-card">
		<div class="vt-login-head">
			<svg class="vt-login-mark" viewBox="0 0 32 32" width="44" height="44" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"/><path d="M9 10.5 16 22" class="vt-brand-l"/><path d="M16 22 23 10.5" class="vt-brand-r"/><circle cx="23" cy="10.5" r="1.9" class="vt-brand-dot"/></svg>
			<div>
				<h1 class="vt-login-title">Vantage</h1>
				<p class="vt-login-sub"><span class="vt-live-dot" aria-hidden="true"></span>{{ entityencode(_('Authorization Required'), true) }}</p>
			</div>
		</div>

{% if (fuser): %}
		<div class="vt-login-error" role="alert">{{ entityencode(_('Invalid username and/or password! Please try again.'), true) }}</div>
{% endif %}

		<form method="post" class="vt-login-form" data-https-ports="{{ entityencode(sprintf('%J', tls_ports), true) }}" data-https-probe="{{ entityencode(resource + '/icons/loading.svg', true) }}">
			<label class="vt-field">
				<span class="vt-field-label">{{ entityencode(_('Username'), true) }}</span>
				<input class="cbi-input-text" type="text" name="luci_username" autocomplete="username" autocapitalize="off" spellcheck="false" required value="{{ entityencode(duser ?? '', true) }}">
			</label>
			<label class="vt-field">
				<span class="vt-field-label">{{ entityencode(_('Password'), true) }}</span>
				<input class="cbi-input-password" type="password" name="luci_password" autocomplete="current-password" autofocus>
			</label>
			<button type="submit" class="btn cbi-button cbi-button-apply vt-login-submit">{{ entityencode(_('Log in'), true) }}</button>
		</form>
	</div>
</main>
<script>
(function (form) {
	var pw = document.querySelector('input[name="luci_password"]');
	if (pw) pw.focus();
	if (!form || location.protocol === 'https:') return;
	var ports = [];
	try { ports = JSON.parse(form.getAttribute('data-https-ports') || '[]'); } catch (e) {}
	var probePath = form.getAttribute('data-https-probe') || '';
	if (!Array.isArray(ports) || probePath.charAt(0) !== '/') return;
	ports.forEach(function (port) {
		if (typeof port !== 'number' || port < 1 || port > 65535 || port % 1) return;
		var probe = new Image(), base = 'https://' + location.hostname + ':' + port;
		probe.onload = function () { location = base + location.pathname; };
		probe.src = base + probePath + '?' + Math.random();
		setTimeout(function () { probe.src = ''; }, 5000);
	});
})(document.querySelector('form.vt-login-form'));
</script>
</body>
</html>
