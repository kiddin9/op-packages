{#
 Vantage theme - header.
 Data-free: host details and the menu are fetched by menu-vantage.js over
 rpc after login. Everything request-derived is entity-encoded; visitors who
 are not logged in (login redirect, 404, CSRF error) get the bare frame with
 no menu, no host details and a generic title from this template. LuCI's
 core header.ut, which includes this one, then prints its own
 L = new LuCI({...}) script (LuCI build, nodespec; on an anonymous 404 the
 whole menu tree): upstream, see docs/luci-contract.md section 2.
-#}
{%
	const authed = !!ctx.authsession;
	const page_title = (authed && dispatched?.title) ? striptags(_(dispatched.title)) : 'LuCI';
	const lang = entityencode(dispatcher.lang ?? 'en', true);
	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');
-%}
<!DOCTYPE html>
<html lang="{{ lang }}" data-darkmode="true">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>{{ entityencode(page_title, true) }} · LuCI</title>
<script>
(function (r) {
	var p = 'auto', rail = 'pinned';
	try { p = localStorage.getItem('vantage.theme') || 'auto'; rail = localStorage.getItem('vantage.rail') || 'pinned'; } catch (e) {}
	var dark = (p === 'dark') || (p !== 'light' && !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches));
	r.setAttribute('data-darkmode', dark ? 'true' : 'false');
	r.setAttribute('data-theme', p);
	if (rail === 'pinned') r.setAttribute('data-rail', 'pinned');
})(document.documentElement);
</script>
<link rel="stylesheet" href="{{ media }}/vantage.css">
<link rel="stylesheet" href="{{ media }}/icons.css">
<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
<script src="{{ entityencode(dispatcher.build_url('admin/translations', dispatcher.lang), true) }}"></script>
<script src="{{ resource }}/cbi.js"></script>
</head>
<body class="lang_{{ lang }}{{ authed ? ' vt-auth' : ' vt-anon' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
{% if (blank_page): %}
<div id="indicators" hidden></div>
<div id="maincontent" class="vt-blank">
{% else %}
<a class="vt-skip" href="#maincontent">{{ entityencode(_('Skip to content'), true) }}</a>
<div class="vt-shell">
{% if (authed): %}
	<nav class="vt-rail" id="vt-rail" aria-label="{{ entityencode(_('Main navigation'), true) }}">
		<a class="vt-brand" href="{{ dispatcher.build_url('admin') }}" aria-label="{{ entityencode(_('Home'), true) }}">
			<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
			<rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"></rect>
			<path d="M10 10.5 10 21.5" class="vt-brand-l"></path>
			<path d="M10 16 21.5 10.5" class="vt-brand-r"></path>
			<path d="M10 16 21.5 21.5" class="vt-brand-r"></path>
			<circle cx="21.5" cy="10.5" r="1.9" class="vt-brand-dot"></circle>
			<circle cx="21.5" cy="21.5" r="1.9" class="vt-brand-dot"></circle>
			</svg>
			<span class="vt-brand-word">{{ hostname }}</span>
		</a>
		<ul class="vt-rail-list" id="vt-rail-list"></ul>
		<div class="vt-rail-foot">
			<button type="button" class="vt-rail-pin" id="vt-rail-pin" aria-pressed="false" aria-label="{{ entityencode(_('Expand navigation'), true) }}" title="{{ entityencode(_('Expand navigation'), true) }}">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 5v14M9 12h11M15 7l5 5-5 5"/></svg>
			</button>
		</div>
	</nav>
	<div class="vt-flyout" id="vt-flyout" hidden></div>
	<div class="vt-scrim" id="vt-scrim" hidden></div>
{% endif %}
	<div class="vt-frame">
		<header class="vt-topbar">
{% if (!authed): %}
			<span class="vt-brand vt-brand-static" aria-hidden="true">
				<svg viewBox="0 0 32 32" width="28" height="28"><rect x="1" y="1" width="30" height="30" rx="7" class="vt-brand-tile"/><path d="M9 10.5 16 22" class="vt-brand-l"/><path d="M16 22 23 10.5" class="vt-brand-r"/><circle cx="23" cy="10.5" r="1.9" class="vt-brand-dot"/></svg>
			</span>
{% endif %}
			<nav class="vt-crumbs" id="vt-crumbs" aria-label="{{ entityencode(_('Breadcrumb'), true) }}"><span class="vt-crumb vt-crumb-current">{{ entityencode(page_title, true) }}</span></nav>
			<div class="vt-top-actions">
{% if (authed): %}
				<button type="button" class="vt-search" id="vt-search-btn" aria-haspopup="dialog" aria-keyshortcuts="Control+K /">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
					<span class="vt-search-label">{{ entityencode(_('Search pages'), true) }}</span>
					<kbd class="vt-kbd">Ctrl K</kbd>
				</button>
{% endif %}
				<div id="indicators" class="vt-indicators" aria-live="polite"></div>
{% if (authed): %}
				<span class="vt-host" id="vt-host" hidden></span>
				<button type="button" class="vt-icon-btn" id="vt-theme" aria-label="{{ entityencode(_('Colour theme'), true) }}" title="{{ entityencode(_('Colour theme'), true) }}">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" class="vt-fill"/></svg>
				</button>
				<a class="vt-icon-btn" href="{{ dispatcher.build_url('admin/logout') }}" aria-label="{{ entityencode(_('Log out'), true) }}" title="{{ entityencode(_('Log out'), true) }}">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14"/><path d="M10 8l-4 4 4 4M6 12h10"/></svg>
				</a>
{% endif %}
			</div>
		</header>
		<nav class="vt-tabs" id="vt-tabs" aria-label="{{ entityencode(_('Page tabs'), true) }}" hidden></nav>
		<main id="maincontent" class="vt-main">
{% endif %}
