#!/bin/sh /etc/rc.common
# Audio Volume - 在 MPD 启动后设置默认音量
# 注意：仅在"没有持久状态文件"时设置，避免覆盖用户手动调过的音量

START=94
STOP=98

. /lib/functions.sh

log() { logger -t dlna-player-volume "$@"; }

start() {
	local enabled volume persist

	config_load dlna-player
	config_get enabled main enabled 1
	config_get volume  main volume '40'
	config_get persist main persist_volume '1'

	[ "$enabled" = "1" ] || return 0

	# 等 MPD 起来
	local i=0
	while [ $i -lt 15 ]; do
		mpc status >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	# 有持久状态就不动它
	if [ "$persist" = "1" ] && [ -f /etc/mpd/mpdstate ]; then
		log "persistent state found, keep user volume"
		return 0
	fi

	mpc volume "$volume" 2>/dev/null
	log "set default volume to ${volume}%"
}

stop() { :; }
