#!/bin/sh /etc/rc.common
# DLNA Music Player - 声卡初始化 + MPD/upmpdcli 配置
# 在 MPD 之前运行，负责把声卡准备好

START=50
STOP=99

. /lib/functions.sh

MUSIC_DIR_DEFAULT="/srv/music"
MPD_CONF="/etc/mpd.conf"
MPD_STATE_DIR="/etc/mpd"

log() { logger -t dlna-player "$@"; }

# 刷新前端文件 mtime，避免浏览器因"文件没变"而使用旧缓存
refresh_web_cache() {
	touch /www/luci-static/resources/view/dlna-player2.js 2>/dev/null
	rm -f /tmp/luci-indexcache* 2>/dev/null
}

# ---------- 自动探测声卡 ----------
detect_device() {
	local dev

	# 1) 优先选名字里带 Analog 的（板载模拟输出）
	dev=$(aplay -l 2>/dev/null \
		| grep -i 'analog' \
		| head -n1 \
		| sed -n 's/^card \([0-9]*\): .*device \([0-9]*\):.*/hw:\1,\2/p')
	[ -n "$dev" ] && { echo "$dev"; return 0; }

	# 2) 退而求其次：排除 Dummy / pcsp / HDMI，取第一个可播放设备
	dev=$(aplay -l 2>/dev/null \
		| grep '^card ' \
		| grep -viE 'dummy|pcsp|hdmi|iec958' \
		| head -n1 \
		| sed -n 's/^card \([0-9]*\): .*device \([0-9]*\):.*/hw:\1,\2/p')
	[ -n "$dev" ] && { echo "$dev"; return 0; }

	return 1
}

# ---------- 等声卡就绪 ----------
wait_soundcard() {
	local i=0
	while [ $i -lt 30 ]; do
		[ -d /proc/asound ] && aplay -l >/dev/null 2>&1 && return 0
		sleep 1
		i=$((i + 1))
	done
	return 0
}

# ---------- 生成 mpd.conf ----------
gen_mpd_conf() {
	local dev="$1" music="$2"

	cat > "$MPD_CONF" <<EOF
# Generated by luci-app-dlna-player - do not edit manually
music_directory     "$music"
playlist_directory  "/var/lib/mpd/playlists"
db_file             "/var/lib/mpd/mpd.db"
log_file            "syslog"
pid_file            "/var/run/mpd.pid"
state_file          "$MPD_STATE_DIR/mpdstate"
bind_to_address     "127.0.0.1"
port                "6600"
auto_update         "yes"

audio_output {
    type        "alsa"
    name        "Analog Output"
    device      "$dev"
    mixer_type  "software"
}

input {
    plugin "curl"
}
EOF
}

start() {
	local enabled device music volume dlna unmute persist

	config_load dlna-player
	config_get enabled main enabled 1
	config_get device  main device ''
	config_get music   main music_dir "$MUSIC_DIR_DEFAULT"
	config_get volume  main volume '40'
	config_get dlna    main dlna_name ''
	config_get unmute  main unmute '1'
	config_get persist main persist_volume '1'

	[ "$enabled" = "1" ] || {
		# 关闭时：不只是"不配置"，还要真正停掉服务
		log "disabled - stopping services"
		/etc/init.d/mpd stop 2>/dev/null
		/etc/init.d/mpd disable 2>/dev/null
		/etc/init.d/upmpdcli stop 2>/dev/null
		/etc/init.d/upmpdcli disable 2>/dev/null
		refresh_web_cache
		return 0
	}

	# 启用时：确保两个服务开机自启，并且现在就跑起来
	/etc/init.d/mpd enable 2>/dev/null
	/etc/init.d/upmpdcli enable 2>/dev/null
	pidof mpd >/dev/null 2>&1 || /etc/init.d/mpd start 2>/dev/null
	# upmpdcli 用 restart：既保证运行，又能让新的 DLNA 名称生效
	/etc/init.d/upmpdcli restart 2>/dev/null

	# --- 1. 等声卡 ---
	wait_soundcard

	# --- 2. 探测设备 ---
	if [ -z "$device" ]; then
		device=$(detect_device)
		if [ -z "$device" ]; then
			log "no usable sound card found!"
			return 1
		fi
		log "auto-detected sound card: $device"
	else
		log "using configured sound card: $device"
	fi

	# --- 2.1 检查 PulseAudio 冲突 ---
	# PulseAudio 会抢占 ALSA 设备，导致 MPD 无声
	if pidof pulseaudio >/dev/null 2>&1; then
		log "WARNING: pulseaudio is running and may grab the sound card!"
		log "WARNING: run '/etc/init.d/pulseaudio stop; /etc/init.d/pulseaudio disable' if MPD has no sound"
	fi

	# --- 3. 声卡权限（/dev 是 tmpfs，每次开机都要修）---
	chmod 666 /dev/snd/* 2>/dev/null

	# --- 4. 恢复混音器状态 + 解除静音 ---
	# 先尝试恢复上次保存的混音器状态（/etc 是持久目录）
	[ -f /etc/alsa/asound.state ] && alsactl restore -f /etc/alsa/asound.state 2>/dev/null

	if [ "$unmute" = "1" ]; then
		local card="${device#hw:}"     # 3,0
		card="${card%%,*}"             # 3
		amixer -c "$card" sset 'Master' 100% unmute 2>/dev/null
	fi

	# --- 5. 音乐目录 ---
	[ -d "$music" ] || mkdir -p "$music"
	chmod 755 "$music"
	chown -R mpd:mpd "$music" 2>/dev/null

	# --- 6. MPD 运行目录（/var 是 tmpfs）---
	mkdir -p /var/lib/mpd/playlists
	chown -R mpd:mpd /var/lib/mpd 2>/dev/null
	mkdir -p "$MPD_STATE_DIR"

	# --- 6.1 确保 MPD 以 root 运行 ---
	# 原因：PulseAudio 等其他服务会重置 /dev/snd 权限，mpd 用户可能打不开声卡
	# 每次开机都检查，避免 MPD 包升级后补丁丢失
	if [ -f /etc/init.d/mpd ]; then
		if grep -q '^USER="mpd"' /etc/init.d/mpd; then
			sed -i 's/^USER="mpd"/USER="root"/; s/^GROUP="mpd"/GROUP="root"/' /etc/init.d/mpd
			log "patched mpd init to run as root"
		fi
	fi

	# --- 7. 生成 mpd.conf ---
	gen_mpd_conf "$device" "$music"

	# --- 8. upmpdcli 名称 ---
	[ -z "$dlna" ] && dlna="$(uci get system.@system[0].hostname 2>/dev/null)"
	[ -z "$dlna" ] && dlna="OpenWrt Audio"
	uci -q set upmpdcli.lan=upmpdcli
	uci -q set upmpdcli.lan.interface='br-lan'
	uci -q set upmpdcli.lan.friendly_name="$dlna"
	uci -q commit upmpdcli

	log "dlna-player done (device=$device, volume=$volume)"
	refresh_web_cache
}

stop() {
	# 关机时保存混音器状态（/etc 是持久目录，重启后能恢复）
	mkdir -p /etc/alsa 2>/dev/null
	alsactl store -f /etc/alsa/asound.state 2>/dev/null
	log "stopped, mixer state saved"
}

reload() {
	stop
	start
}
