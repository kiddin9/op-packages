#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 Dante <dante@seckv.com>

LOG_FILE="/var/log/fancontrol.log"
CONFIG="fancontrol"

log_msg() {
	local level="$1"
	local msg="$2"
	local timestamp
	timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "${timestamp} [${level}] ${msg}" >> "${LOG_FILE}"

	# 保持日志行数在 200 行以内
	if [ -f "${LOG_FILE}" ]; then
		local lines
		lines=$(wc -l < "${LOG_FILE}" 2>/dev/null || echo 0)
		if [ "${lines}" -gt 200 ]; then
			local tmp_log
			tmp_log="$(tail -n 100 "${LOG_FILE}")"
			echo "${tmp_log}" > "${LOG_FILE}"
		fi
	fi
}

# 寻找硬件节点
find_nodes() {
	THERMAL_ZONE=""
	COOLING_DEV=""
	HWMON_PWM=""

	# 优先寻找 thermal_zone0
	if [ -f "/sys/class/thermal/thermal_zone0/temp" ]; then
		THERMAL_ZONE="/sys/class/thermal/thermal_zone0"
	else
		for z in /sys/class/thermal/thermal_zone*; do
			if [ -f "${z}/temp" ]; then
				THERMAL_ZONE="${z}"
				break
			fi
		done
	fi

	# 寻找 pwm-fan 冷却设备
	for c in /sys/class/thermal/cooling_device*; do
		if [ -f "${c}/type" ]; then
			local ctype
			ctype=$(cat "${c}/type" 2>/dev/null)
			if [ "${ctype}" = "pwm-fan" ] || [ "${ctype}" = "pwmfan" ]; then
				COOLING_DEV="${c}"
				break
			fi
		fi
	done

	# 寻找 hwmon pwm 节点
	for h in /sys/class/hwmon/hwmon*; do
		if [ -f "${h}/name" ]; then
			local hname
			hname=$(cat "${h}/name" 2>/dev/null)
			if [ "${hname}" = "pwmfan" ] && [ -f "${h}/pwm1" ]; then
				HWMON_PWM="${h}/pwm1"
				break
			fi
		fi
	done
}

get_temperature() {
	if [ -n "${THERMAL_ZONE}" ] && [ -f "${THERMAL_ZONE}/temp" ]; then
		cat "${THERMAL_ZONE}/temp" 2>/dev/null || echo "0"
	else
		echo "0"
	fi
}

set_fan_level() {
	local lvl="$1"
	if [ -n "${COOLING_DEV}" ] && [ -w "${COOLING_DEV}/cur_state" ]; then
		echo "${lvl}" > "${COOLING_DEV}/cur_state" 2>/dev/null
	fi
	if [ -n "${HWMON_PWM}" ] && [ -w "${HWMON_PWM}" ]; then
		local pwm_val=0
		case "${lvl}" in
			0) pwm_val=0 ;;
			1) pwm_val=80 ;;
			2) pwm_val=128 ;;
			3) pwm_val=255 ;;
			*) pwm_val=0 ;;
		esac
		echo "${pwm_val}" > "${HWMON_PWM}" 2>/dev/null
	fi
}

get_level_name() {
	case "$1" in
		0) echo "0 级 (停转)" ;;
		1) echo "1 级 (低速 31%)" ;;
		2) echo "2 级 (中速 50%)" ;;
		3) echo "3 级 (全速 100%)" ;;
		*) echo "$1 级" ;;
	esac
}

calc_level() {
	local temp="$1"
	local cur="$2"
	local l1="$3"
	local l2="$4"
	local l3="$5"
	local h="$6"

	if [ "${cur}" -le 0 ]; then
		if [ "${temp}" -ge "${l3}" ]; then
			echo 3
		elif [ "${temp}" -ge "${l2}" ]; then
			echo 2
		elif [ "${temp}" -ge "${l1}" ]; then
			echo 1
		else
			echo 0
		fi
	elif [ "${cur}" -eq 1 ]; then
		if [ "${temp}" -ge "${l3}" ]; then
			echo 3
		elif [ "${temp}" -ge "${l2}" ]; then
			echo 2
		elif [ "${temp}" -lt "$((l1 - h))" ]; then
			echo 0
		else
			echo 1
		fi
	elif [ "${cur}" -eq 2 ]; then
		if [ "${temp}" -ge "${l3}" ]; then
			echo 3
		elif [ "${temp}" -lt "$((l1 - h))" ]; then
			echo 0
		elif [ "${temp}" -lt "$((l2 - h))" ]; then
			echo 1
		else
			echo 2
		fi
	else
		if [ "${temp}" -lt "$((l1 - h))" ]; then
			echo 0
		elif [ "${temp}" -lt "$((l2 - h))" ]; then
			echo 1
		elif [ "${temp}" -lt "$((l3 - h))" ]; then
			echo 2
		else
			echo 3
		fi
	fi
}

cleanup() {
	if [ -n "${THERMAL_ZONE}" ] && [ -w "${THERMAL_ZONE}/policy" ]; then
		echo "step_wise" > "${THERMAL_ZONE}/policy" 2>/dev/null
	fi
	log_msg "信息" "风扇控制守护服务已停止，已恢复内核温控策略"
	exit 0
}

trap cleanup INT TERM QUIT

find_nodes

if [ -z "${COOLING_DEV}" ] && [ -z "${HWMON_PWM}" ]; then
	log_msg "错误" "未找到可用的风扇硬件控制节点，服务退出"
	exit 1
fi

enabled=$(uci -q get ${CONFIG}.global.enabled || echo 1)
if [ "${enabled}" != "1" ]; then
	log_msg "信息" "服务配置为未启用状态，退出"
	exit 0
fi

mode=$(uci -q get ${CONFIG}.global.mode || echo "auto")
interval=$(uci -q get ${CONFIG}.global.interval || echo 5)
start_spin=$(uci -q get ${CONFIG}.global.start_spin || echo 1)
temp_low=$(uci -q get ${CONFIG}.global.temp_low || echo 45)
temp_med=$(uci -q get ${CONFIG}.global.temp_med || echo 60)
temp_high=$(uci -q get ${CONFIG}.global.temp_high || echo 75)
hysteresis=$(uci -q get ${CONFIG}.global.hysteresis || echo 3)
manual_level=$(uci -q get ${CONFIG}.global.manual_level || echo 2)

[ "${interval}" -lt 1 ] 2>/dev/null && interval=1
[ "${interval}" -gt 60 ] 2>/dev/null && interval=60

log_msg "信息" "风扇控制守护服务启动，运行模式: ${mode}，检测周期: ${interval} 秒"

# 启动自检
if [ "${start_spin}" = "1" ] && [ "${mode}" != "kernel" ]; then
	log_msg "信息" "执行启动自检，全速运转 2 秒以清洁防尘"
	set_fan_level 3
	sleep 2
fi

# 非内核模式下切换为用户空间接管，防止内核 step_wise 依据 40°C 强制拉高转速
if [ "${mode}" != "kernel" ] && [ -n "${THERMAL_ZONE}" ] && [ -w "${THERMAL_ZONE}/policy" ]; then
	echo "user_space" > "${THERMAL_ZONE}/policy" 2>/dev/null
fi

current_level=-1

while true; do
	case "${mode}" in
		"kernel")
			# 内核托管模式
			if [ -n "${THERMAL_ZONE}" ] && [ -w "${THERMAL_ZONE}/policy" ]; then
				echo "step_wise" > "${THERMAL_ZONE}/policy" 2>/dev/null
			fi
			sleep "${interval}"
			;;

		"manual")
			if [ "${current_level}" -ne "${manual_level}" ]; then
				set_fan_level "${manual_level}"
				current_level="${manual_level}"
				lvl_name=$(get_level_name "${manual_level}")
				log_msg "信息" "手动定速模式生效，当前档位设定为: ${lvl_name}"
			fi
			sleep "${interval}"
			;;

		"auto"|*)
			raw_t=$(get_temperature)
			# 单位毫摄氏度转整数摄氏度
			t_c=$((raw_t / 1000))
			t_dec=$(((raw_t % 1000) / 100))
			target_lvl=$(calc_level "${t_c}" "${current_level}" "${temp_low}" "${temp_med}" "${temp_high}" "${hysteresis}")

			if [ "${target_lvl}" -ne "${current_level}" ]; then
				set_fan_level "${target_lvl}"
				old_name=$(get_level_name "${current_level}")
				new_name=$(get_level_name "${target_lvl}")
				if [ "${current_level}" -eq -1 ]; then
					log_msg "信息" "初始化风扇档位: 当前温度 ${t_c}.${t_dec} °C，设定为 ${new_name}"
				else
					log_msg "信息" "温度变化 (${t_c}.${t_dec} °C): 档位由 ${old_name} 调整为 ${new_name}"
				fi
				current_level="${target_lvl}"
			fi
			sleep "${interval}"
			;;
	esac
done
