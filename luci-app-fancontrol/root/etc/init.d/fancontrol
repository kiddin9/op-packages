USE_PROCD=1
START=95
STOP=10

PROG="/usr/sbin/fancontrold"
CONFIG="fancontrol"

start_service() {
	local enabled
	enabled=$(uci -q get "${CONFIG}.global.enabled" || echo 0)
	[ "${enabled}" = "1" ] || return 0

	chmod 755 "${PROG}" 2>/dev/null

	# 启动前清理任何可能残留的孤儿进程
	killall -q fancontrold 2>/dev/null

	procd_open_instance "main"
	procd_set_param command "${PROG}"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -q fancontrold 2>/dev/null
	if [ -f "/sys/class/thermal/thermal_zone0/policy" ]; then
		echo "step_wise" > "/sys/class/thermal/thermal_zone0/policy" 2>/dev/null
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "${CONFIG}"
}
