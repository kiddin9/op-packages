{
	"luci-app-apfree-wifidog": {
		"description": "Grant access to LuCI app apfree-wifidog",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"luci.wifidogx": [ "get_location", "get_wan_mac" ]
			},
			"file": {
				"/etc/init.d/wifidogx": [ "exec" ],
				"/usr/bin/wdctlx": [ "exec" ]
			},
			"uci": ["wifidogx", "network"]
		},
		"write": {
			"uci": ["wifidogx"],
			"file": {
				"/etc/wifidogx/*": [ "write" ]
			}
		}
	}
}
