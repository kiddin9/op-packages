MARKER="${SMARTSAFEHUB_RECOVERY_MARKER:-/etc/smartsafehub/password-recovery}"
SHADOW_FILE="${SMARTSAFEHUB_RECOVERY_SHADOW_FILE:-/etc/shadow}"
UBUS_BIN="${SMARTSAFEHUB_RECOVERY_UBUS_BIN:-/bin/ubus}"
JSONFILTER_BIN="${SMARTSAFEHUB_RECOVERY_JSONFILTER_BIN:-/usr/bin/jsonfilter}"
SESSION_TIMEOUT="${SMARTSAFEHUB_RECOVERY_SESSION_TIMEOUT:-900}"

reply_json() {
	status="$1"
	payload="$2"
	printf 'Status: %s\r\n' "$status"
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store, max-age=0\r\n'
	printf 'Pragma: no-cache\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n'
	printf '\r\n'
	printf '%s\n' "$payload"
}

root_password_empty() {
	[ -r "$SHADOW_FILE" ] || return 1

	while IFS=: read -r username password_hash _rest; do
		[ "$username" = 'root' ] || continue
		[ -z "$password_hash" ]
		return
	done < "$SHADOW_FILE"

	return 1
}

destroy_session() {
	sid="$1"
	[ -n "$sid" ] || return 0
	"$UBUS_BIN" call session destroy \
		"{\"ubus_rpc_session\":\"$sid\"}" >/dev/null 2>&1 || true
}

[ "${REQUEST_METHOD:-GET}" = 'GET' ] || {
	reply_json '405 Method Not Allowed' '{"active":false}'
	exit 0
}

# Physical password recovery is the only state in which an unauthenticated
# browser may obtain this short-lived RPC session. It never receives general
# administrator ACLs: only the status and initial-password setter required to
# finish the recovery flow are granted.
if [ ! -f "$MARKER" ] || ! root_password_empty; then
	reply_json '200 OK' '{"active":false}'
	exit 0
fi

[ -x "$UBUS_BIN" ] && [ -x "$JSONFILTER_BIN" ] || {
	reply_json '503 Service Unavailable' '{"active":false}'
	exit 0
}

created="$($UBUS_BIN call session create "{\"timeout\":$SESSION_TIMEOUT}" 2>/dev/null)" || {
	reply_json '503 Service Unavailable' '{"active":false}'
	exit 0
}

sid="$(printf '%s\n' "$created" | "$JSONFILTER_BIN" -e '@.ubus_rpc_session' 2>/dev/null || true)"
if [ "${#sid}" -ne 32 ]; then
	destroy_session "$sid"
	reply_json '503 Service Unavailable' '{"active":false}'
	exit 0
fi
case "$sid" in
	*[!0-9a-fA-F]*)
		destroy_session "$sid"
		reply_json '503 Service Unavailable' '{"active":false}'
		exit 0
		;;
esac

grant="{\"ubus_rpc_session\":\"$sid\",\"scope\":\"ubus\",\"objects\":[[\"smartsafehub\",\"system_root_password_status\"],[\"smartsafehub\",\"system_root_password_set\"]]}"
if ! "$UBUS_BIN" call session grant "$grant" >/dev/null 2>&1; then
	destroy_session "$sid"
	reply_json '503 Service Unavailable' '{"active":false}'
	exit 0
fi

reply_json '200 OK' "{\"active\":true,\"sessionId\":\"$sid\"}"
