#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -u

STATE_DIR="${SMARTSAFEHUB_RECOVERY_STATE_DIR:-/etc/smartsafehub}"
MARKER_FILE="${SMARTSAFEHUB_RECOVERY_MARKER_FILE:-$STATE_DIR/password-recovery}"
SHADOW_FILE="${SMARTSAFEHUB_RECOVERY_SHADOW_FILE:-/etc/shadow}"
PASSWD_BIN="${SMARTSAFEHUB_RECOVERY_PASSWD_BIN:-passwd}"
DROPBEAR_INIT="${SMARTSAFEHUB_RECOVERY_DROPBEAR_INIT:-/etc/init.d/dropbear}"
REBOOT_BIN="${SMARTSAFEHUB_RECOVERY_REBOOT_BIN:-reboot}"
LOGGER_BIN="${SMARTSAFEHUB_RECOVERY_LOGGER_BIN:-logger}"

log_notice() {
	"$LOGGER_BIN" -t smartsafehub-password-recovery -- "$*" 2>/dev/null || true
}

root_password_configured() {
	[ -r "$SHADOW_FILE" ] || return 2

	local password_hash
	password_hash="$(awk -F: '$1 == "root" { print $2; found=1; exit } END { if (!found) exit 2 }' "$SHADOW_FILE" 2>/dev/null)" || return 2
	[ -n "$password_hash" ]
}

marker_dropbear_enabled() {
	[ -f "$MARKER_FILE" ] || return 1
	grep -qx 'dropbear_enabled=1' "$MARKER_FILE" 2>/dev/null
}

restore_dropbear() {
	[ -x "$DROPBEAR_INIT" ] || return 0

	if marker_dropbear_enabled; then
		"$DROPBEAR_INIT" enable >/dev/null 2>&1 || true
		"$DROPBEAR_INIT" start >/dev/null 2>&1 || true
	else
		"$DROPBEAR_INIT" stop >/dev/null 2>&1 || true
		"$DROPBEAR_INIT" disable >/dev/null 2>&1 || true
	fi
}

complete_recovery() {
	[ -f "$MARKER_FILE" ] || return 0

	restore_dropbear
	rm -f "$MARKER_FILE" || return 1
	log_notice 'administrator password recovery completed'
	return 0
}

boot_reconcile() {
	[ -f "$MARKER_FILE" ] || return 0

	if root_password_configured; then
		# A password was restored outside SmartSafeHub. Remove stale recovery
		# state and restore the SSH service to its pre-recovery enable state.
		complete_recovery
		return $?
	fi

	# Do not expose passwordless root SSH while the browser recovery flow is
	# waiting for a new administrator password.
	if [ -x "$DROPBEAR_INIT" ]; then
		"$DROPBEAR_INIT" stop >/dev/null 2>&1 || true
		"$DROPBEAR_INIT" disable >/dev/null 2>&1 || true
	fi
	return 0
}

request_recovery() {
	root_password_configured
	local password_status=$?
	if [ "$password_status" -ne 0 ]; then
		case "$password_status" in
			1)
				log_notice 'administrator password recovery skipped because root password is already empty'
				return 0
				;;
			*)
				log_notice 'administrator password recovery failed because root password state is unavailable'
				return 1
				;;
		esac
	fi

	mkdir -p "$STATE_DIR" || return 1
	chmod 700 "$STATE_DIR" 2>/dev/null || true
	umask 077

	local dropbear_enabled=0 marker_tmp
	if [ -x "$DROPBEAR_INIT" ] && "$DROPBEAR_INIT" enabled >/dev/null 2>&1; then
		dropbear_enabled=1
	fi

	marker_tmp="$MARKER_FILE.tmp.$$"
	{
		printf '%s\n' 'schema=1'
		printf '%s\n' 'reset_policy=smartsafehub-v1'
		printf 'dropbear_enabled=%s\n' "$dropbear_enabled"
	} > "$marker_tmp" || {
		rm -f "$marker_tmp"
		return 1
	}
	mv -f "$marker_tmp" "$MARKER_FILE" || {
		rm -f "$marker_tmp"
		return 1
	}

	if [ -x "$DROPBEAR_INIT" ]; then
		"$DROPBEAR_INIT" stop >/dev/null 2>&1 || true
		if ! "$DROPBEAR_INIT" disable >/dev/null 2>&1; then
			log_notice 'administrator password recovery failed while disabling SSH'
			restore_dropbear
			rm -f "$MARKER_FILE"
			return 1
		fi
	fi

	if ! "$PASSWD_BIN" -d root >/dev/null 2>&1; then
		log_notice 'administrator password recovery failed while clearing root password'
		restore_dropbear
		rm -f "$MARKER_FILE"
		return 1
	fi

	log_notice 'administrator password recovery requested; rebooting into password setup'
	sync
	"$REBOOT_BIN" >/dev/null 2>&1 &
	return 0
}

case "${1:-}" in
request)
	request_recovery
	;;
boot)
	boot_reconcile
	;;
complete)
	complete_recovery
	;;
status)
	if [ -f "$MARKER_FILE" ]; then
		printf '%s\n' 'recovery'
		exit 0
	fi
	printf '%s\n' 'inactive'
	exit 1
	;;
*)
	printf 'Usage: %s {request|boot|complete|status}\n' "$0" >&2
	exit 2
	;;
esac
