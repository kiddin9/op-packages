#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

USE_PROCD=1
START=98
STOP=7

RUNTIME_DIR=/tmp/smartsafehub
PROG=/usr/libexec/smartsafehub-activity-sync

ensure_config() {
	uci -q get smartsafehub.activity >/dev/null 2>&1 && return 0
	uci -q batch <<'EOF_UCI'
set smartsafehub.activity=activity
set smartsafehub.activity.cloud_sync_enabled='0'
set smartsafehub.activity.sync_interval_s='300'
set smartsafehub.activity.startup_delay_s='45'
set smartsafehub.activity.api_base_url='https://www.smartsafehub.com/api/v1'
commit smartsafehub
EOF_UCI
}

start_service() {
	mkdir -p "$RUNTIME_DIR" || return 1
	ensure_config
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger smartsafehub
}
