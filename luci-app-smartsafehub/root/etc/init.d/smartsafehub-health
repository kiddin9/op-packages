#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

USE_PROCD=1
START=96
STOP=9

RUNTIME_DIR=/tmp/smartsafehub
PROG=/usr/libexec/smartsafehub-health

ensure_config() {
	uci -q get smartsafehub.health >/dev/null 2>&1 && return 0

	uci -q batch <<'EOF_UCI'
set smartsafehub.health=health
set smartsafehub.health.check_interval_s='300'
set smartsafehub.health.startup_grace_s='120'
set smartsafehub.health.reporter_enabled='0'
set smartsafehub.health.report_interval_s='1800'
set smartsafehub.health.api_base_url='https://www.smartsafehub.com/api/v1'
commit smartsafehub
EOF_UCI
}

start_service() {
	mkdir -p "$RUNTIME_DIR" || return 1
	ensure_config

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger smartsafehub
}
