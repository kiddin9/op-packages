#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

# Run before the stock Dropbear service so a pending password-recovery boot
# cannot briefly expose a root account whose password has been cleared.
START=18
STOP=1

PROG=/usr/libexec/smartsafehub-password-recovery

start() {
	[ -x "$PROG" ] || return 0
	"$PROG" boot
}

boot() {
	start
}
