config dnsguard 'main'
	option enabled '1'
	option redirect53 '0'
	option watch '1'
	option block853 '0'
	option blockdoh '0'
	option target_port '53'
	option ifaces 'br-lan'
	option skip_devices ''
	option log_limit '5'
	option rollback_minutes '10'
	option logpath '/mnt/data/logs/messages'

