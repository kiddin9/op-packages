diff --git a/src/ipa/scard_stdio.c b/src/ipa/scard_stdio.c
new file mode 100644
index 0000000..5b58991
--- /dev/null
+++ b/src/ipa/scard_stdio.c
@@ -0,0 +1,513 @@
+/*
+ * Copyright (c) 2026 André Valentin <avalentin@marcant.net>
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ *
+ * Smartcard backend for onomondo-ipa that reaches the eUICC through a HOST
+ * PROCESS instead of PC/SC: every card operation is one JSON line on stdout,
+ * and the answer is one JSON line on stdin. The wire format is lpac's stdio
+ * APDU driver (lpac driver/apdu/stdio.c, v2.3.0) byte for byte, so the host
+ * side that already bridges lpac -- wwand's esim_bridge, which answers from
+ * the modem's own APDU channel (QMI UIM / MBIM UICC / AT) -- bridges this too:
+ *
+ *   -> {"type":"apdu","payload":{"func":"logic_channel_open","param":"<AID>"}}
+ *   <- {"type":"apdu","payload":{"ecode":<channel or -1>}}
+ *   -> {"type":"apdu","payload":{"func":"transmit","param":"<C-APDU>"}}
+ *   <- {"type":"apdu","payload":{"ecode":0,"data":"<R-APDU incl. SW>"}}
+ *
+ * The two sides do not speak the same card dialect, and this file is where
+ * that is reconciled:
+ *
+ * - libipa talks raw T=0 (libipa/euicc.c): TERMINAL CAPABILITY on the basic
+ *   channel, MANAGE CHANNEL to open one, SELECT ISD-R on it and then STORE
+ *   DATA / GET RESPONSE with the channel number in CLA. A modem's APDU
+ *   service does not let the host do any of that directly: QMI UIM opens a
+ *   logical channel BY AID (OPEN_LOGICAL_CHANNEL, which selects it in the
+ *   same step) and addresses the channel by id. So MANAGE CHANNEL is
+ *   answered here, the channel is really opened when the SELECT names the
+ *   AID, and CLA is rewritten to the channel the modem handed out.
+ * - The modem completes GET RESPONSE itself and returns the whole answer with
+ *   9000 (the QMI UIM long-response path in wwand's sim.uc reassembles even
+ *   the chunked ones). libipa insists on seeing 61xx after the last STORE
+ *   DATA block and fetching with GET RESPONSE, and it rejects a block whose
+ *   length differs from what 61xx announced (euicc.c recv_es10x_block). So a
+ *   response with data is held here and handed out again in 61xx/GET
+ *   RESPONSE portions of exactly the announced size.
+ *
+ * Logging goes to stderr (libipa's log.c already writes there), so stdout
+ * carries only the protocol. A host may still merge the two, as wwand does
+ * (2>&1, into its syslog): every log line starts with the space-padded
+ * subsystem ("%8s %8s ", log.c:69), never with the '{' a protocol line starts
+ * with, so the two stay apart.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+#include <assert.h>
+#include <onomondo/ipa/utils.h>
+#include <onomondo/ipa/scard.h>
+#include <onomondo/ipa/scard_stdio.h>
+#include <onomondo/ipa/log.h>
+#include <onomondo/ipa/mem.h>
+
+/* ES10 answers (a profile list, certificates) reach several kB; one line
+ * carries the hex of the largest plus the JSON around it */
+#define RX_MAX_LEN 32768
+#define LINE_MAX_LEN (2 * RX_MAX_LEN + 128)
+#define AID_MAX_LEN 16
+
+struct scard_ctx {
+	/* the AID libipa selected, kept so the channel can be re-opened after
+	 * the host has reset the card (see ipa_scard_stdio_await_online) */
+	uint8_t aid[AID_MAX_LEN];
+	size_t aid_len;
+
+	/* the channel the modem handed out; -1 while none is open */
+	int channel;
+
+	/* a card answer being handed out in GET RESPONSE portions */
+	uint8_t *pending;
+	size_t pending_len;
+	size_t pending_off;
+};
+
+/* One process drives one card, and the connectivity hook below is called from
+ * main.c, which only holds libipa's opaque context. */
+static struct scard_ctx *g_ctx;
+
+/* Set once a read from the host failed (EOF, or a SIGTERM interrupting it).
+ * Every later exchange fails at once instead of blocking again: the shutdown
+ * path still closes the channel and disconnects, and waiting on a host that
+ * has gone would keep main() from ever saving the nvstate. */
+static bool host_gone;
+
+static const char hexdigits[] = "0123456789ABCDEF";
+
+static char *to_hex(const uint8_t *data, size_t len)
+{
+	char *s = malloc(len * 2 + 1);
+	size_t i;
+
+	assert(s);
+	for (i = 0; i < len; i++) {
+		s[i * 2] = hexdigits[data[i] >> 4];
+		s[i * 2 + 1] = hexdigits[data[i] & 0x0F];
+	}
+	s[len * 2] = '\0';
+	return s;
+}
+
+static int hexval(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+/* Read one line from stdin. Returns false on EOF: the host is gone, and every
+ * caller turns that into a card error rather than waiting forever. */
+static bool read_line(char *buf, size_t size)
+{
+	size_t n;
+
+	if (host_gone)
+		return false;
+
+	if (!fgets(buf, size, stdin)) {
+		host_gone = true;
+		return false;
+	}
+
+	n = strlen(buf);
+
+	/* A line longer than the buffer: the rest would be read as the NEXT
+	 * answer and every later exchange would be off by one. Drain it and
+	 * report the round as failed instead. */
+	if (n == size - 1 && buf[n - 1] != '\n') {
+		int c;
+
+		while ((c = getchar()) != EOF && c != '\n')
+			;
+		buf[0] = '\0';
+		IPA_LOGP(SSCARD, LERROR, "stdio: answer longer than %zu bytes dropped\n", size);
+		return true;
+	}
+	while (n && (buf[n - 1] == '\n' || buf[n - 1] == '\r'))
+		buf[--n] = '\0';
+
+	return true;
+}
+
+/* The host's answers are produced by wwand (a fixed sprintf) or lpac-compatible
+ * bridges, so a field lookup is enough; a full JSON parser would be the only
+ * dependency this binary had besides libcurl. */
+static const char *field(const char *line, const char *name)
+{
+	char key[32];
+	const char *p;
+
+	snprintf(key, sizeof(key), "\"%s\"", name);
+	p = strstr(line, key);
+	if (!p)
+		return NULL;
+	p += strlen(key);
+	while (*p == ' ' || *p == ':')
+		p++;
+	return p;
+}
+
+/* One request/answer round. `data` receives the decoded "data" field (may be
+ * empty); returns the ecode, or -1 on a protocol failure. */
+static int roundtrip(const char *func, const uint8_t *param, size_t param_len, struct ipa_buf *data)
+{
+	static char line[LINE_MAX_LEN];
+	char *hex = param_len ? to_hex(param, param_len) : NULL;
+	const char *p;
+	int ecode;
+
+	if (host_gone) {
+		free(hex);
+		return -1;
+	}
+
+	fflush(stdout);
+	printf("{\"type\":\"apdu\",\"payload\":{\"func\":\"%s\",\"param\":%s%s%s}}\n",
+	       func, hex ? "\"" : "", hex ? hex : "null", hex ? "\"" : "");
+	fflush(stdout);
+	free(hex);
+
+	if (!read_line(line, sizeof(line))) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: host closed the channel during %s\n", func);
+		return -1;
+	}
+
+	p = field(line, "ecode");
+	if (!p) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: malformed answer to %s: %s\n", func, line);
+		return -1;
+	}
+	ecode = atoi(p);
+
+	if (data) {
+		data->len = 0;
+		p = field(line, "data");
+		if (p && *p == '"') {
+			p++;
+			while (hexval(p[0]) >= 0 && hexval(p[1]) >= 0) {
+				if (data->len >= data->data_len) {
+					IPA_LOGP(SSCARD, LERROR, "stdio: answer to %s exceeds %zu bytes\n", func,
+						 data->data_len);
+					return -1;
+				}
+				data->data[data->len++] = (hexval(p[0]) << 4) | hexval(p[1]);
+				p += 2;
+			}
+		}
+	}
+
+	return ecode;
+}
+
+/* CLA with the channel number in it (ISO/IEC 7816-4 5.4.1). Channels 0-3 sit
+ * in bits 1-2 of the first interindustry coding, 4-19 need the further
+ * coding: bit 7 set and channel-4 in bits 1-4. Bit 8 (the proprietary class
+ * STORE DATA uses) is kept either way. libipa sends no secure messaging, so
+ * the SM bits are left clear. lpac writes the low nibble instead
+ * (euicc/interface.c, v2.3.0), which is the same for 0-3 and wrong from 4 on;
+ * a modem is free to hand out a channel above 3. */
+static uint8_t cla_for_channel(uint8_t cla, int channel)
+{
+	if (channel <= 3)
+		return (cla & 0x80) | (uint8_t) channel;
+	return (cla & 0x80) | 0x40 | (uint8_t) (channel - 4);
+}
+
+static void drop_pending(struct scard_ctx *ctx)
+{
+	free(ctx->pending);
+	ctx->pending = NULL;
+	ctx->pending_len = 0;
+	ctx->pending_off = 0;
+}
+
+static void put_sw(struct ipa_buf *res, uint16_t sw)
+{
+	res->data[res->len++] = sw >> 8;
+	res->data[res->len++] = sw & 0xFF;
+}
+
+/* 61xx for what is still held: xx is the size of the next portion, 00 meaning
+ * 256 (ISO/IEC 7816-4 and ETSI TS 102 221 10.1.6, which libipa follows). */
+static uint16_t pending_sw(const struct scard_ctx *ctx)
+{
+	size_t left = ctx->pending_len - ctx->pending_off;
+
+	if (!left)
+		return 0x9000;
+	return 0x6100 | (left >= 256 ? 0 : (uint8_t) left);
+}
+
+static void close_channel(struct scard_ctx *ctx)
+{
+	uint8_t ch;
+
+	if (ctx->channel < 0)
+		return;
+	ch = (uint8_t) ctx->channel;
+	roundtrip("logic_channel_close", &ch, 1, NULL);
+	ctx->channel = -1;
+}
+
+static int open_channel(struct scard_ctx *ctx)
+{
+	int ch = roundtrip("logic_channel_open", ctx->aid, ctx->aid_len, NULL);
+
+	/* channel 0 is the basic channel, never one the modem hands out for an
+	 * AID; lpac treats it as a failure the same way */
+	if (ch <= 0) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: could not open a logical channel to %s (ecode %d)\n",
+			 ipa_hexdump(ctx->aid, ctx->aid_len), ch);
+		ctx->channel = -1;
+		return -EIO;
+	}
+
+	ctx->channel = ch;
+	IPA_LOGP(SSCARD, LINFO, "stdio: logical channel %d open to %s\n", ch, ipa_hexdump(ctx->aid, ctx->aid_len));
+	return 0;
+}
+
+void *ipa_scard_init(unsigned int reader_num)
+{
+	struct scard_ctx *ctx;
+
+	(void)reader_num;   /* the host decides which modem and slot this is */
+
+	if (roundtrip("connect", NULL, 0, NULL) != 0) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: the host refused the connection\n");
+		return NULL;
+	}
+
+	ctx = IPA_ALLOC_ZERO(struct scard_ctx);
+	assert(ctx);
+	ctx->channel = -1;
+	g_ctx = ctx;
+	return ctx;
+}
+
+int ipa_scard_transceive(void *scard_ctx, struct ipa_buf *res, const struct ipa_buf *req)
+{
+	struct scard_ctx *ctx = scard_ctx;
+	struct ipa_buf *rx = NULL;
+	uint8_t *tx = NULL;
+	uint8_t cla, ins, p1;
+	uint16_t sw;
+	size_t n;
+	int rc = 0;
+
+	assert(ctx);
+	assert(res);
+	assert(req);
+	res->len = 0;
+
+	if (req->len < 4)
+		return -EINVAL;
+
+	cla = req->data[0];
+	ins = req->data[1];
+	p1 = req->data[2];
+
+	IPA_LOGP(SSCARD, LDEBUG, "stdio TX: %s\n", ipa_buf_hexdump(req));
+
+	/* TERMINAL CAPABILITY belongs to the terminal, which is the modem: it
+	 * has sent its own to the card at power-up, and it is not something a
+	 * host can say on the modem's behalf through a logical channel. lpac
+	 * does not send it either. */
+	if ((cla & 0xF0) == 0x80 && ins == 0xAA) {
+		put_sw(res, 0x9000);
+		goto out;
+	}
+
+	/* MANAGE CHANNEL: the modem opens channels by AID, so opening waits for
+	 * the SELECT that names one; closing closes the real channel. */
+	if (ins == 0x70) {
+		if (p1 & 0x80)
+			close_channel(ctx);
+		put_sw(res, 0x9000);
+		goto out;
+	}
+
+	/* SELECT by DF name: this is where the channel is really opened. Any
+	 * channel still open is closed first so a re-select does not leak one
+	 * per poll. The select response is not handed on: libipa checks only
+	 * for 61xx here (euicc.c select_isd_r) and never fetches it. */
+	if (ins == 0xA4 && p1 == 0x04 && req->len >= 5) {
+		size_t lc = req->data[4];
+
+		if (lc == 0 || lc > AID_MAX_LEN || req->len < 5 + lc) {
+			put_sw(res, 0x6A82);
+			goto out;
+		}
+		close_channel(ctx);
+		drop_pending(ctx);
+		memcpy(ctx->aid, req->data + 5, lc);
+		ctx->aid_len = lc;
+		put_sw(res, open_channel(ctx) == 0 ? 0x6100 : 0x6A82);
+		goto out;
+	}
+
+	/* GET RESPONSE for an answer held here: hand out exactly the announced
+	 * portion (Le 00 = 256), then 61xx for the rest or 9000. */
+	if (ins == 0xC0 && ctx->pending) {
+		size_t le = req->len >= 5 ? req->data[4] : 0;
+		size_t left = ctx->pending_len - ctx->pending_off;
+
+		if (le == 0)
+			le = 256;
+		n = le < left ? le : left;
+		if (n + 2 > res->data_len)
+			n = res->data_len - 2;
+		memcpy(res->data, ctx->pending + ctx->pending_off, n);
+		res->len = n;
+		ctx->pending_off += n;
+		sw = pending_sw(ctx);
+		if (sw == 0x9000)
+			drop_pending(ctx);
+		put_sw(res, sw);
+		goto out;
+	}
+
+	if (ctx->channel < 0) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: APDU for a card channel that is not open\n");
+		return -EIO;
+	}
+
+	/* the channel number in CLA is the modem's, not the one libipa chose */
+	tx = malloc(req->len);
+	assert(tx);
+	memcpy(tx, req->data, req->len);
+	tx[0] = cla_for_channel(tx[0], ctx->channel);
+
+	drop_pending(ctx);
+	rx = ipa_buf_alloc(RX_MAX_LEN);
+	assert(rx);
+
+	if (roundtrip("transmit", tx, req->len, rx) != 0 || rx->len < 2) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: transmit failed\n");
+		rc = -EIO;
+		goto free;
+	}
+
+	sw = (rx->data[rx->len - 2] << 8) | rx->data[rx->len - 1];
+	n = rx->len - 2;
+
+	/* An answer with data and a normal ending is held and announced as 61xx.
+	 * 91xx is a normal ending too (a proactive command is pending, which the
+	 * modem fetches itself); libipa knows only 9000/61xx and would abort. */
+	if (n && (sw == 0x9000 || (sw & 0xFF00) == 0x9100)) {
+		ctx->pending = malloc(n);
+		assert(ctx->pending);
+		memcpy(ctx->pending, rx->data, n);
+		ctx->pending_len = n;
+		ctx->pending_off = 0;
+		put_sw(res, pending_sw(ctx));
+		goto free;
+	}
+
+	if ((sw & 0xFF00) == 0x9100)
+		sw = 0x9000;
+
+	/* anything else goes to libipa as the card said it, clipped to fit */
+	if (n + 2 > res->data_len)
+		n = res->data_len - 2;
+	memcpy(res->data, rx->data, n);
+	res->len = n;
+	put_sw(res, sw);
+
+free:
+	free(tx);
+	ipa_buf_free(rx);
+	if (rc < 0)
+		return rc;
+out:
+	IPA_LOGP(SSCARD, LDEBUG, "stdio RX: %s\n", ipa_buf_hexdump(res));
+	return 0;
+}
+
+int ipa_scard_reset(void *scard_ctx)
+{
+	/* a card reset is the host's to do (it owns the modem and knows what a
+	 * reset costs the data session); from here it is a re-open */
+	struct scard_ctx *ctx = scard_ctx;
+
+	assert(ctx);
+	drop_pending(ctx);
+	close_channel(ctx);
+	return ctx->aid_len ? open_channel(ctx) : 0;
+}
+
+int ipa_scard_atr(void *scard_ctx, struct ipa_buf *atr)
+{
+	/* the modem does not hand the ATR to the host over this channel */
+	(void)scard_ctx;
+	atr->len = 0;
+	return -EIO;
+}
+
+int ipa_scard_free(void *scard_ctx)
+{
+	struct scard_ctx *ctx = scard_ctx;
+
+	if (!ctx)
+		return 0;
+
+	drop_pending(ctx);
+	close_channel(ctx);
+	roundtrip("disconnect", NULL, 0, NULL);
+	if (g_ctx == ctx)
+		g_ctx = NULL;
+	IPA_FREE(ctx);
+	return 0;
+}
+
+int ipa_scard_stdio_await_online(void)
+{
+	static char line[LINE_MAX_LEN];
+	const char *p;
+	int online;
+
+	/* The profile just changed. The host has to make the modem use it (a SIM
+	 * power cycle: without REFRESH the modem keeps running the old profile)
+	 * and wait until the data session is back; only then can the result reach
+	 * the eIM. That power cycle closes every logical channel, so ours is
+	 * re-opened here before libipa talks to the card again. */
+	fflush(stdout);
+	printf("{\"type\":\"event\",\"payload\":{\"event\":\"profile_changed\"}}\n");
+	fflush(stdout);
+
+	if (!read_line(line, sizeof(line))) {
+		IPA_LOGP(SSCARD, LERROR, "stdio: host closed the channel while restoring connectivity\n");
+		return -1;
+	}
+
+	p = field(line, "online");
+	online = p && strncmp(p, "true", 4) == 0;
+	IPA_LOGP(SSCARD, LINFO, "stdio: host reports the connection %s\n", online ? "back" : "NOT back");
+
+	if (g_ctx) {
+		/* no close first: the card reset already closed it, and the modem
+		 * may have handed that id to someone else since */
+		drop_pending(g_ctx);
+		if (g_ctx->aid_len && open_channel(g_ctx) < 0)
+			return -1;
+	}
+
+	return online;
+}
