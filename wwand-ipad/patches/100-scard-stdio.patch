diff --git a/tests/scard_stdio/scard_stdio_test.c b/tests/scard_stdio/scard_stdio_test.c
new file mode 100644
index 0000000..831320d
--- /dev/null
+++ b/tests/scard_stdio/scard_stdio_test.c
@@ -0,0 +1,95 @@
+/*
+ * Copyright (c) 2026 André Valentin <avalentin@marcant.net>
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ *
+ * The stdio card backend against a scripted host: stdin carries the host's
+ * answers (scard_stdio_test.in), stdout the requests, which the test compares
+ * with scard_stdio_test.ok. The card answers the way a modem's APDU service
+ * does -- the whole answer at once with 9000 -- and the checks here are what
+ * libipa relies on seeing instead (libipa/euicc.c).
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include <onomondo/ipa/utils.h>
+#include <onomondo/ipa/scard.h>
+#include <onomondo/ipa/scard_stdio.h>
+
+static void *card;
+
+/* send one C-APDU (hex) and return the R-APDU as a buffer */
+static struct ipa_buf *xfer(const char *capdu_hex)
+{
+	struct ipa_buf *req = ipa_buf_alloc(300);
+	struct ipa_buf *res = ipa_buf_alloc(258);
+
+	req->len = ipa_binary_from_hexstr(req->data, req->data_len, capdu_hex);
+	assert(ipa_scard_transceive(card, res, req) == 0);
+	ipa_buf_free(req);
+	return res;
+}
+
+static unsigned sw_of(const struct ipa_buf *r)
+{
+	assert(r->len >= 2);
+	return (r->data[r->len - 2] << 8) | r->data[r->len - 1];
+}
+
+static void expect_sw(const char *capdu_hex, unsigned sw, size_t data_len)
+{
+	struct ipa_buf *r = xfer(capdu_hex);
+
+	if (sw_of(r) != sw || r->len - 2 != data_len) {
+		fprintf(stderr, "%s: got sw %04X with %zu bytes, want %04X with %zu\n", capdu_hex, sw_of(r),
+			r->len - 2, sw, data_len);
+		assert(0);
+	}
+	ipa_buf_free(r);
+}
+
+int main(void)
+{
+	card = ipa_scard_init(0);
+	assert(card);
+
+	/* TERMINAL CAPABILITY and MANAGE CHANNEL never reach the host */
+	expect_sw("80AA000005A903830107", 0x9000, 0);
+	expect_sw("0070000100", 0x9000, 0);
+
+	/* SELECT ISD-R opens the real channel (the host hands out 3); libipa
+	 * accepts only 61xx here */
+	expect_sw("01A4040410A0000005591010FFFFFFFF8900000100", 0x6100, 0);
+
+	/* A 300-byte answer with 9000 is announced as 61 00 and handed out as
+	 * 256 + 44, each portion exactly the size announced. CLA goes out with
+	 * the host's channel (83), not libipa's (81). */
+	expect_sw("81E2910003BF2200", 0x6100, 0);
+	expect_sw("01C0000000", 0x612C, 256);
+	expect_sw("01C000002C", 0x9000, 44);
+
+	/* The host resets the card for a profile change: the channel it closed
+	 * is re-opened (the host now hands out 2) and later APDUs use it */
+	assert(ipa_scard_stdio_await_online() == 1);
+	expect_sw("81E2910003BF2B00", 0x6A88, 0);
+
+	/* 91xx is a normal ending too: held and announced like 9000 */
+	expect_sw("81E2910003BF2D00", 0x6102, 0);
+	expect_sw("01C0000002", 0x9000, 2);
+
+	/* the host reports it could not get the connection back, and re-opens
+	 * on channel 4: from there CLA takes the further coding, 0x40 | ch-4
+	 * (ISO/IEC 7816-4 5.4.1), so STORE DATA goes out as C0, not 84 */
+	assert(ipa_scard_stdio_await_online() == 0);
+	expect_sw("81E2910003BF2B00", 0x9000, 0);
+
+	assert(ipa_scard_free(card) == 0);
+
+	/* the host is gone: every exchange fails at once instead of blocking */
+	card = ipa_scard_init(0);
+	assert(card == NULL);
+
+	fprintf(stderr, "scard_stdio_test: ok\n");
+	return 0;
+}
