root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf

[*.sh]
indent_style = tab
indent_size = 4

[*/init.d/*]
indent_style = tab
indent_size = 4

[*/libexec/*]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
insert_final_newline = true

[Makefile]
indent_style = tab
indent_size = 4
insert_final_newline = true