config main 'config'
	option enabled '0'
	option listen_port '5335'
	option schedule '0 5 * * *'
	option threads '4'
	option probes '4'
	option download_count '5'
	option timeout '5'
	option max_latency '300'
	option min_speed '1'
	option test_url 'https://speed.cloudflare.com/__down?bytes=20000000'
	list domains 'www.cloudflare.com'
