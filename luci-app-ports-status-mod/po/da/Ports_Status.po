msgid "Edit Port Label"
msgstr "Rediger portmærkat"

msgid "Enter new label for this port:"
msgstr "Indtast ny mærkat for denne port:"

msgid "Device"
msgstr "Enhed"

msgid "Original label"
msgstr "Oprindelig mærkat"

msgid "Restore Original"
msgstr "Gendan oprindelig"

msgid "Cancel"
msgstr "Annuller"

msgid "Save"
msgstr "Gem"

msgid "Port configuration saved successfully"
msgstr "Portkonfigurationen blev gemt"

msgid "Port order saved"
msgstr "Portrækkefølge gemt"

msgid "Click to edit label"
msgstr "Klik for at redigere mærkat"

msgid "Hold to drag and reorder"
msgstr "Hold nede for at trække og omarrangere"

msgid "Label max 9 chars, description max 50 chars."
msgstr "Mærkat maks. 9 tegn, beskrivelse maks. 50 tegn."

msgid "Enter description (optional):"
msgstr "Indtast beskrivelse (valgfri):"

msgid "Optional description"
msgstr "Valgfri beskrivelse"

msgid "User settings are saved to the /etc/user_defined_ports.json file."
msgstr "Brugerindstillinger gemmes i filen /etc/user_defined_ports.json."

msgid "Configuration file downloaded"
msgstr "Konfigurationsfil downloadet"

msgid "Configuration file not found"
msgstr "Konfigurationsfil ikke fundet"

msgid "Download error: %s"
msgstr "Downloadfejl: %s"

msgid "Invalid configuration format"
msgstr "Ugyldigt konfigurationsformat"

msgid "Restore configuration"
msgstr "Gendan konfiguration"

msgid "This will overwrite current ports configuration. Continue?"
msgstr "Dette vil overskrive den nuværende portkonfiguration. Fortsæt?"

msgid "Configuration restored successfully. Reloading..."
msgstr "Konfigurationen blev gendannet. Genindlæser..."

msgid "File restore failed: %s"
msgstr "Gendannelse af fil mislykkedes: %s"

msgid "Save .json file"
msgstr "Gem .json-fil"

msgid "Upload .json file"
msgstr "Upload .json-fil"

msgid "Cannot save empty configuration"
msgstr "Kan ikke gemme en tom konfiguration"

msgid "Cannot save port configuration. "
msgstr "Kan ikke gemme portkonfiguration. "

msgid "Directory /etc may be read-only or insufficient permissions. "
msgstr "Mappen /etc er muligvis skrivebeskyttet eller har utilstrækkelige tilladelser. "

msgid "Try running: chmod 755 /etc && touch %s && chmod 644 %s"
msgstr "Prøv at køre: chmod 755 /etc && touch %s && chmod 644 %s"

msgid "Save Error"
msgstr "Fejl ved lagring"

msgid "Original error: %s"
msgstr "Oprindelig fejl: %s"

msgid "Restore from backup"
msgstr "Gendan fra sikkerhedskopi"

msgid "Restore configuration from backup file? This will overwrite current settings."
msgstr "Gendan konfiguration fra sikkerhedskopifil? Dette vil overskrive de nuværende indstillinger."

msgid "Backup contains:"
msgstr "Sikkerhedskopi indeholder:"

msgid "Configuration restored from backup. Reloading..."
msgstr "Konfiguration gendannet fra sikkerhedskopi. Genindlæser..."

msgid "Restore failed: %s"
msgstr "Gendannelse mislykkedes: %s"

msgid "Backup file is corrupted: %s"
msgstr "Sikkerhedskopifilen er beskadiget: %s"

msgid "Error reading backup: %s"
msgstr "Fejl ved læsning af sikkerhedskopi: %s"

msgid "Restore backup .bak"
msgstr "Gendan .bak-sikkerhedskopi"

msgid "Change port state"
msgstr "Skift portstatus"

msgid "Enable this port"
msgstr "Aktiver denne port"

msgid "Enable port"
msgstr "Aktiver port"

msgid "Disable this port"
msgstr "Deaktiver denne port"

msgid "Disable port"
msgstr "Deaktiver port"

msgid "Down"
msgstr "nede"

msgid "Disabled"
msgstr "deaktiveret"

msgid "Idle"
msgstr "inaktiv"

msgid "Active"
msgstr "aktiv"

msgid "Unknown"
msgstr "ukendt"

msgid "No config file to backup"
msgstr "Ingen konfigurationsfil at sikkerhedskopiere"

msgid "Config file is corrupted, cannot create backup"
msgstr "Konfigurationsfilen er beskadiget, kan ikke oprette sikkerhedskopi"

msgid "Backup file created: %s"
msgstr "Sikkerhedskopifil oprettet: %s"

msgid "Backup write verification failed!"
msgstr "Skriveverifikation af sikkerhedskopi mislykkedes!"

msgid "Backup creation failed: %s"
msgstr "Oprettelse af sikkerhedskopi mislykkedes: %s"

msgid "Error reading config: %s"
msgstr "Fejl ved læsning af konfiguration: %s"

msgid "Create backup .bak"
msgstr "Opret .bak-sikkerhedskopi"
