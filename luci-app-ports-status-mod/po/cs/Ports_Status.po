msgid "Edit Port Label"
msgstr "Upravit štítek portu"

msgid "Enter new label for this port:"
msgstr "Zadejte nový štítek pro tento port:"

msgid "Device"
msgstr "Zařízení"

msgid "Original label"
msgstr "Původní štítek"

msgid "Restore Original"
msgstr "Obnovit původní"

msgid "Cancel"
msgstr "Zrušit"

msgid "Save"
msgstr "Uložit"

msgid "Port configuration saved successfully"
msgstr "Konfigurace portu byla úspěšně uložena"

msgid "Port order saved"
msgstr "Pořadí portů bylo uloženo"

msgid "Click to edit label"
msgstr "Kliknutím upravíte štítek"

msgid "Hold to drag and reorder"
msgstr "Podržením přetáhněte a změňte pořadí"

msgid "Label max 9 chars, description max 50 chars."
msgstr "Štítek maximálně 9 znaků, popis maximálně 50 znaků."

msgid "Enter description (optional):"
msgstr "Zadejte popis (volitelné):"

msgid "Optional description"
msgstr "Volitelný popis"

msgid "User settings are saved to the /etc/user_defined_ports.json file."
msgstr "Uživatelská nastavení jsou ukládána do souboru /etc/user_defined_ports.json."

msgid "Configuration file downloaded"
msgstr "Konfigurační soubor byl stažen"

msgid "Configuration file not found"
msgstr "Konfigurační soubor nebyl nalezen"

msgid "Download error: %s"
msgstr "Chyba stahování: %s"

msgid "Invalid configuration format"
msgstr "Neplatný formát konfigurace"

msgid "Restore configuration"
msgstr "Obnovit konfiguraci"

msgid "This will overwrite current ports configuration. Continue?"
msgstr "Tato operace přepíše aktuální konfiguraci portů. Pokračovat?"

msgid "Configuration restored successfully. Reloading..."
msgstr "Konfigurace byla úspěšně obnovena. Načítání..."

msgid "File restore failed: %s"
msgstr "Obnovení souboru selhalo: %s"

msgid "Save .json file"
msgstr "Uložit soubor .json"

msgid "Upload .json file"
msgstr "Nahrát soubor .json"

msgid "Cannot save empty configuration"
msgstr "Nelze uložit prázdnou konfiguraci"

msgid "Cannot save port configuration. "
msgstr "Nelze uložit konfiguraci portu. "

msgid "Directory /etc may be read-only or insufficient permissions. "
msgstr "Adresář /etc může být pouze pro čtení nebo má nedostatečná oprávnění. "

msgid "Try running: chmod 755 /etc && touch %s && chmod 644 %s"
msgstr "Zkuste spustit: chmod 755 /etc && touch %s && chmod 644 %s"

msgid "Save Error"
msgstr "Chyba ukládání"

msgid "Original error: %s"
msgstr "Původní chyba: %s"

msgid "Restore from backup"
msgstr "Obnovit ze zálohy"

msgid "Restore configuration from backup file? This will overwrite current settings."
msgstr "Obnovit konfiguraci ze záložního souboru? Tímto dojde k přepsání aktuálního nastavení."

msgid "Backup contains:"
msgstr "Záloha obsahuje:"

msgid "Configuration restored from backup. Reloading..."
msgstr "Konfigurace byla obnovena ze zálohy. Načítání..."

msgid "Restore failed: %s"
msgstr "Obnovení selhalo: %s"

msgid "Backup file is corrupted: %s"
msgstr "Záložní soubor je poškozen: %s"

msgid "Error reading backup: %s"
msgstr "Chyba při čtení zálohy: %s"

msgid "Restore backup .bak"
msgstr "Obnovit zálohu .bak"

msgid "Change port state"
msgstr "Změnit stav portu"

msgid "Enable this port"
msgstr "Povolit tento port"

msgid "Enable port"
msgstr "Povolit port"

msgid "Disable this port"
msgstr "Zakázat tento port"

msgid "Disable port"
msgstr "Zakázat port"

msgid "Down"
msgstr "neaktivní"

msgid "Disabled"
msgstr "zakázáno"

msgid "Idle"
msgstr "nečinný"

msgid "Active"
msgstr "aktivní"

msgid "Unknown"
msgstr "neznámý"

msgid "No config file to backup"
msgstr "Žádný konfigurační soubor k zálohování"

msgid "Config file is corrupted, cannot create backup"
msgstr "Konfigurační soubor je poškozen, nelze vytvořit zálohu"

msgid "Backup file created: %s"
msgstr "Záložní soubor byl vytvořen: %s"

msgid "Backup write verification failed!"
msgstr "Ověření zápisu zálohy selhalo!"

msgid "Backup creation failed: %s"
msgstr "Vytvoření zálohy selhalo: %s"

msgid "Error reading config: %s"
msgstr "Chyba při čtení konfigurace: %s"

msgid "Create backup .bak"
msgstr "Vytvořit zálohu .bak"
