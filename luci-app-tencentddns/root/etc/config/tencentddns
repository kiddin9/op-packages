config global 'global'
	option enabled '0'
	option api_type 'tc3'
	option endpoint 'cn'
	option secret_id ''
	option secret_key ''
	option check_interval '5'
	option force_interval '24'
	option retry_interval '60'
	option log_max_lines '500'
	option insecure_tls '0'
	list ipv4_url 'https://4.ipw.cn'
	list ipv4_url 'https://myip.ipip.net/s'
	list ipv4_url 'https://ddns.oray.com/checkip'
	list ipv4_url 'https://api.ipify.org'
	list ipv6_url 'https://6.ipw.cn'
	list ipv6_url 'https://speed.neu6.edu.cn/getIP.php'
	list ipv6_url 'https://api6.ipify.org'
