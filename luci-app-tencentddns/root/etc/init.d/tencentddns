#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/tencentddns
CONF=tencentddns

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p /var/run/tencentddns /var/log

	procd_open_instance "$CONF"
	procd_set_param command /usr/bin/ucode "$PROG" daemon
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param file /etc/config/tencentddns
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/tencentddns/daemon.pid /var/run/tencentddns/sync.lock
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
