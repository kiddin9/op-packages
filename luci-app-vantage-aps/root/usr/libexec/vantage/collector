#!/usr/bin/ucode -S
// luci-app-vantage-aps: reads the access points this router is paired with.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Run by /etc/init.d/vantage-collector (procd) while /etc/vantage/aps.json
// lists an access point. Publishes the ubus object vantage.collector:
//
//   report   { aps: [ { id, name, addr, state, error, age, report } ] }
//            state: 'ok' (a report to show: less than OFFLINE_S old, or
//            the last one while the first fetch after a pause runs),
//            'offline' (none, and the last fetch could not reach it:
//            'unreachable', 'timeout'), 'error' (none, and the last fetch
//            was refused or made no sense: 'hostkey', 'denied', 'invalid',
//            'missing') or 'waiting' (no fetch has ended yet); error: why
//            the last fetch failed, or null; age: seconds since the last
//            report, or null. report.mac is the MAC given at pairing,
//            whatever the access point says of itself. Each call is a
//            viewer: for VIEW_S after the last one each access point is
//            fetched at most once every FETCH_S. With no viewer, nothing runs.
//
// A fetch is one SSH login as root with this router's key
// (/etc/vantage/id_ed25519). dbclient accepts only the host key pinned at
// pairing (a known_hosts of its own, StrictHostKeyChecking=yes, batch
// mode, no passwords), and the access point runs its report command
// whatever is asked (the key's forced command there). The report is
// checked field by field (vantage.aps normalize): an access point is
// trusted to report its own state, nothing more. Rates come from two
// reports in a row.
//
// An access point whose address changed (DHCP) is looked for by the MAC it
// gave at pairing, in this router's DHCP leases and neighbour table, on
// the network it was paired on only; the pinned host key decides whether
// it is the one. That network is the one its pairing names, with the
// subnets it has now (so it is found again after the network's subnet
// was changed; with no network of that name, or that one down, nowhere);
// a pairing that names none (an earlier version's, or one at an address
// on no network of this router's) is looked for on the network its
// pairing address is on now. The address it answers at is kept in memory
// only: /etc/vantage stays as paired. A pairing that names its network is
// asked at an address, the kept one too, only while that address is on
// the named network.

'use strict';

import * as uloop from 'uloop';
import { connect } from 'ubus';
import { lstat, mkdir, readfile, rmdir, unlink, writefile } from 'fs';
import * as vaps from 'vantage.aps';

const KEY = '/etc/vantage/id_ed25519';
const APS = '/etc/vantage/aps.json';
const RUN = '/var/run/vantage-collector';
const ARP = '/proc/net/arp';
const LEASES = '/tmp/dhcp.leases';
const SH = '/bin/sh';
const DBCLIENT = '/usr/bin/dbclient';
const KILL = '/bin/kill';
// asked for by name: the key's forced command runs it anyway, and an
// access point still without a root password (where dropbear lets root in
// without the key) runs it too
const REPORT = '/usr/libexec/vantage/report';
const FETCH_S = 10;
const VIEW_S = 60;
const TIMEOUT_S = 15;
const OFFLINE_S = 60;
const TICK_MS = 2000;
// bytes of a report: twice the 131,072 of 1.1.0 and 1.1.1, which the
// fullest report now nearly fills (130,459 bytes: 16 SSIDs, 256 stations
// with their links, 32 ports with the switch's counters, 128 wired
// hosts), so that a field an access point adds later is not refused here
const MAX_OUT = 262144;
const MAX_ERR = 4096;
const MAX_TABLE = 65536;          // bytes of the neighbour table and the leases read
const MAX_LIST = 65536;           // bytes of the paired list
const MAX_ALL_STATIONS = 1024;    // in one reply, all access points

// sh runs dbclient in its own place (exec: the same pid, which the
// timeout kills) with its output in files; nothing of an access point's
// goes through a shell word. The files are in RAM (/var/run): ulimit -f
// ends dbclient at 544 blocks of 512 bytes, just over MAX_OUT, however
// much an access point sends and even with this daemon gone; no core.
const RUN_SH = 'ulimit -c 0; ulimit -f 544; exec "$@" >"$VT_OUT" 2>"$VT_ERR" </dev/null';

let aps = [], aps_text = null, st = {}, viewed = null, ticker = null, ubus = null;

function now() {
	return clock(true)?.[0] ?? 0;
}

// what a fetch leaves in RUN for an access point: gone with it (id: from
// the paired list, sixteen hex digits)
function forget(id) {
	let home = RUN + '/' + id;

	unlink(home + '/out');
	unlink(home + '/err');
	unlink(home + '/.ssh/known_hosts');
	rmdir(home + '/.ssh');
	rmdir(home);
}

// the paired list, read again whenever its bytes differ (its time stamp
// counts whole seconds: two changes within one would look like none)
function load() {
	let text = readfile(APS, MAX_LIST) ?? '';

	if (text === aps_text)
		return;

	aps_text = text;
	aps = vaps.aps(text);

	let keep = {};

	for (let a in aps)
		keep[a.id] = st[a.id] ?? (st[a.id] = { busy: false, started: null, ok_at: null, error: null, report: null, prev: null, at: null });

	// addr: where it answered last (first where it was paired); paired
	// again at another address: that one
	for (let a in aps)
		if (keep[a.id].paired !== a.addr) {
			keep[a.id].paired = keep[a.id].addr = a.addr;
			keep[a.id].trying = null;
			keep[a.id].tried = {};
		}

	// gone from the list: forgotten, with what was kept for it; a fetch
	// still running ends unheard and clears up after itself
	for (let i in keys(st))
		if (!keep[i]) {
			if (!st[i].busy)
				forget(i);

			delete st[i];
		}
}

// dnsmasq's leases, only as a plain file of root's or of this daemon's
// own account (the one RUN, which it made, belongs to): /tmp takes a
// name from any account, and opening a FIFO there would hold this daemon,
// and with it every reply, until someone writes to it. What those two own
// in /tmp no other account can swap, nor fill with addresses to try.
function leases() {
	return vaps.own_file(lstat(LEASES), lstat(RUN)?.uid) ? readfile(LEASES, MAX_TABLE) : null;
}

function took(a, s, r, at) {
	let dt = (s.prev && s.at != null) ? at - s.at : 0;

	s.report = vaps.view(r, s.prev, (dt > 0 && dt <= 120) ? dt : 0);
	// the MAC it was paired with: the dashboard places its hosts by it,
	// so not the one it reports
	s.report.mac = a.mac;
	s.prev = r;
	s.at = at;
	s.ok_at = at;
	s.error = null;
}

function done(a, s, home, code) {
	s.timer?.cancel();
	s.timer = null;
	s.busy = false;
	s.hold = false;
	s.wait = false;

	let out = readfile(home + '/out', MAX_OUT + 1), err = readfile(home + '/err', MAX_ERR);

	unlink(home + '/out');
	unlink(home + '/err');

	// removed while it ran (and not paired again since)
	if (st[a.id] !== s) {
		if (!st[a.id])
			forget(a.id);

		return;
	}

	let e = vaps.fetch_error(code, out, err, s.timedout, MAX_OUT), r = null;

	if (!e) {
		try {
			r = vaps.parseable(out) ? vaps.normalize(json(out)) : null;
		}
		catch (x) {
			r = null;
		}

		if (!r)
			e = 'invalid';
	}

	let tried = s.trying;

	s.trying = null;

	if (r) {
		// found it at another address: from now on there
		if (tried) {
			s.addr = tried;
			s.tried = {};
		}

		took(a, s, r, now());
		return;
	}

	// its own answer from another address (only the holder of the pinned
	// key gets as far as denied, missing or invalid): it is there now,
	// and that is what is wrong with it
	if (tried && !vaps.moved(e)) {
		s.addr = tried;
		s.tried = {};
		s.error = e;
		return;
	}

	// another address that was not it: the error stays the one where it was paired
	if (tried)
		s.tried[tried] = true;
	else
		s.error = e;

	// Not found where it was (or another device is there): the next
	// address its MAC has now on the network it was paired on, in this
	// router's DHCP leases or neighbour table, each once while someone
	// looks. The pinned host key turns away any other device there.
	// The network its pairing names, and that one only: never the one
	// its address would be on now when the named one is gone.
	if (tried || vaps.moved(e)) {
		let ifaces = ubus.call('network.interface', 'dump')?.interface;
		let net = a.net ? vaps.network_named(a.net, ifaces) : vaps.network_of(a.addr, ifaces);
		let to = net ? vaps.next_addr(a.mac, s.addr, s.tried, readfile(ARP, MAX_TABLE), leases(), net) : null;

		if (to) {
			s.trying = to;
			s.started = null;
		}
	}
}

function fetch(a) {
	let s = st[a.id], home = RUN + '/' + a.id, to = s.trying ?? s.addr;

	// The address to ask (where it was paired, where it answered last
	// after a move, or one its MAC was found at a moment ago) is no
	// address of the network its pairing names any more (that network
	// has another subnet now): whoever holds it today is not asked.
	// Checked before every connection: a network can be renumbered
	// twice, and between a search and the fetch it queued. Its MAC is
	// looked for on the named network at once, as after a fetch that
	// found it gone. A pairing whose network is gone or down is asked
	// at its own address, like one that names none.
	if (a.net) {
		let ifaces = ubus.call('network.interface', 'dump')?.interface;
		let net = vaps.network_named(a.net, ifaces);

		if (net && vaps.net_of(to, ifaces) !== a.net) {
			// one that was found and has left the network since: not again
			if (s.trying)
				s.tried[s.trying] = true;

			to = vaps.next_addr(a.mac, s.addr, s.tried, readfile(ARP, MAX_TABLE), leases(), net);

			if (!to) {
				s.error = 'unreachable';
				s.trying = null;
				s.hold = s.wait = false;
				s.started = now();
				return;
			}

			s.trying = to;
		}
	}

	mkdir(home, 0700);
	mkdir(home + '/.ssh', 0700);

	// the one host key this access point may show, under the address dbclient is given
	if (!writefile(home + '/.ssh/known_hosts', to + ' ssh-ed25519 ' + a.key + '\n')) {
		s.error = 'unreachable';
		s.trying = null;
		s.hold = s.wait = false;
		return;
	}

	s.busy = true;
	s.timedout = false;
	s.started = now();

	let p = uloop.process(SH, [ '-c', RUN_SH, 'sh', DBCLIENT, '-T',
		'-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'PasswordAuthentication=no',
		'-i', KEY, '-p', '' + a.port, '-I', '' + TIMEOUT_S, 'root@' + to, REPORT ],
		{ HOME: home, PATH: '/usr/sbin:/usr/bin:/sbin:/bin', VT_OUT: home + '/out', VT_ERR: home + '/err' },
		(code) => done(a, s, home, code));

	if (!p) {
		s.busy = false;
		s.error = 'unreachable';
		s.trying = null;
		s.hold = s.wait = false;
		return;
	}

	s.timer = uloop.timer(TIMEOUT_S * 1000, () => {
		s.timer = null;

		if (s.busy) {
			s.timedout = true;
			system([ KILL, '' + p.pid() ]);
		}
	});
}

function tick() {
	let t = now();

	load();

	if (viewed == null || t - viewed > VIEW_S) {
		ticker = null;
		return;
	}

	for (let a in aps) {
		let s = st[a.id];

		if (!s.busy && (s.started == null || t - s.started >= FETCH_S))
			fetch(a);
	}

	ticker = uloop.timer(TICK_MS, tick);
}

function snapshot() {
	let t = now(), out = [], left = MAX_ALL_STATIONS;

	for (let a in aps) {
		let s = st[a.id], age = (s.ok_at != null) ? t - s.ok_at : null, r = null;
		// a failure from before a pause in looking says nothing of now
		let error = s.wait ? null : s.error;

		// a pause in looking ages no report: the last one stays until the
		// first fetch after it has ended
		if (s.report && (s.hold || (age != null && age <= OFFLINE_S))) {
			r = s.report;

			if (length(r.stations) > left)
				r = { ...r, stations: slice(r.stations, 0, left) };

			left -= length(r.stations);
		}

		push(out, {
			id: a.id, name: a.name, addr: s.addr,
			state: vaps.state(!!r, error),
			error, age, report: r
		});
	}

	return out;
}

mkdir(RUN, 0700);
load();
uloop.init();

ubus = connect();

if (!ubus || !ubus.publish('vantage.collector', {
	report: {
		call: function(req) {
			viewed = now();
			load();

			// someone looks again: every address may be tried again, and
			// what each said last stands until its next fetch has ended.
			// One whose fetch before the pause had failed is neither fine
			// nor known to be failing still: it waits for that fetch
			if (!ticker) {
				for (let i, s in st) {
					s.tried = {};
					s.hold = !!s.report && !s.error;
					s.wait = !!s.error;
				}

				tick();
			}

			return { aps: snapshot() };
		},
		// A browser's request comes through rpcd, which adds the session
		// it came with, and ucode turns away a request that carries
		// anything its method does not name ("Invalid argument": the
		// dashboard then showed no access point at all). Named, so that
		// it is answered, and never read: who may ask is rpcd's to decide
		// (the add-on's view group).
		args: { ubus_rpc_session: '' }
	}
}))
	exit(1);

uloop.run();
