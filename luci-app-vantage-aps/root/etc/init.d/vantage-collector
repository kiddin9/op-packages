#!/bin/sh /etc/rc.common
# luci-app-vantage-aps: reads the access points this router is paired with
# (/usr/libexec/vantage/collector) for the dashboard. Starts nothing until
# one is paired under Network -> Access points.

START=99
USE_PROCD=1

APS=/etc/vantage/aps.json

start_service() {
	grep -qs '"id"' "$APS" || return 0
	[ -x /usr/bin/dbclient ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/vantage/collector
	# an upgrade only runs "start" (apk: no stop before it): procd leaves a
	# running instance alone unless one of these files has changed
	procd_set_param file /usr/libexec/vantage/collector /usr/share/ucode/vantage/aps.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# stopped (the last access point removed, the add-on removed): what the
# collector kept for its access points, their known_hosts, goes with it
service_stopped() {
	rm -rf /var/run/vantage-collector
}
