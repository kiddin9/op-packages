# SPDX-License-Identifier: GPL-2.0-only
#
# A DNS server carrying HTTP headers.  UCI stores them as a string list
# ("Name: Value" per entry), sing-box wants map[string][]string, and emitting
# the UCI list verbatim makes sing-box refuse the whole configuration
# ("cannot unmarshal array into Go value of type badoption.HTTPHeader").
# The generator converts one shape into the other; a name that appears twice
# becomes a two-value header.

config homeproxy-pro 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '1'
	option log_level 'error'

config homeproxy-pro 'routing'
	option default_outbound 'direct-out'
	option default_outbound_dns 'default-dns'

config homeproxy-pro 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option self_mark '100'

config dns_server 'ds_https'
	option enabled '1'
	option type 'https'
	option server '1.1.1.1'
	option path '/dns-query'
	list headers 'X-Test: one'
	list headers 'X-Test: two'
	list headers 'Authorization: Bearer t'
