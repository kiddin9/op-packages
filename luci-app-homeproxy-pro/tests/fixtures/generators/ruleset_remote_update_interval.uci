# SPDX-License-Identifier: GPL-2.0-only
#
# A remote rule-set whose update_interval is a bare number.  sing-box parses
# the field as a duration and refuses a number without a unit
# ("time: missing unit in duration"), which rejects the whole configuration -
# the same failure the DNS timeouts are normalised for.  The form only offers
# a placeholder ("1d"), not a format check.

config homeproxy-pro 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '1'
	option log_level 'error'

config homeproxy-pro 'routing'
	option default_outbound 'direct-out'
	option default_outbound_dns 'default-dns'

config homeproxy-pro 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option self_mark '100'

config ruleset 'rs_remote'
	option enabled '1'
	option label 'rs-remote'
	option type 'remote'
	option format 'binary'
	option url 'https://example.invalid/ruleset.srs'
	option update_interval '3600'

config routing_rule 'rr_rs'
	option enabled '1'
	option label 'rr-rs'
	option action 'route'
	option outbound 'direct-out'
	option rule_set 'rs_remote'
