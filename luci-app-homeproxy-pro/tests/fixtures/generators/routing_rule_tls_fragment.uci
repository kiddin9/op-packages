# SPDX-License-Identifier: GPL-2.0-only
#
# Both TLS fragmentation switches at once.  RouteOptionsActionOptions's
# UnmarshalJSON() treats them as mutually exclusive
# ("`tls_fragment` and `tls_record_fragment` are mutually exclusive"), and
# the form shows both switches without hiding either when the other is on -
# a user following the description ("try TLS record fragment first") can
# easily tick both.

config homeproxy-pro 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '1'
	option log_level 'error'

config homeproxy-pro 'routing'
	option default_outbound 'direct-out'
	option default_outbound_dns 'default-dns'

config homeproxy-pro 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option redirect_port '5331'
	option self_mark '100'

config routing_rule 'rr_tls'
	option enabled '1'
	option label 'rr-tls'
	option action 'route'
	option outbound 'direct-out'
	option tls_fragment '1'
	option tls_record_fragment '1'
