# SPDX-License-Identifier: GPL-2.0-only
#
# Regression fixture for generate_client.uc: a node of every supported
# protocol reachable through a single urltest main node, so one run exercises
# all outbound builders (TLS, transport, reality, mux, obfuscation).

config homeproxy 'config'
	option routing_mode 'bypass_mainland_china'
	option proxy_mode 'tun'
	option ipv6_support '0'
	option log_level 'error'
	option main_node 'urltest'
	option main_udp_node 'nil'
	option dns_server 'https://cloudflare-dns.com/dns-query'
	list main_urltest_nodes 'n_anytls'
	list main_urltest_nodes 'n_vless_reality_ws'
	list main_urltest_nodes 'n_vmess_http'
	list main_urltest_nodes 'n_trojan_grpc'
	list main_urltest_nodes 'n_ss'
	list main_urltest_nodes 'n_hy2'
	list main_urltest_nodes 'n_snell'
	list main_urltest_nodes 'n_http'
	list main_urltest_nodes 'n_socks'
	list main_urltest_nodes 'n_shadowtls'

config homeproxy 'infra'
	option mixed_port '5330'
	option dns_port '5333'
	option tun_name 'singtun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	option self_mark '100'
	option tun_mark '102'
	option table_mark '100'
	option ntp_server 'nil'

config node 'n_anytls'
	option label 'anytls'
	option type 'anytls'
	option address 'a.example.com'
	option port '443'
	option password 'secret'
	option tls '1'
	option tls_sni 'a.example.com'
	option tls_insecure '0'
	option anytls_idle_session_check_interval '30'
	option anytls_idle_session_timeout '30'
	option anytls_min_idle_session '0'

config node 'n_vless_reality_ws'
	option label 'vless-reality-ws'
	option type 'vless'
	option address 'b.example.com'
	option port '443'
	option uuid '3af88561-9c69-4b19-8f7e-f08d580bc339'
	option transport 'ws'
	option ws_host 'b.example.com'
	option ws_path '/ws?ed=2048'
	option tls '1'
	option tls_sni 'b.example.com'
	option tls_reality '1'
	option tls_reality_public_key '4UAg690QziXeelpUJoAmXiim0gfQESSiJkNfvF-o8Uw'
	option tls_reality_short_id 'abcd'
	option tls_utls 'chrome'
	option vless_flow 'xtls-rprx-vision'
	option packet_encoding 'xudp'

config node 'n_vmess_http'
	option label 'vmess-http'
	option type 'vmess'
	option address 'c.example.com'
	option port '80'
	option uuid '3af88561-9c69-4b19-8f7e-f08d580bc339'
	option transport 'http'
	option http_host 'c.example.com'
	option http_path '/path'
	option http_method 'GET'
	option vmess_alterid '0'
	option vmess_encrypt 'auto'
	option vmess_global_padding '1'
	option tls '0'
	option packet_encoding 'packetaddr'

config node 'n_trojan_grpc'
	option label 'trojan-grpc'
	option type 'trojan'
	option address 'd.example.com'
	option port '443'
	option password 'secret'
	option transport 'grpc'
	option grpc_servicename 'gs'
	option grpc_permit_without_stream '1'
	option tls '1'
	option tls_sni 'd.example.com'
	option tls_handshake_timeout '15'
	option tls_min_version '1.2'
	option tls_max_version '1.3'
	option tls_cipher_suites 'TLS_AES_128_GCM_SHA256'

config node 'n_ss'
	option label 'ss'
	option type 'shadowsocks'
	option address 'e.example.com'
	option port '8388'
	option shadowsocks_encrypt_method 'aes-256-gcm'
	option password 'secret'
	option multiplex '1'
	option multiplex_protocol 'h2mux'
	option multiplex_padding '1'
	option multiplex_max_connections '4'
	option udp_over_tcp '1'
	option udp_over_tcp_version '2'

config node 'n_hy2'
	option label 'hy2'
	option type 'hysteria2'
	option address 'f.example.com'
	option port '443'
	option password 'secret'
	option tls '1'
	option tls_sni 'f.example.com'
	option hysteria_obfs_type 'salamander'
	option hysteria_obfs_password 'obfspass'
	option hysteria_up_mbps '100'
	option hysteria_down_mbps '500'
	option hysteria_hopping_port '20000:30000'
	option hysteria_hop_interval '30'
	option hysteria_bbr_profile 'conservative'

config node 'n_snell'
	option label 'snell'
	option type 'snell'
	option address 'g.example.com'
	option port '443'
	option password 'psk123456789012'
	option snell_version '4'
	option snell_obfs_mode 'http'
	option snell_obfs_host 'bing.com'
	option snell_reuse '1'
	option snell_userkey 'ukey'

config node 'n_http'
	option label 'http'
	option type 'http'
	option address 'h.example.com'
	option port '8080'
	option username 'u'
	option password 'p'
	option tls '0'

config node 'n_socks'
	option label 'socks'
	option type 'socks'
	option address 'i.example.com'
	option port '1080'
	option username 'u'
	option password 'p'
	option socks_version '5'

config node 'n_shadowtls'
	option label 'shadowtls'
	option type 'shadowtls'
	option address 'j.example.com'
	option port '443'
	option password 'secret'
	option shadowtls_version '3'
	option tls '1'
	option tls_sni 'j.example.com'

