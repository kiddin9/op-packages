msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_Hans\n"

msgid "UPnP IGD & PCP"
msgstr "UPnP IGD 与 PCP"

msgid "UPnP IGD & PCP/NAT-PMP"
msgstr "UPnP IGD 与 PCP/NAT-PMP"

msgid "UPnP IGD & PCP/NAT-PMP Service"
msgstr "UPnP IGD 与 PCP/NAT-PMP 服务"

msgctxt "%s & %s/%s (%s = UPnP IGD, %s = PCP, %s = NAT-PMP)"
msgid "%s & %s/%s"
msgstr "%s 与 %s/%s"

msgctxt "The %s (%s = UPnP IGD & PCP/NAT-PMP) protocols/service enable permitted devices on local networks to autonomously set up IPv4/IPv6 port maps/forwards on this router."
msgid "The %s protocols/service enable permitted devices on local networks to autonomously set up IPv4/IPv6 port maps/forwards on this router."
msgstr "通过 %s 协议及服务，局域网内获准的设备可在此路由器上自动配置 IPv4/IPv6 端口映射（端口转发）。"

msgid "No suitable configuration was found!"
msgstr "未找到适用的配置文件！"

msgid "No suitable config (LuCI app %s) found in %s. A related package update (daemon or LuCI app) may be missing."
msgstr "未找到适配当前前端（LuCI 应用 %s）的配置文件 %s，可能缺少后端守护进程或 LuCI 应用的相关更新。"

msgid "Use the software package manager, update lists, and install the related update. Config is migrated with the daemon package update."
msgstr "请前往软件包管理器更新软件源列表并安装相应更新。升级后端守护进程软件包时会自动迁移旧版配置。"

msgid "Go to package manager…"
msgstr "前往软件包管理器…"

msgid "Active Port Maps"
msgstr "当前活动的端口映射"

msgid "Active UPnP IGD & PCP/NAT-PMP Port Maps"
msgstr "活动的 UPnP IGD 与 PCP/NAT-PMP 端口映射"

msgid "Hostname"
msgstr "主机名"

msgid "IP address"
msgstr "IP 地址"

msgid "Port"
msgstr "内部端口"

msgid "External port"
msgstr "外部端口"

msgid "Protocol"
msgstr "协议"

msgid "Expires"
msgstr "剩余有效期"

msgid "Added via / description"
msgstr "添加方式 / 描述"

msgid "Unknown"
msgstr "未知"

msgid "Delete"
msgstr "删除"

msgid "Not yet deletable; UPnP IGDv2 IPv6 port maps expire sooner, have no description"
msgstr "暂不支持手动删除；UPnP IGDv2 的 IPv6 端口映射有效期较短且不含描述信息"

msgid "No active IPv4/IPv6 port maps"
msgstr "当前没有活动的 IPv4/IPv6 端口映射"

msgid "Service Settings"
msgstr "服务设置"

msgid "Service Setup"
msgstr "服务配置"

msgid "Access Control"
msgstr "访问控制"

msgid "Advanced Settings"
msgstr "高级设置"

msgid "UPnP IGD Adjustments"
msgstr "UPnP IGD 参数调整"

msgid "Enable service"
msgstr "启用服务"

msgid "Enable the autonomous port mapping service"
msgstr "启用自动端口映射服务"

msgid "Enable protocols"
msgstr "启用协议"

msgid "All protocols"
msgstr "所有协议"

msgid "UPnP IGD"
msgstr "UPnP IGD"

msgid "PCP and NAT-PMP"
msgstr "PCP 与 NAT-PMP"

msgid "Enable networks"
msgstr "启用的内网接口"

msgid "Select local/internal (LAN) network interfaces to enable the service for"
msgstr "选择要启用此服务的本地（LAN）网络接口"

msgid "UPnP IGD compatibility"
msgstr "UPnP IGD 兼容模式"

msgid "Set compatibility mode (act as device) to workaround IGDv2-incompatible clients; %s are known to only work with %s (or) <br />Emulate/report a specific/different device to workaround/support/handle/bypass/assist/mitigate... (Alternative text welcome)"
msgstr "设置兼容模式以适配不兼容 IGDv2 的客户端（已知 %s 等客户端仅在 %s 模式下正常工作）"

msgid "IGDv1 (IPv4 only)"
msgstr "IGDv1（仅支持 IPv4）"

msgid "IGDv2 (with workarounds)"
msgstr "IGDv2（附带兼容性修正）"

msgid "Access defaults"
msgstr "默认访问策略"

msgid "Set access control defaults for ports that all devices can map"
msgstr "设置允许所有内网设备默认映射的端口范围"

msgid "None / accept extra ports only"
msgstr "无（仅允许下方额外指定的端口）"

msgid "Accept ports >= 1024"
msgstr "允许 >= 1024 的高位端口"

msgid "Accept HTTP/HTTPS + ports >= 1024"
msgstr "允许 HTTP/HTTPS 及 >= 1024 的端口"

msgid "Accept HTTP/HTTPS ports"
msgstr "仅允许 HTTP/HTTPS 端口"

msgid "Accept all ports"
msgstr "允许所有端口"

msgid "Accept extra ports"
msgstr "额外允许端口"

msgid "Reject ports"
msgstr "拒绝端口"

msgid "Reject unsafe/insecure/risky FTP/Telnet/DCE/NetBIOS/SMB/RDP ports by default; overrides other settings; use %s for none"
msgstr "默认拒绝存在安全风险的高危端口（FTP/Telnet/DCE/NetBIOS/SMB/RDP），优先级高于其他所有设置；填 %s 表示不拒绝任何端口"

msgid "Check ACL"
msgstr "启用 ACL 检查"

msgid "Extend or override access defaults by device-specific permissions using the access control list (ACL)"
msgstr "使用访问控制列表（ACL）按设备精细扩展或覆盖默认访问策略"

msgid "Sequence:"
msgstr "匹配顺序："

msgid "ACL entries (if checked)"
msgstr "ACL 条目（若启用）"

msgid "Disable IPv6 mapping"
msgstr "禁用 IPv6 映射"

msgid "IPv6 is currently always accepted unless disabled"
msgstr "除非在此禁用，否则当前默认放行所有 IPv6 端口请求"

msgctxt "Allow %s/%s (%s = CGNAT, %s = STUN)"
msgid "Allow %s/%s"
msgstr "允许 %s/%s"

msgid "Allow use of unrestricted endpoint-independent (1:1) CGNATs and detect the public IPv4"
msgstr "允许在无限制的端点无关型（NAT1 / 全锥形）CGNAT 下工作，并通过 STUN 探测公网 IPv4 地址"

msgid "Disabled"
msgstr "禁用"

msgid "Enabled"
msgstr "启用"

msgid "Manually override external IPv4 with public"
msgstr "手动指定公网 IPv4 地址以覆盖外部地址"

msgid "Filtering test currently requires an extra firewall rule"
msgstr "当前进行 NAT 过滤类型检测需配合额外的防火墙放行规则"

msgid "allow filtered"
msgstr "允许受限过滤"

msgid "Workaround filtered IPv4 CGNAT test result"
msgstr "绕过受限过滤型 IPv4 CGNAT 的 STUN 检测拦截"

msgid "report private IPv4, avoid"
msgstr "直接上报私网 IPv4，不建议"

msgid "No STUN public IPv4 detection; client issues"
msgstr "不通过 STUN 探测公网 IPv4；可能导致客户端连接异常"

msgid "STUN server"
msgstr "STUN 服务器"

msgid "Override external IPv4"
msgstr "自定义外部 IPv4 地址"

msgid "Report custom public/external (WAN) IPv4 address"
msgstr "向客户端通告自定义的公网（WAN）IPv4 地址"

msgid "Allow third-party mapping"
msgstr "允许第三方代映射"

msgid "Allow adding port maps for non-requesting IP addresses; use with care"
msgstr "允许客户端为非本机的其他内网 IP 地址添加端口映射，请谨慎开启"

msgid "recommended"
msgstr "推荐"

msgid "UPnP IGD only"
msgstr "仅 UPnP IGD"

msgid "PCP only"
msgstr "仅 PCP"

msgid "Report system instead of service uptime"
msgstr "上报系统运行时间而非服务运行时间"

msgid "Log level"
msgstr "日志级别"

msgid "Default"
msgstr "默认"

msgid "Info"
msgstr "信息"

msgid "Debug"
msgstr "调试"

msgid "Service lease file"
msgstr "服务租约文件"

msgid "Download speed"
msgstr "下行速率"

msgid "Upload speed"
msgstr "上行速率"

msgid "Report maximum connection speed in kbit/s"
msgstr "向客户端通告的最大连接速率（单位：kbit/s）"

msgid "Default interface link speed"
msgstr "默认使用接口链路速率"

msgid "Router/friendly name"
msgstr "路由器友好名称"

msgid "Announced model number"
msgstr "通告的设备型号"

msgid "Announced serial number"
msgstr "通告的序列号"

msgid "Router/presentation URL"
msgstr "路由器管理页面 URL"

msgid "Report custom router web interface URL"
msgstr "向客户端通告自定义的路由器 Web 管理界面地址"

msgid "Device UUID"
msgstr "设备 UUID"

msgid "SOAP/HTTP port"
msgstr "SOAP/HTTP 端口"

msgid "Notify interval"
msgstr "通告间隔"

msgctxt "A 900 s interval sends %s (%s = SSDP) announcements with the minimum %s (%s = Cache-Control: max-age=1800) header"
msgid "A 900 s interval sends %s announcements with the minimum %s header"
msgstr "设为 900 秒间隔时，发送的 %s 广播通告将携带最小有效期头部 %s"

msgid "Access Control List"
msgstr "访问控制列表 (ACL)"

msgid "The access control list (ACL) specifies which IPv4 addresses and ports can be mapped."
msgstr "访问控制列表（ACL）用于指定允许或禁止映射的内网 IPv4 地址及端口范围。"

msgid "ACL entries are checked in order, then rejected if not matched and not accepted by access defaults. (To do: should be part of access control tab)"
msgstr "ACL 条目按从上到下的顺序依次匹配；若均未命中且不符合默认访问策略，则拒绝请求。"

msgid "Edit ACL Entry"
msgstr "编辑 ACL 条目"

msgid "Comment"
msgstr "备注"

msgid "unspecified"
msgstr "未指定"

msgid "Enter device's IPv4 address, or an address and netmask"
msgstr "输入设备的 IPv4 地址，或带子网掩码的网段"

msgid "any port"
msgstr "任意端口"

msgid "Description filter"
msgstr "描述过滤规则"

msgid "Regular expression to check description of UPnP IGD IPv4 port maps"
msgstr "用于匹配 UPnP IGD IPv4 端口映射描述信息的正则表达式"

msgid "any description"
msgstr "任意描述"

msgid "Action"
msgstr "动作"

msgid "Accept"
msgstr "允许"

msgid "Reject"
msgstr "拒绝"

msgid "Grant access to UPnP IGD & PCP/NAT-PMP"
msgstr "授予访问 UPnP IGD 与 PCP/NAT-PMP 的权限"

msgid "Grant UCI access for luci-app-upnp"
msgstr "授予 luci-app-upnp 访问 UCI 配置的权限"
