# SPDX-License-Identifier: GPL-2.0-only
#
# Regression fixture for generate_server.uc: one inbound per protocol family,
# covering the shared TLS/transport builders (ACME provider, ECH key, REALITY,
# WebSocket/gRPC/HTTP transports) on the server side.

config homeproxy 'server'
	option enabled '1'
	option log_level 'warn'

config server 's_vless_ws'
	option enabled '1'
	option type 'vless'
	option listen_port '8443'
	option uuid '3af88561-9c69-4b19-8f7e-f08d580bc339'
	option transport 'ws'
	option ws_host 'a.example.com'
	option ws_path '/ws'
	option websocket_early_data '2048'
	option tls '1'
	option tls_sni 'a.example.com'
	option tls_acme '1'
	option tls_acme_domain 'a.example.com'
	option tls_acme_provider 'letsencrypt'
	option tls_acme_email 'admin@example.com'
	option tls_acme_dsn 'a.example.com'
	option tls_acme_key_type 'p256'
	option tls_alpn 'h2'
	option tls_min_version '1.2'

config server 's_anytls'
	option enabled '1'
	option type 'anytls'
	option listen_port '8444'
	option password 'secret'
	option anytls_padding_scheme 'stop=8'
	option tls '1'
	option tls_sni 'b.example.com'
	option tls_acme '1'
	option tls_acme_domain 'b.example.com'
	option tls_acme_provider 'zerossl'
	option tls_acme_email 'admin@example.com'
	option tls_acme_dsn 'b.example.com'

config server 's_hy2'
	option enabled '1'
	option type 'hysteria2'
	option listen_port '8445'
	option password 'secret'
	option hysteria_up_mbps '100'
	option hysteria_down_mbps '500'
	option hysteria_obfs_type 'salamander'
	option hysteria_obfs_password 'obfspass'
	option hysteria_masquerade 'https://example.com'
	option tls '1'
	option tls_sni 'c.example.com'
	option tls_acme '1'
	option tls_acme_domain 'c.example.com'
	option tls_acme_provider 'letsencrypt'
	option tls_acme_email 'admin@example.com'
	option tls_acme_dsn 'c.example.com'

config server 's_trojan_grpc'
	option enabled '1'
	option type 'trojan'
	option listen_port '8446'
	option password 'secret'
	option transport 'grpc'
	option grpc_servicename 'gs'
	option multiplex '1'
	option multiplex_padding '1'
	option tls '1'
	option tls_sni 'd.example.com'
	option tls_acme '1'
	option tls_acme_domain 'd.example.com'
	option tls_acme_provider 'letsencrypt'
	option tls_acme_email 'admin@example.com'
	option tls_acme_dsn 'd.example.com'

config server 's_ss'
	option enabled '1'
	option type 'shadowsocks'
	option listen_port '8447'
	option network 'tcp'
	option shadowsocks_encrypt_method 'aes-256-gcm'
	option password 'secret'
	option udp_timeout '300'

config server 's_snell'
	option enabled '1'
	option type 'snell'
	option listen_port '8448'
	option password 'psk123456789012'
	option snell_version '5'
	option snell_obfs_mode 'http'

config server 's_tuic'
	option enabled '1'
	option type 'tuic'
	option listen_port '8449'
	option uuid '3af88561-9c69-4b19-8f7e-f08d580bc339'
	option password 'secret'
	option tuic_congestion_control 'bbr'
	option tuic_auth_timeout '3'
	option tuic_heartbeat '10'
	option tls '1'
	option tls_sni 'e.example.com'
	option tls_acme '1'
	option tls_acme_domain 'e.example.com'
	option tls_acme_provider 'letsencrypt'
	option tls_acme_email 'admin@example.com'
	option tls_acme_dsn 'e.example.com'
