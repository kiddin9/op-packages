#!/bin/sh /etc/rc.common
# shellcheck shell=busybox
# shellcheck disable=SC2034  # rc.common reads START, STOP and USE_PROCD
# SPDX-License-Identifier: GPL-2.0-only
#
# Stopping or crashing leaves a forced fan forced, on purpose. Only
# "thermal-guard reset" hands it back. Do not add a stop_service that releases
# it: dying mid incident with the fan running is the safe direction.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/thermal-guard

# The instance runs whatever "enabled" says. The daemon reads the option every
# cycle and pauses on its own, which keeps it writing the status file so the
# web interface can say "paused, stage still active" instead of showing a
# snapshot that quietly stopped ageing.
start_service() {
	procd_open_instance
	procd_set_param command "$PROG" daemon
	# Respawn on crash. A forced fan stays forced meanwhile, which is the safe direction.
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger thermal-guard
}

# Nothing to do. tg_cfg runs at the top of every cycle, so a changed option is
# live within one interval. Restarting here would drop a stage action that is
# in flight, which is a real risk for no gain. Use restart if you want that.
reload_service() {
	return 0
}
