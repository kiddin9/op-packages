#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15
. /usr/lib/hijpass/common.sh
HIJPASS_LOG_SOURCE=${initscript:-/etc/init.d/hijpass}
. /usr/lib/hijpass/service/procd.sh

DNS_HOOK=/etc/hijpass/hook/dns-hook.sh

# 同一次 restart 的 stop/start 共用锁，避免期间插入新的文件更新。
wait_updates() {
    [ "${updates_locked:-0}" = 1 ] && return 0
    hijpass_log DEBUG 'Waiting for rule/core updates before changing hijpass service'
    hijpass_lock_updates 300 || {
        hijpass_log ERROR 'Cannot acquire update lock within 600 seconds; service operation cancelled'
        exit 1
    }
    updates_locked=1
}

start_service() {
    local plan kind instance keys id name
    wait_updates
    "$HIJPASS_LIB/rpc/jobs.sh" clear || exit 1
    hijpass_log INFO '===================== Starting hijpass ======================='
    hijpass_run_logged 'Clear previous diagnostics' "$HIJPASS_LIB/diagnostics/task.sh" clear
    plan="$(hijpass_run_logged 'Prepare hijpass configurations' "$HIJPASS_LIB/service/prepare.sh")" || exit 1
    # 使用独立 JSON 命名空间，避免覆盖 rc.common 正在组装的 procd 消息。
    json_set_namespace hijpass_plan
    json_load "$plan" || { hijpass_log ERROR 'Invalid hijpass service plan: malformed JSON'; exit 1; }
    json_get_type kind instances
    [ "$kind" = array ] || { hijpass_log ERROR 'Invalid hijpass service plan: instances must be an array'; exit 1; }
    json_select instances
    json_get_keys keys
    instances=
    for instance in $keys; do
        json_select "$instance" || {
            hijpass_log ERROR "Invalid hijpass instance entry: index=$instance"
            continue
        }
        json_get_vars id name
        if hijpass_run_logged "Prepare hijpass instance $id ($name)" hijpass_add_instance; then
            instances="$instances $instance"
        fi
        json_select ..
    done
}

service_started() {
    # procd 已收到实例描述；按顺序设置辅助功能，不轮询进程状态。
    [ -n "$instances" ] || return 0
    hijpass_run_logged 'Reset policy routes' "$HIJPASS_LIB/firewall/route.sh" reset
    "$HIJPASS_LIB/firewall/firewall.sh" reset
    hijpass_log INFO 'Executing DNS Hook (start)'
    hijpass_run_logged 'DNS Hook start' "$DNS_HOOK" start
    update_cron enable
}

stop_service() {
    wait_updates
    hijpass_log INFO '===================== Stopping hijpass ======================='
    hijpass_log INFO 'Executing DNS Hook (stop)'
    hijpass_run_logged 'DNS Hook stop' "$DNS_HOOK" stop
    # 按撤流、路由、cron 的顺序尝试清理；失败不阻断其他步骤或框架停实例。
    "$HIJPASS_LIB/firewall/firewall.sh" remove
    hijpass_run_logged 'Remove policy routes' "$HIJPASS_LIB/firewall/route.sh" remove
    update_cron disable
}

update_cron() {
    local schedule='' logs=0
    hijpass_log INFO "Updating hijpass cron entries ($1)"
    schedule=$(uci -q get 'hijpass.@rule[0].update_schedule')
    [ "$(uci -q get 'hijpass.@hijpass[0].enabled')" = 1 ] || schedule=
    [ "$1" != enable ] || logs=1
    hijpass_run_logged 'Write hijpass cron entries' "$HIJPASS_LIB/service/cron.sh" hijpass "$schedule" "$logs" || return 1
    hijpass_log INFO 'Reloading cron for hijpass'
    hijpass_run_logged 'Reload cron for hijpass' /etc/init.d/cron restart
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger hijpass
    procd_add_interface_trigger "interface.*.up" "*" /etc/init.d/hijpass restart
}

boot() {
    local delay
    delay=$(uci -q get 'hijpass.@hijpass[0].delay_time') || delay=10
    delay=${delay:-10}
    [ "$delay" -ge 0 ] 2>/dev/null || {
        hijpass_log WARN 'Invalid hijpass startup delay; using default 10 seconds'
        delay=10
    }
    [ "$delay" -le 0 ] || hijpass_run_logged 'Wait for hijpass startup delay' sleep "$delay" || return $?
    start
}
