{
  "luci-app-hijpass": {
    "description": "Grant access to hijpass configurations",
    "read": {
      "uci": [
        "hijpass",
        "hijserver",
        "dhcp"
      ],
      "ubus": {
        "service": [
          "list"
        ],
        "hijpass": [
          "firewall_template_default",
          "log_list",
          "log_read",
          "firewall_show",
          "network_connect",
          "network_ping",
          "rule_query",
          "rule_update_status",
          "rule_match",
          "geo_lookup",
          "geo_query",
          "trace_capabilities",
          "trace_status",
          "core_version",
          "core_latest",
          "core_update_status",
          "job_status",
          "editor_sessions"
        ]
      },
      "file": {
        "/etc/hijpass/rules/ip-direct.txt": [
          "read"
        ],
        "/etc/hijpass/rules/ip-proxy.txt": [
          "read"
        ],
        "/etc/hijpass/rules/domain-direct.txt": [
          "read"
        ],
        "/etc/hijpass/rules/domain-proxy.txt": [
          "read"
        ],
        "/etc/hijpass/firewall.ut": [
          "read"
        ],
        "/etc/hijpass/hook/nft-hook.sh": [
          "read"
        ],
        "/etc/hijpass/hook/dns-hook.sh": [
          "read"
        ],
        "/etc/hijpass/shunt.json": [
          "read"
        ],
        "/etc/hijpass/client/*.json": [
          "read"
        ],
        "/etc/hijpass/server/*.json": [
          "read"
        ]
      },
      "cgi-io": [
        "download"
      ]
    },
    "write": {
      "uci": [
        "hijpass",
        "hijserver"
      ],
      "ubus": {
        "hijpass": [
          "config_render",
          "config_validate",
          "server_render",
          "server_validate",
          "log_clear",
          "cleanup_node",
          "service_restart",
          "firewall_reset",
          "rule_update",
          "core_update",
          "trace_start",
          "trace_release"
        ]
      },
      "file": {
        "/etc/hijpass/rules/ip-direct.txt": [
          "write"
        ],
        "/etc/hijpass/rules/ip-proxy.txt": [
          "write"
        ],
        "/etc/hijpass/rules/domain-direct.txt": [
          "write"
        ],
        "/etc/hijpass/rules/domain-proxy.txt": [
          "write"
        ],
        "/etc/hijpass/firewall.ut": [
          "write"
        ],
        "/etc/hijpass/hook/nft-hook.sh": [
          "write"
        ],
        "/etc/hijpass/hook/dns-hook.sh": [
          "write"
        ],
        "/etc/hijpass/shunt.json": [
          "write"
        ],
        "/etc/hijpass/client/*.json": [
          "write"
        ]
      },
      "cgi-io": [
        "upload"
      ]
    }
  }
}
