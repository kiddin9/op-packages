msgid "APN %s"
msgstr "APN %s"

#: htdocs/luci-static/resources/wwand/simlist.js:197
msgid ""
"APN authentication for this card (only needed when the operator requires a "
"username/password)."
msgstr "此卡的 APN 认证方式（仅当运营商要求用户名/密码时需要）。"

#: htdocs/luci-static/resources/wwand/modemopts.js:224
msgid ""
"APN for the initial network attach, when the network wants a different one "
"from the data connection (an IMS or admin bearer). Leave empty to attach "
"with the interface's own APN, which is the normal case."
msgstr "用于初始网络附着 (Attach) 的 APN，适用于网络要求使用与数据连接不同的 APN（如 IMS 或管理承载）的情况。留空则使用接口自身的 APN 进行附着（常规情况）。"

#: htdocs/luci-static/resources/wwand/modemopts.js:200
msgid "AT control TTY"
msgstr "AT 控制串口 (TTY)"

#: htdocs/luci-static/resources/view/wwand/settings.js:336
#: htdocs/luci-static/resources/view/wwand/settings.js:542
msgid "Access technologies"
msgstr "接入技术"

#: htdocs/luci-static/resources/view/wwand/modems.js:528
msgid "Actions"
msgstr "操作"

#: htdocs/luci-static/resources/view/wwand/status.js:153
msgid "Active connections"
msgstr "活动连接"

#: htdocs/luci-static/resources/wwand/simlist.js:109
msgid "Add SIM"
msgstr "添加 SIM 卡"

#: htdocs/luci-static/resources/view/wwand/modems.js:123
msgid ""
"Add a modem here, then point an interface at it with the \"Modem\" field on "
"the interface page."
msgstr "在此添加调制解调器，然后在接口页面的“调制解调器”字段中将接口指向它。"

#: htdocs/luci-static/resources/view/wwand/settings.js:668
msgid "Add entry"
msgstr "添加条目"

#: htdocs/luci-static/resources/view/wwand/modems.js:126
msgid "Add modem"
msgstr "添加调制解调器"

#: htdocs/luci-static/resources/wwand/esim.js:484
msgid ""
"After a download or profile change the eUICC queues notifications that "
"confirm the operation to the operator. Send them once the router has "
"internet."
msgstr "下载或更改配置文件后，eUICC 会将向运营商确认操作的通知排入队列。请在路由器联网后发送这些通知。"

#: htdocs/luci-static/resources/wwand/graph.js:114
msgid "Aggregate bandwidth"
msgstr "聚合带宽"

#: htdocs/luci-static/resources/wwand/graph.js:111
