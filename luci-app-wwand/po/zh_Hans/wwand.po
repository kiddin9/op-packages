#: htdocs/luci-static/resources/view/wwand/settings.js:849
msgid "Store the lock in modem non-volatile memory"
msgstr "将锁定存储在调制解调器非易失性存储器中"

#: htdocs/luci-static/resources/view/wwand/status.js:311
msgid "Strongest signals"
msgstr "最强信号"

