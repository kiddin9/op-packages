#: htdocs/luci-static/resources/wwand/modemopts.js:230
msgid ""
"Authentication for the attach bearer. Only used together with an attach APN."
msgstr ""
"Uwierzytelnianie nośnika dołączania. Używane tylko razem z APN dołączania."

#: htdocs/luci-static/resources/wwand/simlist.js:196
msgid "Authentication type"
msgstr "Typ uwierzytelniania"

#: htdocs/luci-static/resources/wwand/modemopts.js:755
