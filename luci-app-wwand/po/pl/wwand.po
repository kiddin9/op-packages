#: htdocs/luci-static/resources/view/wwand/modems.js:523
msgid "Band, operator, SIM, eSIM and SMS tools for this modem"
msgstr "Narzędzia pasma, operatora, SIM, eSIM i SMS dla tego modemu"

#: htdocs/luci-static/resources/view/wwand/status.js:50
