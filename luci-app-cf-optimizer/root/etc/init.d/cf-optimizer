#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG="/usr/sbin/cf-optimizer"
CONF="cf-optimizer"

start_service() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled settings enabled 0
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p /var/run/cf-optimizer
	"$PROG" sync-hosts >/dev/null 2>&1

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_stopped() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled settings enabled 0
	if [ "$enabled" != "1" ]; then
		"$PROG" clean
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
