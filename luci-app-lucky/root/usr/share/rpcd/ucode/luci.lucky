#!/usr/bin/ucode
'use strict';
import { connect } from 'ubus';
import { popen, readfile, writefile, unlink, stat } from 'fs';
import { cursor } from 'uci';

function trim(s) {
    if (s) return replace(s, /^\s+|\s+$/g, '');
    return s;
}

function shellquote(s) {
    if (!s) return "''";
    return "'" + replace(s, "'", "'\\''") + "'";
}

function get_configdir() {
    let c = cursor();
    c.load('lucky');
    let dir = c.get('lucky', '@lucky[0]', 'configdir');
    return dir ? trim(dir) : '';
}

function get_procd_status() {
    let u = connect();
    if (!u)
        return { running: false };

    let res = u.call('service', 'list', { name: 'lucky' });
    if (res && res['lucky'] && res['lucky'].instances) {
        let instances = res['lucky'].instances;
        for (let name in instances) {
            let inst = instances[name];
            if (inst && inst.running)
                return { running: true, pid: inst.pid };
        }
    }

    return { running: false };
}

function get_real_lucky_pid() {
    let p = popen('pidof /usr/bin/lucky', 'r');
    if (!p)
        return null;

    let pid_str = p.read('all');
    p.close();

    if (!pid_str)
        return null;

    let pids = split(trim(pid_str), /\s+/);
    return (length(pids) > 0 && pids[0] != '') ? pids[0] : null;
}

function get_pid() {
    let procd_st = get_procd_status();
    let real_pid = get_real_lucky_pid();
    return (real_pid || procd_st.pid || "") + "";
}

// 获取配置文件的修改时间戳，用于热更新感知自愈
function get_config_mtime() {
    let dir = get_configdir() || '/etc/config/lucky.daji';
    let base_file = dir + '/lucky_base.lkcf';
    let st = stat(base_file);
    if (st && st.mtime)
        return st.mtime;
    let conf_file = dir + '/lucky.conf';
    st = stat(conf_file);
    if (st && st.mtime)
        return st.mtime;
    st = stat(dir);
    return st ? (st.mtime || 0) : 0;
}

// 原生多级 fallback 架构探测，替代外部历史遗留脚本
function detect_arch() {
    let u = connect();
    let arch = '';
    if (u) {
        let board = u.call('system', 'board');
        if (board && board.release && board.release.arch) {
            arch = board.release.arch;
        }
    }

    if (!arch) {
        let rel = readfile('/etc/openwrt_release');
        if (rel) {
            let m = match(rel, /DISTRIB_ARCH=['"]?([^'"\n]+)/);
            if (m) arch = m[1];
        }
    }

    if (!arch) {
        let p = popen('uname -m', 'r');
        if (p) {
            arch = trim(p.read('all'));
            p.close();
        }
    }

    if (!arch && u) {
        let board = u.call('system', 'board');
        if (board && board.release && board.release.target) {
            arch = board.release.target;
        }
    }

    arch = lc(arch || '');
    if (match(arch, /x86_64|amd64/)) return 'x86_64';
    if (match(arch, /i[3-6]86|x86/)) return 'i386';
    if (match(arch, /aarch64|arm64|armv8/)) return 'arm64';
    if (match(arch, /armv7/)) return 'armv7';
    if (match(arch, /armv6/)) return 'armv6';
    if (match(arch, /armv5/)) return 'armv5';
    if (match(arch, /arm/)) return 'armv7';
    if (match(arch, /mipsel/)) return 'mipsle_softfloat';
    if (match(arch, /mips/)) return 'mips_softfloat';

    return arch || 'unknown';
}

const CACHE_FILE = '/tmp/lucky_info_cache';

// 读取缓存：需同时满足 PID 未变且配置文件 mtime 未变
function get_cache() {
    try {
        let content = readfile(CACHE_FILE);
        if (content) {
            let cache = json(content);
            let currentPid = get_pid();
            let currentMtime = get_config_mtime();
            if (cache && cache.pid === currentPid && cache.mtime === currentMtime && cache.data) {
                return cache.data;
            }
        }
    } catch(err) {}
    return null;
}

// 写入缓存，同时绑定 PID 与配置文件 mtime
function set_cache(data) {
    let pid = get_pid();
    let mtime = get_config_mtime();
    if (data) {
        writefile(CACHE_FILE, sprintf("%J", { pid: pid, mtime: mtime, data: data }));
    }
}

// 清除缓存
function clear_cache() {
    try { unlink(CACHE_FILE); } catch(err) {}
}

const methods = {
    // 合并接口：一次返回运行状态 + 程序信息 + 管理信息
    get_info: {
        call: function() {
            let configPath = get_configdir();

            // 1. 检测运行状态
            let procd_st = get_procd_status();
            let real_pid = get_real_lucky_pid();

            let state = 'stopped';
            if (procd_st.running)
                state = 'managed';
            else if (real_pid)
                state = 'unmanaged';

            let running = (state !== 'stopped');
            let pid = (state === 'managed' ? (real_pid || procd_st.pid) : real_pid) || null;

            // 2. 程序信息（从缓存或实时获取）
            let luckyInfo = "";
            let luckyArch = "";
            let adminPort = "";
            let adminSafeUrl = "";
            let adminAllowInternet = false;

            let cached = get_cache();
            if (cached) {
                luckyInfo = cached.luckyInfo || "";
                luckyArch = cached.luckyArch || "";
                adminPort = cached.adminPort || "";
                adminSafeUrl = cached.adminSafeUrl || "";
                adminAllowInternet = cached.adminAllowInternet || false;
            } else {
                let fd = popen(configPath ?
                    `/usr/bin/lucky -info -cd ${shellquote(configPath)}` :
                    "/usr/bin/lucky -info");
                if (fd) { luckyInfo = trim(fd.read('all')); fd.close(); }

                luckyArch = detect_arch();

                let cmd = configPath ?
                    `/usr/bin/lucky -baseConfInfo -cd ${shellquote(configPath)}` :
                    `/usr/bin/lucky -baseConfInfo`;
                fd = popen(cmd);
                if (fd) {
                    let confStr = trim(fd.read('all'));
                    fd.close();
                    if (confStr) {
                        try {
                            let obj = json(confStr);
                            if (obj && obj.BaseConfigure) {
                                adminPort = obj.BaseConfigure.AdminWebListenPort || "";
                                adminSafeUrl = obj.BaseConfigure.SafeURL || "";
                                adminAllowInternet = obj.BaseConfigure.AllowInternetaccess || false;
                            }
                        } catch(err) {}
                    }
                }

                set_cache({ 
                    luckyInfo: luckyInfo, 
                    luckyArch: luckyArch,
                    adminPort: adminPort,
                    adminSafeUrl: adminSafeUrl,
                    adminAllowInternet: adminAllowInternet
                });
            }

            return {
                running: running,
                state: state,
                pid: pid,
                luckyInfo: luckyInfo,
                luckyArch: luckyArch,
                adminPort: adminPort,
                adminSafeUrl: adminSafeUrl,
                adminAllowInternet: adminAllowInternet
            };
        }
    },
    get_status: {
        call: function() {
            let procd_st = get_procd_status();
            let real_pid = get_real_lucky_pid();

            let state = 'stopped';
            if (procd_st.running)
                state = 'managed';
            else if (real_pid)
                state = 'unmanaged';

            let running = (state !== 'stopped');
            let pid = (state === 'managed' ? (real_pid || procd_st.pid) : real_pid) || null;

            return {
                running: running,
                state: state,
                pid: pid
            };
        }
    },

    get_log: {
        call: function() {
            let fd = popen("logread -e lucky | tail -n 100");
            let log = fd ? fd.read('all') : "";
            if (fd) fd.close();
            return { log: log };
        }
    },
    set_config: {
        args: { key: 'key', value: 'value' },
        call: function(req) {
            if (!req.args || !req.args.key) {
                return { ret: 1, error: "Missing key" };
            }
            let key = req.args.key;
            let value = req.args.value || "";
            let ret = 1;
            let configPath = get_configdir();

            if (key === "admin_http_port" || key === "admin_safe_url" || key === "switch_Internetaccess") {
                let realKey = key;
                let cmd = "";

                if (key === "admin_http_port") {
                    let portVal = trim("" + value);
                    if (!match(portVal, /^[1-9][0-9]{0,4}$/)) {
                        return { ret: 1, error: "Invalid port format" };
                    }
                    let p = int(portVal);
                    if (p < 1 || p > 65535) {
                        return { ret: 1, error: "Port out of range (1-65535)" };
                    }
                    realKey = "AdminWebListenPort";
                    value = "" + p;
                } else if (key === "admin_safe_url") {
                    let urlVal = trim("" + value);
                    if (urlVal !== "") {
                        if (!match(urlVal, /^\/[-a-zA-Z0-9_\/]+$/) || match(urlVal, /\.\./)) {
                            return { ret: 1, error: "Invalid SafeURL path" };
                        }
                    }
                    realKey = "SafeURL";
                    value = urlVal;
                } else if (key === "switch_Internetaccess") {
                    realKey = "AllowInternetaccess";
                    value = (value === true || value === "1" || value === "true") ? "true" : "false";
                }

                if (key === "admin_safe_url" && value === "") {
                    cmd = `/usr/bin/lucky -rCancelSafeURL`;
                } else {
                    cmd = `/usr/bin/lucky -setconf -key ${shellquote(realKey)} -value ${shellquote(value)}`;
                }

                if (configPath !== "") {
                    cmd += ` -cd ${shellquote(configPath)}`;
                }
                system(cmd);
                clear_cache();
                ret = 0;
            } else if (key === "configdir") {
                let p = trim("" + value);
                if (!match(p, /^\/[-a-zA-Z0-9_.\/]+$/) || match(p, /\.\./)) {
                    return { ret: 1, error: "Invalid config directory path" };
                }
                // 拦截系统敏感目录
                let forbidden = ['/', '/bin', '/sbin', '/etc', '/usr', '/lib', '/dev', '/proc', '/sys', '/root', '/var'];
                for (let i = 0; i < length(forbidden); i++) {
                    if (p === forbidden[i] || p === forbidden[i] + '/') {
                        return { ret: 1, error: "System directory not allowed" };
                    }
                }
                let c = cursor();
                c.load('lucky');
                c.set('lucky', '@lucky[0]', 'configdir', p);
                c.commit('lucky');
                clear_cache();
                ret = 0;
            } else if (key === "reset_auth_info") {
                let cmd1 = `/usr/bin/lucky -setconf -key AdminAccount -value 666`;
                let cmd2 = `/usr/bin/lucky -setconf -key AdminPassword -value 666`;
                if (configPath !== "") {
                    cmd1 += ` -cd ${shellquote(configPath)}`;
                    cmd2 += ` -cd ${shellquote(configPath)}`;
                }
                system(cmd1);
                system(cmd2);
                clear_cache();
                ret = 0;
            }

            return { ret: ret };
        }
    },
    service: {
        args: { action: 'action' },
        call: function(req) {
            if (!req.args || !req.args.action) {
                return { success: false };
            }
            let action = req.args.action;
            let applied = true;
            if (action === "start" || action === "restart" || action === "stop") {
                clear_cache();
                // 进程控制权限完全交由 init 脚本处理，杜绝 ucode 越权强杀竞态
                let rc = system(`/etc/init.d/lucky ${action} >/dev/null 2>&1`);
                applied = (rc === 0);
                system("sleep 1");
            }
            return { success: true, applied: applied };
        }
    }
};

return { 'luci.lucky': methods };
