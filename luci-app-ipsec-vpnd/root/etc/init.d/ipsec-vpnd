#!/bin/sh /etc/rc.common

START=90
STOP=10

USE_PROCD=1
PROG=/usr/lib/ipsec/starter

. $IPKG_INSTROOT/lib/functions.sh
. $IPKG_INSTROOT/lib/functions/network.sh

IPSEC_SECRETS_FILE=/etc/ipsec.secrets
IPSEC_CONN_FILE=/etc/ipsec.conf
STRONGSWAN_CONF_FILE=/etc/strongswan.conf

reload_service() {
	config_load ipsec-vpnd

	local vt_enabled
	config_get_bool vt_enabled "ipsec" "enabled" "0"
	[ "$vt_enabled" -eq "0" ] && {
		stop
		return 1
	}

	# 配置变更时重启 procd 实例以重新加载。
	# 不要使用 strongswan 的 ipsec rereadall/reload 命令：
	# 它们通过 starter pidfile 操作 charon，会误杀本服务
	# 自己管理的 starter/charon 实例
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ipsec-vpnd"
}

start_service() {
	config_load ipsec-vpnd

	local vt_enabled
	config_get_bool vt_enabled "ipsec" "enabled" "0"
	[ "$vt_enabled" -eq "0" ] && return 1

	# 系统 strongswan 的 ipsec 服务与本服务共用 charon 及 UDP 500/4500，
	# 必须停掉并禁用来避免抢端口。每次启动都重新执行，防止系统 ipsec
	# 被升级或手动重新启用后再次抢占。
	[ -x /etc/init.d/ipsec ] && {
		/etc/init.d/ipsec stop >/dev/null 2>&1
		/etc/init.d/ipsec disable >/dev/null 2>&1
	}

	local vt_clientip vt_clientdns vt_account vt_password vt_secret
	config_get vt_clientip "ipsec" "clientip" "10.9.8.10/24"
	config_get vt_clientdns "ipsec" "clientdns" "10.9.8.1"
	config_get vt_account "ipsec" "account" "vpnuser"
	config_get vt_password "ipsec" "password" "changeme"
	config_get vt_secret "ipsec" "secret" "changeme"

	cat > /etc/ipsec.conf <<EOF
# ipsec.conf - strongSwan IPsec configuration file

# basic configuration

config setup
    # strictcrlpolicy=yes
    uniqueids=never

# Add connections here.

conn xauth_psk
	keyexchange=ikev1
	ike=aes128-sha1-modp2048,aes128-sha1-modp1024,3des-sha1-modp1024,3des-sha1-modp1536
	esp=aes128-sha1,3des-sha1
	left=%defaultroute
	leftauth=psk
	leftsubnet=0.0.0.0/0
	right=%any
	rightauth=psk
	rightauth2=xauth
	rightsourceip=$vt_clientip
	rightdns=$vt_clientdns
	leftupdown=/usr/lib/ipsec/luci-ipsec-vpnd-updown
	auto=add
EOF

	# secrets 含 PSK 与 XAUTH 密码，用 177 umask 创建并收紧权限，
	# 避免本地用户读取
	umask 177
	cat > /etc/ipsec.secrets <<EOF
# /etc/ipsec.secrets - strongSwan IPsec secrets file
: PSK "$vt_secret"
$vt_account : XAUTH "$vt_password"
EOF
	umask 022
	chmod 600 /etc/ipsec.secrets

	procd_open_instance

	procd_set_param command $PROG --daemon charon --nofork

	procd_set_param file $IPSEC_CONN_FILE
	procd_append_param file $IPSEC_SECRETS_FILE
	procd_append_param file $STRONGSWAN_CONF_FILE
	procd_append_param file /etc/strongswan.d/*.conf
	procd_append_param file /etc/strongswan.d/charon/*.conf

	procd_set_param respawn

	procd_close_instance
}

stop_service() {
	# proxy_arp 由 updown 钩子按 ipsec0 接口单独设置，接口在服务停止时随 charon
	# 一并移除，无需在此清理。
	return 0
}
