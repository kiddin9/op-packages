#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# luci-app-ipsec-vpnd 运行时依赖自检。
#
# 由三处共用：
#   - /usr/lib/ipsec/luci-ipsec-vpnd-render：渲染前检查「必需」依赖
#   - /usr/libexec/rpcd/ipsec-vpnd：LuCI 页面的依赖诊断面板
#   - 安装后/排障时手工执行
#
# 用法：
#   luci-ipsec-vpnd-deps files           文件类检查（必需 + 可选）
#   luci-ipsec-vpnd-deps files-required  只检查必需文件（render 使用）
#   luci-ipsec-vpnd-deps pkgs            软件包安装状态（必需 + 可选）
#
# 输出格式（每行一条，'|' 分隔）：
#   <key>|<status>|<detail>
#   status: ok | missing | optional
#     missing  = 必需项缺失，服务不可用
#     optional = 可选项缺失；IKEv2 仍可用，只影响 IKEv1/3DES
#   detail: ok 时为路径或版本号；缺失时为处理建议
#
# 退出码：仅必需项缺失时返回 1；可选项缺失返回 0。

# 必需：所有协议都要用
PKGS_REQUIRED="strongswan-minimal strongswan-charon strongswan-mod-stroke strongswan-mod-kernel-libipsec kmod-tun"
# 可选：只影响 IKEv1（XAuth）与 3DES 回退；6.1 关闭 IKEv1 的构建没有这些包
PKGS_OPTIONAL="strongswan-mod-xauth-generic strongswan-mod-des"

MISSING=0

check_file() {
	# $1=key  $2=路径  $3=缺失时的处理建议  $4=required|optional
	if [ -e "$2" ]; then
		printf '%s|ok|%s\n' "$1" "$2"
	elif [ "$4" = "optional" ]; then
		printf '%s|optional|%s\n' "$1" "$3"
	else
		MISSING=1
		printf '%s|missing|%s\n' "$1" "$3"
	fi
}

files() {
	local mode="${1:-all}"

	check_file starter /usr/lib/ipsec/starter \
		"缺少 strongSwan 启动器 /usr/lib/ipsec/starter（由 strongswan-mod-stroke 提供，随 strongswan-minimal 一并安装）" \
		required
	check_file charon /usr/lib/ipsec/charon \
		"缺少 IKE 守护进程 /usr/lib/ipsec/charon（需安装 strongswan-charon）" \
		required
	check_file libipsec /etc/strongswan.d/charon/kernel-libipsec.conf \
		"缺少 kernel-libipsec 插件（需安装 strongswan-mod-kernel-libipsec）" \
		required
	[ "$mode" = "required" ] && return 0

	check_file xauth /etc/strongswan.d/charon/xauth-generic.conf \
		"缺少 xauth-generic 插件（需安装 strongswan-mod-xauth-generic）；仅影响 IKEv1/XAuth，IKEv2 不受影响" \
		optional
	check_file des /etc/strongswan.d/charon/des.conf \
		"缺少 des 插件（需安装 strongswan-mod-des）；仅影响 3DES 回退，AES 不受影响" \
		optional
}

# 取已安装包的版本号；apk 与 opkg 两种包管理器都支持
pkg_version() {
	if command -v apk >/dev/null 2>&1; then
		apk list --installed "$1" 2>/dev/null | awk 'NR==1{print $1}'
	elif command -v opkg >/dev/null 2>&1; then
		opkg list-installed "$1" 2>/dev/null | awk 'NR==1{print $3}'
	fi
}

pkgs() {
	local p v
	for p in $PKGS_REQUIRED; do
		v="$(pkg_version "$p")"
		if [ -n "$v" ]; then
			printf '%s|ok|%s\n' "$p" "$v"
		else
			MISSING=1
			printf '%s|missing|not installed\n' "$p"
		fi
	done
	for p in $PKGS_OPTIONAL; do
		v="$(pkg_version "$p")"
		if [ -n "$v" ]; then
			printf '%s|ok|%s\n' "$p" "$v"
		else
			printf '%s|optional|not installed (only needed for IKEv1 / 3DES)\n' "$p"
		fi
	done
}

case "${1:-files}" in
	files) files all ;;
	files-required) files required ;;
	pkgs) pkgs ;;
	*) files all ;;
esac

exit $MISSING
