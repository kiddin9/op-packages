# =========================================================
# Quick Setup
# =========================================================
msgid "Quick Setup"
msgstr "দ্রুত সেটআপ"

msgid "1. Server — 5 GHz wireless only"
msgstr "১. প্রদানকারী — শুধু 5 GHz বেতার"

msgid "2. Server — 2.4 GHz wireless only"
msgstr "২. প্রদানকারী — শুধু 2.4 GHz বেতার"

msgid "3. Server — Dual-band wireless only"
msgstr "৩. প্রদানকারী — শুধু দ্বি তরঙ্গ বেতার"

msgid "4. Server — Wired backhaul only"
msgstr "৪. প্রদানকারী — শুধু তারযুক্ত সংযোগ-ভিত্তি"

msgid "5. Server — 5 GHz + Wired"
msgstr "৫. প্রদানকারী — 5 GHz + তারযুক্ত"

msgid "6. Server — 2.4 GHz + Wired"
msgstr "৬. প্রদানকারী — 2.4 GHz + তারযুক্ত"

msgid "7. Server — Dual-band + Wired"
msgstr "৭. প্রদানকারী — দ্বি তরঙ্গ + তারযুক্ত"

msgid "8. Client — 5 GHz wireless only"
msgstr "৮. গ্রাহক — শুধু 5 GHz বেতার"

msgid "9. Client — 2.4 GHz wireless only"
msgstr "৯. গ্রাহক — শুধু 2.4 GHz বেতার"

msgid "10. Client — Dual-band wireless only"
msgstr "১০. গ্রাহক — শুধু দ্বি তরঙ্গ বেতার"

msgid "11. Client — Wired backhaul only"
msgstr "১১. গ্রাহক — শুধু তারযুক্ত সংযোগ-ভিত্তি"

msgid "12. Client — 5 GHz + Wired fallback"
msgstr "১২. গ্রাহক — 5 GHz + তারযুক্ত ফলব্যাক"

msgid "13. Client — 2.4 GHz + Wired fallback"
msgstr "১৩. গ্রাহক — 2.4 GHz + তারযুক্ত ফলব্যাক"

msgid "14. Client — Dual-band + Wired fallback"
msgstr "১৪. গ্রাহক — দ্বি তরঙ্গ + তারযুক্ত ফলব্যাক"

msgid "15. Node — 5 GHz relay"
msgstr "১৫. মধ্যবর্তী-সংযোগ — 5 GHz পুনর্প্রেরণ"

msgid "16. Node — Dual-band relay"
msgstr "১৬. মধ্যবর্তী-সংযোগ — দ্বি তরঙ্গ পুনর্প্রেরণ"

msgid "17. Node — Wired relay only"
msgstr "১৭. মধ্যবর্তী-সংযোগ — শুধু তারযুক্ত পুনর্প্রেরণ"

msgid "18. Detach wired backhaul"
msgstr "১৮. তারযুক্ত সংযোগ-ভিত্তি বিচ্ছিন্ন করুন"

msgid "19. Disable mesh"
msgstr "১৯. মেশ বন্ধ করুন"

# Preset descriptions
msgid "[SERVER] Gateway. Extenders join via 5 GHz mesh only."
msgstr "[প্রদানকারী] গেটওয়ে। এক্সটেন্ডারগুলি শুধু 5 GHz মেশ দিয়ে যুক্ত হবে।"

msgid "[SERVER] Extenders join via 2.4 GHz (longer range)."
msgstr "[প্রদানকারী] এক্সটেন্ডারগুলি 2.4 GHz দিয়ে যুক্ত হবে (দীর্ঘ পরিসর)।"

msgid "[SERVER] Both radios carry backhaul."
msgstr "[প্রদানকারী] উভয় রেডিও সংযোগ-ভিত্তি বহন করবে।"

msgid "[SERVER] No wireless mesh — extenders connect by cable."
msgstr "[প্রদানকারী] কোনো বেতার মেশ নেই — এক্সটেন্ডারগুলি কেবল দিয়ে যুক্ত হবে।"

msgid "[SERVER] 5 GHz mesh primary, Ethernet parallel."
msgstr "[প্রদানকারী] 5 GHz মেশ প্রাথমিক, ইথারনেট সমান্তরাল।"

msgid "[SERVER] 2.4 GHz mesh plus Ethernet."
msgstr "[প্রদানকারী] 2.4 GHz মেশ এবং ইথারনেট।"

msgid "[SERVER] Maximum redundancy. Both radios + Ethernet."
msgstr "[প্রদানকারী] সর্বোচ্চ উদ্বৃত্ততা । উভয় রেডিও + ইথারনেট।"

msgid "[CLIENT] Extender via 5 GHz. No cable."
msgstr "[গ্রাহক] 5 GHz দিয়ে এক্সটেন্ডার। কেবল নেই।"

msgid "[CLIENT] Extender via 2.4 GHz."
msgstr "[গ্রাহক] 2.4 GHz দিয়ে এক্সটেন্ডার।"

msgid "[CLIENT] Extender via both radios."
msgstr "[গ্রাহক] উভয় রেডিও দিয়ে এক্সটেন্ডার।"

msgid "[CLIENT] Cable only, no wireless mesh."
msgstr "[গ্রাহক] শুধু কেবল, কোনো বেতার মেশ নেই।"

msgid "[CLIENT] 5 GHz primary, Ethernet fallback."
msgstr "[গ্রাহক] 5 GHz প্রাথমিক, ইথারনেট ফলব্যাক।"

msgid "[CLIENT] 2.4 GHz primary, Ethernet fallback."
msgstr "[গ্রাহক] 2.4 GHz প্রাথমিক, ইথারনেট ফলব্যাক।"

msgid "[CLIENT] Both radios + Ethernet. Maximum redundancy."
msgstr "[গ্রাহক] উভয় রেডিও + ইথারনেট। সর্বোচ্চ রিডান্ডেন্সি।"

msgid "[NODE] Relay only, 5 GHz. No client SSID."
msgstr "[মধ্যবর্তী-সংযোগ] শুধু পুনর্প্রেরণ, 5 GHz। কোনো গ্রাহক SSID-বেতার নাম নেই।"

msgid "[NODE] Relay only, both radios."
msgstr "[মধ্যবর্তী-সংযোগ] শুধু পুনর্প্রেরণ, উভয় রেডিও।"

msgid "[NODE] Relay via cable only. No wireless."
msgstr "[মধ্যবর্তী-সংযোগ] শুধু কেবল দিয়ে পুনর্প্রেরণ। বেতার নেই।"

msgid "Removes Ethernet backhaul, restores port to bridge."
msgstr "ইথারনেট সংযোগ-ভিত্তি সরায়, পোর্ট ব্রিজে ফিরিয়ে দেয়।"

msgid "Turns off mesh. Radios stay enabled."
msgstr "মেশ বন্ধ করে। রেডিও চালু থাকে।"

