# =========================================================
msgid "Quick Setup"
msgstr "দ্রুত সেটআপ"

msgid "1. Server — 5 GHz wireless only"
msgstr "১. সার্ভার — শুধু 5 GHz বেতার"

msgid "2. Server — 2.4 GHz wireless only"
msgstr "২. সার্ভার — শুধু 2.4 GHz বেতার"

msgid "3. Server — Dual-band wireless only"
msgstr "৩. সার্ভার — শুধু দ্বি-ব্যান্ড বেতার"

msgid "4. Server — Wired backhaul only"
msgstr "৪. সার্ভার — শুধু তারযুক্ত ব্যাকহল"

msgid "5. Server — 5 GHz + Wired"
msgstr "৫. সার্ভার — 5 GHz + তারযুক্ত"

msgid "6. Server — 2.4 GHz + Wired"
msgstr "৬. সার্ভার — 2.4 GHz + তারযুক্ত"

msgid "7. Server — Dual-band + Wired"
msgstr "৭. সার্ভার — দ্বি-ব্যান্ড + তারযুক্ত"

msgid "8. Client — 5 GHz wireless only"
msgstr "৮. ক্লায়েন্ট — শুধু 5 GHz বেতার"

msgid "9. Client — 2.4 GHz wireless only"
msgstr "৯. ক্লায়েন্ট — শুধু 2.4 GHz বেতার"

msgid "10. Client — Dual-band wireless only"
msgstr "১০. ক্লায়েন্ট — শুধু দ্বি-ব্যান্ড বেতার"

msgid "11. Client — Wired backhaul only"
msgstr "১১. ক্লায়েন্ট — শুধু তারযুক্ত ব্যাকহল"

msgid "12. Client — 5 GHz + Wired fallback"
msgstr "১২. ক্লায়েন্ট — 5 GHz + তারযুক্ত ফলব্যাক"

msgid "13. Client — 2.4 GHz + Wired fallback"
msgstr "১৩. ক্লায়েন্ট — 2.4 GHz + তারযুক্ত ফলব্যাক"

msgid "14. Client — Dual-band + Wired fallback"
msgstr "১৪. ক্লায়েন্ট — দ্বি-ব্যান্ড + তারযুক্ত ফলব্যাক"

msgid "15. Node — 5 GHz relay"
msgstr "১৫. নোড — 5 GHz রিলে"

msgid "16. Node — Dual-band relay"
msgstr "১৬. নোড — দ্বি-ব্যান্ড রিলে"

msgid "17. Node — Wired relay only"
msgstr "১৭. নোড — শুধু তারযুক্ত রিলে"

msgid "18. Detach wired backhaul"
msgstr "১৮. তারযুক্ত ব্যাকহল বিচ্ছিন্ন করুন"

msgid "19. Disable mesh"
msgstr "১৯. মেশ বন্ধ করুন"

# Preset descriptions
msgid "[SERVER] Gateway. Extenders join via 5 GHz mesh only."
msgstr "[সার্ভার] গেটওয়ে। এক্সটেন্ডারগুলি শুধু 5 GHz মেশ দিয়ে যুক্ত হবে।"

msgid "[SERVER] Extenders join via 2.4 GHz (longer range)."
msgstr "[সার্ভার] এক্সটেন্ডারগুলি 2.4 GHz দিয়ে যুক্ত হবে (দীর্ঘ পরিসর)।"

msgid "[SERVER] Both radios carry backhaul."
msgstr "[সার্ভার] উভয় রেডিও ব্যাকহল বহন করবে।"

msgid "[SERVER] No wireless mesh — extenders connect by cable."
msgstr "[সার্ভার] কোনো বেতার মেশ নেই — এক্সটেন্ডারগুলি কেবল দিয়ে যুক্ত হবে।"

msgid "[SERVER] 5 GHz mesh primary, Ethernet parallel."
msgstr "[সার্ভার] 5 GHz মেশ প্রাথমিক, ইথারনেট সমান্তরাল।"

msgid "[SERVER] 2.4 GHz mesh plus Ethernet."
msgstr "[সার্ভার] 2.4 GHz মেশ এবং ইথারনেট।"

msgid "[SERVER] Maximum redundancy. Both radios + Ethernet."
msgstr "[সার্ভার] সর্বোচ্চ রিডান্ডেন্সি। উভয় রেডিও + ইথারনেট।"

msgid "[CLIENT] Extender via 5 GHz. No cable."
msgstr "[ক্লায়েন্ট] 5 GHz দিয়ে এক্সটেন্ডার। কেবল নেই।"

msgid "[CLIENT] Extender via 2.4 GHz."
msgstr "[ক্লায়েন্ট] 2.4 GHz দিয়ে এক্সটেন্ডার।"

msgid "[CLIENT] Extender via both radios."
msgstr "[ক্লায়েন্ট] উভয় রেডিও দিয়ে এক্সটেন্ডার।"

msgid "[CLIENT] Cable only, no wireless mesh."
msgstr "[ক্লায়েন্ট] শুধু কেবল, কোনো বেতার মেশ নেই।"

msgid "[CLIENT] 5 GHz primary, Ethernet fallback."
msgstr "[ক্লায়েন্ট] 5 GHz প্রাথমিক, ইথারনেট ফলব্যাক।"

msgid "[CLIENT] 2.4 GHz primary, Ethernet fallback."
msgstr "[ক্লায়েন্ট] 2.4 GHz প্রাথমিক, ইথারনেট ফলব্যাক।"

msgid "[CLIENT] Both radios + Ethernet. Maximum redundancy."
msgstr "[ক্লায়েন্ট] উভয় রেডিও + ইথারনেট। সর্বোচ্চ রিডান্ডেন্সি।"

msgid "[NODE] Relay only, 5 GHz. No client SSID."
msgstr "[নোড] শুধু রিলে, 5 GHz। কোনো ক্লায়েন্ট SSID নেই।"

msgid "[NODE] Relay only, both radios."
msgstr "[নোড] শুধু রিলে, উভয় রেডিও।"

msgid "[NODE] Relay via cable only. No wireless."
msgstr "[নোড] শুধু কেবল দিয়ে রিলে। বেতার নেই।"

msgid "Removes Ethernet backhaul, restores port to bridge."
msgstr "ইথারনেট ব্যাকহল সরায়, পোর্ট ব্রিজে ফিরিয়ে দেয়।"

msgid "Turns off mesh. Radios stay enabled."
msgstr "মেশ বন্ধ করে। রেডিও চালু থাকে।"

