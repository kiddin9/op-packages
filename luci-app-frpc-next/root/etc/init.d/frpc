#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/frpc
CONF_FILE=/etc/config/frpc.toml

is_enabled() {
	local enabled
	config_load frpc
	config_get_bool enabled "main" "enabled" 0
	[ "$enabled" -eq 1 ]
}

start_service() {
	is_enabled || return 0

	if [ ! -s "$CONF_FILE" ]; then
		logger -t frpc "Config file missing or empty: $CONF_FILE"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF_FILE"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	if ! is_enabled; then
		stop
		return 0
	fi

	if [ ! -s "$CONF_FILE" ]; then
		logger -t frpc "Config file missing or empty: $CONF_FILE"
		stop
		return 1
	fi

	restart
}

service_triggers() {
	procd_add_reload_trigger "frpc"
}
