msgstr "%d совпад. · сохранено %d/%d"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1429
msgid "%s · requested up to %d raw lines · %d firewall messages returned"
msgstr "%s · запрошено до %d сырых строк · возвращено %d сообщений firewall"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1419
msgid ""
"%s · requested up to %d raw lines · server limited fetch to %d · %d firewall "
"messages returned"
msgstr ""
"%s · запрошено до %d сырых строк · сервер ограничил выборку до %d · "
"возвращено %d сообщений firewall"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:502
msgid "%s: %s"
msgstr "%s: %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1637
msgid "0 matching · %d/%d stored"
msgstr "0 совпад. · сохранено %d/%d"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:453
msgid "Accessible (teal/orange)"
msgstr "Доступный (бирюзовый/оранжевый)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:362
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:37
msgid "Action"
msgstr "Действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:945
msgid "Administrator access is required to disable logging."
msgstr "Для отключения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:912
msgid "Administrator access is required to enable logging."
msgstr "Для включения журналирования требуются права администратора."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:214
msgid "Allow/deny rules, LAN logging, or anything else."
msgstr "Правила allow/deny, журналирование LAN и любые другие настройки."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1829
msgid "Also seen"
msgstr "Также встречаются"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:883
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:924
msgid "Another change is staged for the firewall; apply or revert it first."
msgstr ""
"В брандмауэре уже есть другое незафиксированное изменение; сначала примените "
"или отмените его."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:901
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:940
msgid ""
"Another change overwrote WAN logging after it was saved; check the current "
"state."
msgstr ""
"Другое изменение перезаписало журналирование WAN после сохранения; проверьте "
"текущее состояние."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2638
msgid "Any action"
msgstr "Любое действие"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1822
msgid "Any protocol"
msgstr "Любой протокол"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1410
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1470
msgid "Auto"
msgstr "Авто"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:204
msgid "Before you enable logging"
msgstr "Перед включением журналирования"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:880
msgid "Cannot enable logging until kernel log modules are installed."
msgstr ""
"Невозможно включить журналирование, пока не установлены модули журнала ядра."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:207
msgid "Changes:"
msgstr "Изменения:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:452
msgid "Classic (green/red)"
msgstr "Классический (зелёный/красный)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2369
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Классический — зелёный/красный; доступный — бирюзовый/оранжевый"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:157
msgid "Clear all"
msgstr "Очистить всё"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2710
msgid ""
"Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for "
"firewall settings · in Simple view, click a row for the full message"
msgstr ""
"Щёлкните ячейку для фильтра · ≠ на чипе для исключения · Ctrl+щелчок по "
"правилу для настроек МЭ · в Простом виде щёлкните строку для полного "
"сообщения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2437
msgid ""
"Click a row (Time or other non-link cells) to see the full log line (Simple "
"view)."
msgstr ""
"Щёлкните строку (Время или другие ячейки без ссылки), чтобы увидеть полную "
"строку журнала (Простой вид)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:158
msgid "Click a row for the full message"
msgstr "Щёлкните строку для полного сообщения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2442
msgid ""
"Click an IP, action, or protocol to filter; use the Protocol menu (or ≠ on a "
"chip) to exclude."
msgstr ""
"Щёлкните по IP, действию или протоколу для фильтрации; для исключения "
"используйте меню «Протокол» (или ≠ на чипе)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1823
msgid "Common"
msgstr "Частые"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1654
msgid "Connection lost — retrying…"
msgstr "Соединение потеряно — повторная попытка…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:888
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:929
msgid "Could not acquire the logging lock."
msgstr "Не удалось получить блокировку журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:896
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:935
msgid "Could not clear the WAN zone log option."
msgstr "Не удалось очистить параметр журнала зоны WAN."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:942
msgid "Could not disable logging."
msgstr "Не удалось отключить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:903
msgid "Could not enable logging."
msgstr "Не удалось включить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:814
msgid "Could not load logging status."
msgstr "Не удалось загрузить состояние журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:813
msgid "Could not refresh logging status; showing the last known state."
msgstr ""
"Не удалось обновить состояние журналирования; показан последний известный "
"статус."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:898
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:937
msgid "Could not save the firewall configuration."
msgstr "Не удалось сохранить конфигурацию межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:890
msgid "Could not snapshot the current logging state."
msgstr "Не удалось сохранить снимок текущего состояния журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:894
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:933
msgid "Could not write the WAN zone log option."
msgstr "Не удалось записать параметр журнала зоны WAN."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2665
msgid "Custom protocol (prefix ! to exclude). Overrides the menu when set."
msgstr "Свой протокол (! для исключения). Переопределяет меню, если задан."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:47
msgid "DPort"
msgstr "Порт назн."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1272
msgid "Degraded — sampling"
msgstr "Упрощённый режим — выборка"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1441
msgid "Degraded — sampling (slow poll RTT; cadence reduced)."
msgstr "Упрощённый режим — выборка (медленный RTT опроса; интервал увеличен)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:366
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:45
msgid "Destination"
msgstr "Назначение"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2695
msgid "Destination IP contains (! to exclude)"
msgstr "IP назначения содержит (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:368
msgid "Destination port"
msgstr "Порт назначения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2700
msgid "Destination port (! to exclude)"
msgstr "Порт назначения (! для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2553
msgid "Detail"
msgstr "Подробно"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:42
msgid "Dir"
msgstr "Напр."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:136
msgid "Disabling…"
msgstr "Отключение…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1268
msgid "Display limited to %d rows on this device"
msgstr "На этом устройстве отображение ограничено %d строками"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2310
msgid "Display options"
msgstr "Параметры отображения"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2402
msgid "Display options on the bar set Limit, row tint, palette, and hostnames."
msgstr ""
"Параметры отображения на панели задают лимит, окраску строк, палитру и имена "
"узлов."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:212
msgid "Does not change:"
msgstr "Не изменяет:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:229
msgid "Don’t show this again"
msgstr "Больше не показывать"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:60
msgid "Enable WAN drop/reject logging"
msgstr "Включить журналирование drop/reject для WAN"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:189
msgid "Enable WAN zone drop/reject logging (same as Network → Firewall)."
msgstr ""
"Включить журналирование drop/reject для WAN-зоны (как в Сеть → Межсетевой "
"экран)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:195
msgid "Enable logging"
msgstr "Включить журнал"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2398
msgid ""
"Enable logging turns on WAN zone drop/reject logging only (same as Network → "
"Firewall). It does not add rules or log normal LAN browsing."
msgstr ""
"«Включить журналирование» включает только журналирование drop/reject для WAN-"
"зоны (как в Сеть → Межсетевой экран). Оно не добавляет правил и не "
"журналирует обычный LAN-трафик."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:60
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:195
msgid "Enabling…"
msgstr "Включение…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1836
msgid "Exclude"
msgstr "Исключить"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:93
msgid "Exclude instead"
msgstr "Исключить вместо этого"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2324
msgid "Fetch budget"
msgstr "Бюджет выборки"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2406
msgid ""
"Fetch budget controls raw log lines per poll. Auto derives from Limit; "
"Manual selects a bounded maximum."
msgstr ""
"Бюджет выборки задаёт число сырых строк журнала за опрос. «Авто» выводится "
"из лимита; «Вручную» задаёт ограниченный максимум."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:63
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:96
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:161
msgid "Filter by %s"
msgstr "Фильтр по %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:134
msgid "Filter logs by rule (hint: %s). Ctrl+click to open firewall settings."
msgstr ""
"Фильтр журналов по правилу (подсказка: %s). Ctrl+клик открывает настройки "
"файрвола."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2480
#: openwrt-feed/luci-app-fwlive/root/usr/share/luci/menu.d/luci-app-fwlive.json:3
msgid "Firewall Live View"
msgstr "Просмотр файрвола в реальном времени"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:48
msgid "Flags"
msgstr "Флаги"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:50
msgid "Flow"
msgstr "Поток"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2416
msgid ""
"For a responsive table on a weak device, keep Limit at 250 rows or below. "
"The weak-device cap affects rendered rows; the buffer can still retain more."
msgstr ""
"Для отзывчивой таблицы на слабом устройстве установите Лимит не выше 250 "
"строк. Ограничение слабого устройства влияет на отображаемые строки; буфер "
"всё ещё может хранить больше."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:61
msgid "Forwarded"
msgstr "Транзитный"

#: openwrt-feed/luci-app-fwlive/root/usr/share/rpcd/acl.d/luci-app-fwlive.json:3
msgid "Grant access to firewall live log view"
msgstr "Предоставить доступ к живому просмотру журнала межсетевого экрана"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2389
msgid "Help"
msgstr "Справка"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1548
msgid "Hide rows"
msgstr "Скрыть строки"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1603
msgid ""
"High event rate — table refresh is throttled to protect the browser. The "
"buffer still updates; refresh will resume automatically."
msgstr ""
"Высокая частота событий — обновление таблицы ограничено для защиты браузера. "
"Буфер продолжает обновляться; отображение возобновится автоматически."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1448
msgid "Hostname resolve paused while the router is under load."
msgstr "Разрешение имён приостановлено из-за нагрузки на маршрутизатор."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1827
msgid "ICMPv6"
msgstr "ICMPv6"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:40
msgid "IN"
msgstr "ВХОД"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2453
msgid ""
"If Row tint looks missing, the active LuCI theme may omit success/error or "
"info/warn CSS variables; fwlive falls back to local colors (air-gapped, no "
"data leaves the device)."
msgstr ""
"Если цветовая маркировка строк отсутствует, активная тема LuCI может не "
"содержать CSS-переменные success/error или info/warn; fwlive использует "
"локальные цвета (работает автономно, данные не покидают устройство)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:331
msgid ""
"If the WAN is quiet, wait for probes or use the optional ping check in "
"Help / the enabling-logs guide."
msgstr ""
"Если WAN неактивен, дождитесь проб или используйте необязательную проверку "
"ping в Справке / руководстве по включению журналов."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:59
msgid "Inbound"
msgstr "Входящий"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:93
msgid "Include instead"
msgstr "Включить вместо этого"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:296
msgid ""
"Install kmod-nf-log and kmod-nf-log6 with the command for your OpenWrt "
"release, then reload the firewall."
msgstr ""
"Установите kmod-nf-log и kmod-nf-log6 командой для вашей версии OpenWrt, "
"затем перезагрузите файрвол."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1653
msgid "Installation is incomplete. Reinstall luci-app-fwlive."
msgstr "Установка не завершена. Переустановите luci-app-fwlive."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:363
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:39
msgid "Interface"
msgstr "Интерфейс"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2680
msgid "Interface (prefix ! to exclude)"
msgstr "Интерфейс (! в начале для исключения)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:250
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:368
msgid "I’ll configure this under Network → Firewall"
msgstr "Я настрою это в разделе Сеть → Межсетевой экран"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:292
msgid "Kernel log modules missing"
msgstr "Отсутствуют модули журналирования ядра"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:49
msgid "Len"
msgstr "Длина"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2313
msgid "Limit"
msgstr "Лимит"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:776
msgid "Live view may be incomplete — a legacy iptables table is registered"
msgstr ""
"Живой просмотр может быть неполным — зарегистрирована устаревшая таблица "
"iptables"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:339
msgid "Logging is off on this router"
