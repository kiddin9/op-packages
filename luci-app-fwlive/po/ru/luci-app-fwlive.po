msgstr "Не удалось отключить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:931
msgid "Could not enable logging."
msgstr "Не удалось включить журналирование."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:865
msgid "Could not load logging status."
msgstr "Не удалось загрузить состояние журналирования."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:764
msgid "Could not load rule names."
msgstr "Не удалось загрузить имена правил."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:758
msgid "Could not process firewall rule names."
msgstr "Не удалось обработать имена правил межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:760
msgid "Could not read the active firewall rules."
msgstr "Не удалось прочитать действующие правила межсетевого экрана."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:864
msgid "Could not refresh logging status; showing the last known state."
msgstr "Не удалось обновить состояние журналирования; показан последний известный статус."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:769
msgid "Could not refresh rule names."
msgstr "Не удалось обновить имена правил."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:767
msgid "Could not refresh rule names; previously loaded names are still shown."
msgstr "Не удалось обновить имена правил; отображаются ранее загруженные имена."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:74
