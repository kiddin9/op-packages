msgid "Could not process firewall rule names."
msgstr "无法处理防火墙规则名称。"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:761
msgid "Could not read the active firewall rules."
msgstr "无法读取当前生效的防火墙规则。"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:859
msgid "Could not refresh logging status; showing the last known state."
msgstr "无法刷新日志状态；显示上次已知状态。"

