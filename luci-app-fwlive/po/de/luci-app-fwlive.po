msgid "Action"
msgstr "Aktion"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:855
msgid "Administrator access is required to disable logging."
msgstr ""
"Zum Deaktivieren der Protokollierung sind Administratorrechte erforderlich."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:832
msgid "Administrator access is required to enable logging."
msgstr ""
"Zum Aktivieren der Protokollierung sind Administratorrechte erforderlich."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:208
msgid "Allow/deny rules, LAN logging, or anything else."
msgstr "Allow/Deny-Regeln, LAN-Protokollierung oder irgendetwas anderes."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1691
msgid "Also seen"
msgstr "Weitere"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:812
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:843
msgid "Another change is staged for the firewall; apply or revert it first."
msgstr ""
"Eine andere Änderung an der Firewall ist vorgemerkt; zuerst anwenden oder "
"verwerfen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2490
msgid "Any action"
msgstr "Beliebige Aktion"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1684
msgid "Any protocol"
msgstr "Beliebiges Protokoll"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1274
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1334
msgid "Auto"
msgstr "Auto"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:198
msgid "Before you enable logging"
msgstr "Bevor Sie die Protokollierung aktivieren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:810
msgid "Cannot enable logging until kernel log modules are installed."
msgstr ""
"Protokollierung kann erst aktiviert werden, wenn die Kernel-Log-Module "
"installiert sind."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:201
msgid "Changes:"
msgstr "Änderungen:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:431
msgid "Classic (green/red)"
msgstr "Klassisch (grün/rot)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2221
msgid "Classic uses green/red; Accessible uses teal/orange"
msgstr "Klassisch verwendet grün/rot; Barrierefrei verwendet teal/orange"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:150
msgid "Clear all"
msgstr "Alle löschen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2561
msgid ""
"Click a cell to filter · ≠ on a chip to exclude · Ctrl+click a rule for "
"firewall settings · in Simple view, click a row for the full message"
msgstr ""
"Zelle anklicken zum Filtern · ≠ auf einem Chip zum Ausschließen · Strg+Klick "
"auf eine Regel für Firewall-Einstellungen · in der Einfachen Ansicht Zeile "
"anklicken für die vollständige Meldung"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2288
msgid ""
"Click a row (Time or other non-link cells) to see the full log line (Simple "
"view)."
msgstr ""
"Klicken Sie auf eine Zeile (Zeit oder andere Nicht-Link-Zellen), um die "
"vollständige Log-Zeile zu sehen (Einfache Ansicht)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:156
msgid "Click a row for the full message"
msgstr "Zeile anklicken für die vollständige Meldung"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2293
msgid ""
"Click an IP, action, or protocol to filter; use the Protocol menu (or ≠ on a "
"chip) to exclude."
msgstr ""
"Klicken Sie auf eine IP, Aktion oder ein Protokoll, um zu filtern; nutzen "
"Sie das Protokoll-Menü (oder ≠ auf einem Chip) zum Ausschließen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1685
msgid "Common"
msgstr "Häufig"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1516
msgid "Connection lost — retrying…"
msgstr "Verbindung verloren — neuer Versuch…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:818
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:849
msgid "Could not acquire the logging lock."
msgstr "Die Protokollierungssperre konnte nicht erworben werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:852
msgid "Could not disable logging."
msgstr "Protokollierung konnte nicht deaktiviert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:823
msgid "Could not enable logging."
msgstr "Protokollierung konnte nicht aktiviert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:753
msgid "Could not load logging status."
msgstr "Protokollstatus konnte nicht geladen werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:752
msgid "Could not refresh logging status; showing the last known state."
msgstr "Protokollstatus konnte nicht aktualisiert werden; zeige den zuletzt bekannten Zustand."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:820
msgid "Could not snapshot the current logging state."
msgstr "Der aktuelle Protokollierungszustand konnte nicht gesichert werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2516
msgid "Custom protocol (prefix ! to exclude). Overrides the menu when set."
msgstr ""
"Eigenes Protokoll (! zum Ausschließen). Überschreibt das Menü, wenn gesetzt."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:45
msgid "DPort"
msgstr "Ziel-Port"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1135
msgid "Degraded — sampling"
msgstr "Eingeschränkt — Stichproben"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1305
msgid "Degraded — sampling (slow poll RTT; cadence reduced)."
msgstr ""
"Eingeschränkt — Stichproben (langsame Poll-Roundtrip-Zeit; Frequenz "
"reduziert)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:346
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:43
msgid "Destination"
msgstr "Ziel"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2547
msgid "Destination IP contains (! to exclude)"
msgstr "Ziel-IP enthält (! zum Ausschließen)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:348
msgid "Destination port"
msgstr "Ziel-Port"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2552
msgid "Destination port (! to exclude)"
msgstr "Ziel-Port (! zum Ausschließen)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2405
msgid "Detail"
msgstr "Detail"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:40
msgid "Dir"
msgstr "Richtung"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:130
msgid "Disabling…"
msgstr "Wird deaktiviert…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1131
msgid "Display limited to %d rows on this device"
msgstr "Anzeige auf %d Zeilen auf diesem Gerät begrenzt"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2162
msgid "Display options"
msgstr "Anzeigeoptionen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2254
msgid "Display options on the bar set Limit, row tint, palette, and hostnames."
msgstr ""
"Anzeigeoptionen in der Leiste setzen Limit, Zeilenfärbung, Palette und "
"Hostnamen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:206
msgid "Does not change:"
msgstr "Ändert nicht:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:223
msgid "Don’t show this again"
msgstr "Nicht mehr anzeigen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:60
msgid "Enable WAN drop/reject logging"
msgstr "WAN-Drop/Reject-Protokollierung aktivieren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:183
msgid "Enable WAN zone drop/reject logging (same as Network → Firewall)."
msgstr ""
"Drop/Reject-Protokollierung der WAN-Zone aktivieren (wie unter Netzwerk → "
"Firewall)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:189
msgid "Enable logging"
msgstr "Protokollierung aktivieren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2249
msgid ""
"Enable logging turns on WAN zone drop/reject logging only (same as Network → "
"Firewall). It does not add rules or log normal LAN browsing."
msgstr ""
"„Protokollierung aktivieren“ schaltet nur die Drop/Reject-Protokollierung "
"der WAN-Zone ein (wie unter Netzwerk → Firewall). Es fügt keine Regeln hinzu "
"und protokolliert keinen normalen LAN-Verkehr."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:60
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:189
msgid "Enabling…"
msgstr "Wird aktiviert…"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1698
msgid "Exclude"
msgstr "Ausschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:86
msgid "Exclude instead"
msgstr "Stattdessen ausschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2176
msgid "Fetch budget"
msgstr "Abrufbudget"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2257
msgid ""
"Fetch budget controls raw log lines per poll. Auto derives from Limit; "
"Manual selects a bounded maximum."
msgstr ""
"Das Abrufbudget steuert die Rohzeilen pro Abfrage. Auto leitet es aus dem "
"Limit ab; Manuell wählt ein begrenztes Maximum."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:63
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:91
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:156
msgid "Filter by %s"
msgstr "Filtern nach %s"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:128
msgid "Filter logs by rule (hint: %s). Ctrl+click to open firewall settings."
msgstr ""
"Logs nach Regel filtern (Hinweis: %s). Strg+Klick öffnet die Firewall-"
"Einstellungen."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2332
#: openwrt-feed/luci-app-fwlive/root/usr/share/luci/menu.d/luci-app-fwlive.json:3
msgid "Firewall Live View"
msgstr "Firewall-Live-Ansicht"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:46
msgid "Flags"
msgstr "Flags"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:48
msgid "Flow"
msgstr "Fluss"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2267
msgid ""
"For a responsive table on a weak device, keep Limit at 250 rows or below. "
"The weak-device cap affects rendered rows; the buffer can still retain more."
msgstr ""
"Für eine responsive Tabelle auf einem schwachen Gerät sollte Limit auf "
"höchstens 250 Zeilen stehen. Die Schwachgerätebegrenzung betrifft die "
"angezeigten Zeilen; der Puffer kann weiterhin mehr Zeilen behalten."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:59
msgid "Forwarded"
msgstr "Weitergeleitet"

#: openwrt-feed/luci-app-fwlive/root/usr/share/rpcd/acl.d/luci-app-fwlive.json:3
msgid "Grant access to firewall live log view"
msgstr "Zugriff auf die Live-Ansicht der Firewall-Protokolle gewähren"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2241
msgid "Help"
msgstr "Hilfe"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1412
msgid "Hide rows"
msgstr "Zeilen ausblenden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1467
msgid ""
"High event rate — table refresh is throttled to protect the browser. The "
"buffer still updates; refresh will resume automatically."
msgstr ""
"Hohe Ereignisrate — die Tabellenaktualisierung wird gedrosselt, um den "
"Browser zu schonen. Der Puffer wird weiter aktualisiert; die Anzeige wird "
"automatisch fortgesetzt."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1312
msgid "Hostname resolve paused while the router is under load."
msgstr "Hostnamenauflösung pausiert, solange der Router ausgelastet ist."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1689
msgid "ICMPv6"
msgstr "ICMPv6"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:38
msgid "IN"
msgstr "EINGANG"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2304
msgid ""
"If Row tint looks missing, the active LuCI theme may omit success/error or "
"info/warn CSS variables; fwlive falls back to local colors (air-gapped, no "
"data leaves the device)."
msgstr ""
"Wenn die Zeileneinfärbung fehlt, verwendet das aktive LuCI-Theme "
"möglicherweise keine Erfolgs/Fehler-CSS-Variablen; fwlive fällt auf lokale "
"Farben zurück (air-gapped, keine Daten verlassen das Gerät)."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:323
msgid ""
"If the WAN is quiet, wait for probes or use the optional ping check in "
"Help / the enabling-logs guide."
msgstr ""
"Wenn das WAN ruhig ist, warten Sie auf Probes oder nutzen Sie den optionalen "
"Ping-Test in der Hilfe / der Anleitung zum Aktivieren der Protokollierung."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:57
msgid "Inbound"
msgstr "Eingehend"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/chips.js:86
msgid "Include instead"
msgstr "Stattdessen einschließen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/log.js:343
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:37
msgid "Interface"
msgstr "Schnittstelle"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2532
msgid "Interface (prefix ! to exclude)"
msgstr "Schnittstelle (! voranstellen zum Ausschließen)"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:244
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:361
msgid "I’ll configure this under Network → Firewall"
msgstr "Ich konfiguriere das unter Netzwerk → Firewall"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:286
msgid "Kernel log modules missing"
msgstr "Kernel-Logmodule fehlen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:289
msgid ""
"Kernel netfilter log modules are missing. Install kmod-nf-log-ipv4 and kmod-"
"nf-log-ipv6 (or kmod-nf-log / kmod-nf-log6), then reload the firewall."
msgstr ""
"Kernel-Netfilter-Log-Module fehlen. Installieren Sie kmod-nf-log-ipv4 und "
"kmod-nf-log-ipv6 (oder kmod-nf-log / kmod-nf-log6) und laden Sie dann die "
"Firewall neu."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:47
msgid "Len"
msgstr "Länge"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2165
msgid "Limit"
msgstr "Limit"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:721
msgid "Limited diagnostics — timeout command missing"
msgstr "Eingeschränkte Diagnose — timeout-Befehl fehlt"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:726
msgid "Live view may be incomplete — a legacy iptables table is registered"
msgstr "Die Live-Ansicht kann unvollständig sein — eine veraltete iptables-Tabelle ist registriert"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:332
msgid "Logging is off on this router"
msgstr "Protokollierung ist auf diesem Router deaktiviert"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1274
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:1335
msgid "Manual"
msgstr "Manuell"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2194
msgid "Manual still uses server protection and poll cadence"
msgstr "Manuell nutzt weiterhin Serverschutz und Abfrageintervall"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2262
msgid ""
"Manual still uses server protection and poll cadence; it changes the fetch "
"budget, not the polling interval."
msgstr ""
"Manuell nutzt weiterhin Serverschutz und Abfrageintervall; es ändert das "
"Abrufbudget, nicht das Abfrageintervall."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:380
msgid "Manual test (System → Terminal):"
msgstr "Manueller Test (System → Terminal):"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2188
msgid "Maximum raw lines"
msgstr "Maximale Rohzeilen"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:49
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:330
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2417
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2424
msgid "Message"
msgstr "Nachricht"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:2527
msgid "More filters"
msgstr "Weitere Filter"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/links.js:45
msgid "Network → Firewall"
msgstr "Netzwerk → Firewall"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:277
msgid ""
"No WAN firewall zone found in /etc/config/firewall. Configure zones under:"
msgstr ""
"Keine WAN-Firewallzone in /etc/config/firewall gefunden. Zonen konfigurieren "
"unter:"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:272
msgid "No WAN zone found"
msgstr "Keine WAN-Zone gefunden"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:816
#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/view/status/fwlive.js:847
msgid "No WAN zone found; cannot toggle logging without one."
msgstr ""
"Keine WAN-Zone gefunden; Protokollierung kann ohne eine solche nicht "
"umgeschaltet werden."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:241
msgid "Not now"
msgstr "Nicht jetzt"

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/logging.js:355
msgid "Nothing changes until you click Enable."
msgstr "Nichts ändert sich, bis Sie auf Aktivieren klicken."

#: openwrt-feed/luci-app-fwlive/htdocs/luci-static/resources/fwlive/table.js:39
