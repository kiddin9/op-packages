config clouddrive2 'main'
	option enabled '0'
	option port '19798'
	option https_enabled '0'
	option https_port '19799'
	option open_firewall '0'
	option config_dir '/etc/clouddrive2'
	option mount_point '/mnt/clouddrive'
	option cache_dir '/tmp/clouddrive2'
	option shared_mount '1'
	option allow_other '1'
	option startup_delay '0'
	option max_open_files '65535'
	option enable_run_after_start '0'
	option log_stdout '1'
	option log_stderr '1'
