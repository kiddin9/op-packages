#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2024-2026 OpenWrt.org

START=99
STOP=15
USE_PROCD=1

PROG=/usr/share/clouddrive2/clouddrive
PROG_DIR=/usr/share/clouddrive2

validate_clouddrive2_section() {
	uci_validate_section clouddrive2 clouddrive2 "${1:-main}" \
		'enabled:bool:0' \
		'port:port:19798' \
		'open_firewall:bool:0' \
		'config_dir:string:/etc/clouddrive2' \
		'mount_point:string:/mnt/clouddrive' \
		'cache_dir:string:/tmp/clouddrive2'
}

kill_lingering_processes() {
	local pids n=0
	pids="$(pgrep -f "^${PROG}" 2>/dev/null)"
	[ -n "$pids" ] || return 0

	kill -TERM $pids 2>/dev/null || true
	while [ "$n" -lt 3 ]; do
		sleep 1
		pids="$(pgrep -f "^${PROG}" 2>/dev/null)"
		[ -z "$pids" ] && return 0
		n=$((n + 1))
	done

	kill -KILL $pids 2>/dev/null || true
}

cleanup_orphan_workers() {
	local pid cmdline ppid_arg
	for pid in $(pgrep -f "^${PROG} Start-Service" 2>/dev/null); do
		[ -r "/proc/$pid/cmdline" ] || continue
		cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
		ppid_arg="$(printf '%s' "$cmdline" | awk '{print $3}')"
		if [ -z "$ppid_arg" ] || [ ! -d "/proc/$ppid_arg" ]; then
			kill -KILL "$pid" 2>/dev/null || true
		fi
	done
}

cleanup_mounts() {
	local mp_base="$1"
	[ -n "$mp_base" ] || return 0
	mp_base="${mp_base%/}"
	[ -n "$mp_base" ] || return 0

	awk -v base="$mp_base" '
		$3 ~ /^fuse/ {
			mp = $2
			gsub(/\\040/, " ", mp)
			if (mp == base || index(mp, base "/") == 1)
				print length(mp), mp
		}
	' /proc/mounts 2>/dev/null | sort -rn | cut -d' ' -f2- | while IFS= read -r target; do
		[ -n "$target" ] || continue
		fusermount3 -u "$target" 2>/dev/null || \
			fusermount3 -uz "$target" 2>/dev/null || \
			umount -l "$target" 2>/dev/null || true
	done
}

prepare_fuse() {
	local mp="$1"
	local mp_root

	[ -c /dev/fuse ] || modprobe fuse 2>/dev/null || true

	if [ -f /etc/fuse.conf ]; then
		if grep -q '^[[:space:]]*#[[:space:]]*user_allow_other' /etc/fuse.conf; then
			sed -i 's/^[[:space:]]*#[[:space:]]*user_allow_other/user_allow_other/' /etc/fuse.conf
		elif ! grep -q '^[[:space:]]*user_allow_other' /etc/fuse.conf; then
			echo "user_allow_other" >> /etc/fuse.conf
		fi
	else
		echo "user_allow_other" > /etc/fuse.conf
	fi

	mkdir -p "$mp"
	mp_root="$(df -P "$mp" 2>/dev/null | awk 'NR==2 {print $6}')"
	[ -n "$mp_root" ] && mount --make-shared "$mp_root" 2>/dev/null || true
}

sync_runtime_files() {
	local cfg_dir="${1%/}"
	local tmp_dir="${2%/}"
	local http_port="$3"
	local settings_file="${cfg_dir}/systemsettings.json"
	local toml_file="${cfg_dir}/config.toml"
	local default_temp="${cfg_dir}/temp"

	mkdir -p "$cfg_dir" "${cfg_dir}/log" "$tmp_dir"

	if [ "$tmp_dir" = "$default_temp" ]; then
		[ -L "$default_temp" ] && rm -f "$default_temp"
		mkdir -p "$default_temp"
	else
		[ -d "$default_temp" ] && [ ! -L "$default_temp" ] && rmdir "$default_temp" 2>/dev/null || true
		if [ -L "$default_temp" ] || [ ! -e "$default_temp" ]; then
			ln -sfn "$tmp_dir" "$default_temp"
		fi
	fi

	# Only patch systemsettings.json if CloudDrive2 has already generated a full valid file
	if [ -f "$settings_file" ]; then
		if ! grep -q '"dir_cache_ttl_secs"' "$settings_file" 2>/dev/null; then
			logger -t clouddrive2 -p daemon.warn "Removing incomplete $settings_file so CloudDrive2 can initialize defaults"
			rm -f "$settings_file"
		elif command -v ucode >/dev/null 2>&1; then
			SETTINGS_FILE="$settings_file" \
			CD2_TEMP_DIR="$tmp_dir" \
			ucode -e '
				import { readfile, writefile, rename, unlink } from "fs";
				let path = getenv("SETTINGS_FILE");
				let raw = readfile(path);
				if (!raw || length(trim(raw)) == 0) exit(0);
				let data = null;
				try { data = json(raw); } catch (e) { exit(0); }
				if (type(data) != "object" || data.dir_cache_ttl_secs == null) exit(0);
				let td = getenv("CD2_TEMP_DIR");
				if (td && data.temp_dir != td) {
					data.temp_dir = td;
					let tmp = path + ".tmp";
					if (writefile(tmp, sprintf("%.2J\n", data)))
						rename(tmp, path);
					else
						unlink(tmp);
				}
			' 2>/dev/null || true
		fi
	fi

	if [ -f "$toml_file" ] && [ -n "$http_port" ]; then
		sed -i -E \
			-e "s/^([[:space:]]*(http_port|port)[[:space:]]*=[[:space:]]*)[0-9]+/\1${http_port}/" \
			"$toml_file" 2>/dev/null || true
	fi
}

start_service() {
	local enabled port open_firewall config_dir mount_point cache_dir

	config_load 'clouddrive2'
	validate_clouddrive2_section main || {
		logger -t clouddrive2 -p daemon.err "Configuration validation failed"
		return 1
	}

	cleanup_orphan_workers

	[ "$enabled" -eq 1 ] || return 0

	if [ ! -x "$PROG" ]; then
		logger -t clouddrive2 -p daemon.err "Binary not found or not executable: $PROG"
		return 1
	fi

	prepare_fuse "$mount_point"
	sync_runtime_files "$config_dir" "$cache_dir" "$port"

	local zonename
	zonename="$(uci -q get system.@system[0].zonename)"
	[ -n "$zonename" ] || zonename="Asia/Shanghai"

	procd_open_instance "clouddrive2"
	procd_set_param command /bin/sh -c 'cd "$1" && shift && exec "$@"' _ "$PROG_DIR" "$PROG"
	procd_set_param env \
		HOME="/root" \
		CLOUDDRIVE_HOME="$config_dir" \
		TMPDIR="$cache_dir" \
		TZ="$zonename" \
		ENABLE_RUN_AFTER_START="true"

	procd_set_param limits nofile="65535 65535" core="0 0"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "/var/run/clouddrive2.pid"

	if [ "$open_firewall" -eq 1 ]; then
		procd_open_data
		json_add_array firewall
			json_add_object ""
			json_add_string type rule
			json_add_string name "Allow-CloudDrive2-HTTP"
			json_add_string src "*"
			json_add_string dest_port "$port"
			json_add_string proto tcp
			json_add_string target ACCEPT
			json_close_object
		json_close_array
		procd_close_data
	fi

	procd_close_instance
}

reload_service() {
	stop
	start
}

service_started() {
	procd_set_config_changed firewall
}

service_stopped() {
	local mount_point
	config_load 'clouddrive2'
	config_get mount_point main mount_point '/mnt/clouddrive'

	kill_lingering_processes
	cleanup_mounts "$mount_point"
	procd_set_config_changed firewall
}

service_triggers() {
	procd_add_reload_trigger "clouddrive2"
}
