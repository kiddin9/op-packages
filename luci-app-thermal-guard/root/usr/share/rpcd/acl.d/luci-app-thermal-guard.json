{
	"luci-app-thermal-guard": {
		"description": "Read the thermal-guard status, edit its configuration, clear stages and record firmware trips",
		"read": {
			"file": {
				"/var/run/thermal-guard.status": [ "read" ],
				"/tmp/run/thermal-guard.status": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ]
			},
			"uci": [ "thermal-guard" ]
		},
		"write": {
			"file": {
				"/usr/sbin/thermal-guard reset": [ "exec" ],
				"/usr/sbin/thermal-guard trips-keep": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "thermal-guard" ]
		}
	}
}
