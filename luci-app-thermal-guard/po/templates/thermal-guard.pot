msgstr ""

msgid "Modem allowance"
msgstr ""

msgid "Degrees the modem may run above the processor before the switching temperatures are lowered."
msgstr ""

msgid "Base values in degrees at which the kernel moves the fan one step up, lowest first, one value per step. Empty uses the values of the installed firmware: %s °C."
msgstr ""

msgid "Base values in degrees at which the kernel moves the fan one step up, lowest first, one value per step. Empty uses the values of the installed firmware."
msgstr ""

