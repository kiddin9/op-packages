'use strict';
import * as rtnl from 'rtnl';
import { access } from 'fs';
import { read_names, save_name } from '../../ucode/rmm-dashboard/names.uc';

const names_file='/etc/rmm-dashboard/client-names.json';

import { vendors_for, traffic_snapshot } from '../../ucode/rmm-dashboard/insights.uc';

import { inventory } from '../../ucode/rmm-dashboard/clients.uc';

function dump(command, family) {
    let rows = rtnl.request(command, rtnl.const.NLM_F_DUMP, { family });
    if (type(rows) != 'array') die(rtnl.error() ?? 'Kernel table unavailable');
    return rows;
}

return {
    'rmm.dashboard': {
        vendors: {
            args: {macs:[]},
            call: function(request) {
                if(type(request.args.macs)!='array' || length(request.args.macs)>512)return {error:'Invalid MAC list'};
                return vendors_for(request.args.macs,'/usr/share/rmm-dashboard/vendors.tsv');
            }
        },
        set_name: {
            args: {mac:'',name:'',previous:''},
            call: function(request) {
                try { return {names:save_name(names_file,request.args.mac,request.args.name,request.args.previous)}; }
                catch (err) { return {error:''+err}; }
            }
        },
        clients: {
            call: function() {
                try {
                    let links = dump(rtnl.const.RTM_GETLINK, rtnl.const.AF_UNSPEC), wireless = {};
                    for (let link in links) {
                        // Names come only from the kernel; never accept paths or commands from RPC arguments.
                        if (type(link.dev) == 'string' && !match(link.dev, /[\/]/))
                            wireless[link.dev] = access(`/sys/class/net/${link.dev}/phy80211`) || access(`/sys/class/net/${link.dev}/wireless`);
                    }
                    let result=inventory(links, dump(rtnl.const.RTM_GETNEIGH, rtnl.const.AF_BRIDGE),
                        [ ...dump(rtnl.const.RTM_GETNEIGH, rtnl.const.AF_INET), ...dump(rtnl.const.RTM_GETNEIGH, rtnl.const.AF_INET6) ], wireless);
                    try { result.names=read_names(names_file); }
                    catch (err) { result.names_error=''+err; }
                    let macs=map([...result.fdb,...result.neighbors],row=>row.mac);
                    let vendors=vendors_for(macs,'/usr/share/rmm-dashboard/vendors.tsv');
                    for(let key,value in vendors)result[key]=value;
                    result.traffic=traffic_snapshot();
                    return result;
                }
                catch (err) { return { error: '' + err }; }
            }
        }
    }
};
