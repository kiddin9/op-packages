
config gitbackup 'main'
	option enabled          '0'
	option archive          '1'
	option schedule         'daily'
	option cron_expr        ''
	option on_config_change '1'
	option debounce         '60'
	option device_id        'hostname'
	option device           ''
	option path_prefix      'devices/{device}'

config remote 'origin'
	option url              ''
	option branch           'device/{device}'
	option auth             'sshkey'
	option key_file         '/etc/gitbackup/id_ed25519'
	option token_file       '/etc/gitbackup/token'
	option ca_file          ''
	option provider         'auto'
	option visibility       'private'
	option acknowledged     '0'

config security 'security'
	option scrub            '0'
	list   scrub_option     'wireless.@wifi-iface[*].key'
