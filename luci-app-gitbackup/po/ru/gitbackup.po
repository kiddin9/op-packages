#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:843
msgid "Add the key to the server"
msgstr "Добавить ключ на сервер"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:273
msgid "Also covered automatically"
msgstr "Уже покрыто автоматически"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:581
msgid "Also write a backup.tar.gz next to the working tree on every run, for a quick local copy in addition to the git history."
msgstr "Также писать backup.tar.gz рядом с рабочим деревом при каждом запуске — для быстрой локальной копии в дополнение к истории git."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:937
msgid "Anyone with the URL will be able to read every backup ever pushed."
msgstr "Любой, у кого есть эта ссылка, сможет прочитать все когда-либо отправленные резервные копии."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:295
msgid "Audit: changed on this router, but not backed up"
msgstr "Аудит: изменено на этом роутере, но не сохранено в резервной копии"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:712
msgid "Authentication"
msgstr "Аутентификация"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:719
msgid "Auto-detect"
msgstr "Определять автоматически"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:600
