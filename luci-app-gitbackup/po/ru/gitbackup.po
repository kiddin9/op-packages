#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:983
msgid "Security"
msgstr "Безопасность"

#: applications/luci-app-gitbackup/root/usr/share/luci/menu.d/luci-app-gitbackup.json:23
msgid "Settings"
msgstr "Настройки"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:230
msgid "Skipped: another run was already in progress."
msgstr "Пропущено: уже выполняется другой запуск."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:244
msgid "Skipped: could not verify whether the repository is public."
msgstr "Пропущено: не удалось проверить, является ли репозиторий публичным."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:237
msgid "Skipped: the remote was unreachable."
msgstr "Пропущено: удалённый репозиторий недоступен."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:621
msgid "Status"
msgstr "Статус"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:586
msgid "System hostname"
msgstr "Имя хоста системы"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:683
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:743
msgid "Test connection"
msgstr "Проверить соединение"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:956
msgid "Testing the connection…"
msgstr "Проверка соединения…"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:1118
msgid "Testing…"
msgstr "Проверка…"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:442
msgid "The SSH host key has not been confirmed yet -- see its fingerprint below and accept it once to continue."
msgstr "SSH host key ещё не подтверждён — отпечаток показан ниже, примите его один раз, чтобы продолжить."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:432
msgid "The SSH host key was not accepted."
msgstr "SSH host key не был принят."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:457
msgid "The configuration has changed since the last commit."
msgstr "Конфигурация изменилась с момента последнего коммита."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:462
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:1028
msgid "The configuration matches the last commit."
msgstr "Конфигурация совпадает с последним коммитом."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:396
msgid "The cron service (crond) does not appear to be running -- scheduled backups will not happen until it does. Run \"/etc/init.d/cron start\" or check the System > Startup page."
msgstr "Служба cron (crond), похоже, не запущена — резервное копирование по расписанию не будет выполняться, пока это не исправлено. Выполните «/etc/init.d/cron start» или проверьте страницу «Система → Автозагрузка»."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:661
msgid "The following ends up in the repository in plain text -- there is no encryption in this tool:"
msgstr "Ниже перечислено то, что попадает в репозиторий в открытом виде — в этом инструменте нет шифрования:"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:618
msgid "The hourly/daily/weekly presets deliberately do not all fire at the same wall-clock time: the minute (and, for daily/weekly, the hour) is derived from this device's own identifier, so a whole fleet of routers on the same preset does not wake up in the same second and hit the provider's API all at once."
msgstr "Пресеты «ежечасно/ежедневно/еженедельно» намеренно не срабатывают у всех в одно и то же время: минута (а для ежедневного/еженедельного — ещё и час) вычисляется из собственного идентификатора устройства, поэтому весь парк роутеров на одном пресете не просыпается в одну секунду и не обращается к API провайдера одновременно."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:927
msgid "The remote is expected to be private. Before every push, this is checked anonymously against the provider’s API (no token needed for the check itself) -- if the repository turns out to be publicly visible, the push is refused outright and a red banner appears on the Overview tab. Config scrubbing stays off unless something else requires it."
msgstr "Предполагается, что удалённый репозиторий приватный. Перед каждым push это анонимно проверяется через API провайдера (токен для самой проверки не нужен) — если репозиторий оказывается публично видимым, push отклоняется сразу же, а на вкладке «Обзор» появляется красный баннер. Очистка конфигурации остаётся выключенной, если её не требует что-то ещё."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:1222
msgid "The remote presented this SSH host key fingerprint. Verify it out of band if you can, then accept it once to continue -- this only has to be done the first time."
msgstr "Удалённый репозиторий предъявил этот отпечаток SSH host key. По возможности сверьте его отдельным способом, затем примите один раз, чтобы продолжить — это нужно сделать только один раз."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:429
msgid "The remote was reached, but authentication failed -- check the deploy key or the token."
msgstr "Удалённый репозиторий доступен, но аутентификация не удалась — проверьте deploy-ключ или токен."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:371
msgid "The repository URL is not configured -- nothing was restored."
msgstr "URL репозитория не задан — ничего не восстановлено."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:359
msgid "The selected backup could not be found on the remote -- nothing was restored."
msgstr "Выбранный бэкап не найден в удалённом репозитории — ничего не восстановлено."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:275
msgid "These are not part of the list above -- sysupgrade already backs them up on its own (package config changes, or /lib/upgrade/keep.d), whether or not anything is added here. Read-only."
msgstr "Это не часть списка выше — sysupgrade и так сохраняет их сам (изменения конфигураций пакетов либо /lib/upgrade/keep.d) независимо от того, добавлено здесь что-то или нет. Только для чтения."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:364
msgid "These paths also survive a firmware upgrade: they are written straight into /etc/sysupgrade.conf, the same file the router's own sysupgrade reads, not a separate list of this tool's own. A directory you add here stays a directory -- anything added to it later is covered too, exactly like a real sysupgrade would."
msgstr "Эти пути также переживают обновление прошивки: они записываются прямо в /etc/sysupgrade.conf — тот же файл, который читает штатный sysupgrade роутера, а не отдельный список этого инструмента. Добавленный сюда каталог остаётся каталогом — всё, что позже появится в нём, тоже будет покрыто, точно как при настоящем sysupgrade."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:623
msgid "This backup was taken on a different router model than the one it would be restored onto. Interface names and wireless radios from that hardware will not match this one -- restoring anyway may leave the network unreachable until the configuration is fixed by hand."
msgstr "Эта резервная копия была сделана на другой модели роутера, чем та, на которую её собираются восстановить. Имена интерфейсов и радиомодули того устройства не совпадут с этим — восстановление всё равно может оставить сеть недоступной, пока конфигурация не будет исправлена вручную."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:356
msgid "This device has no backup on that branch yet -- nothing was restored."
msgstr "У этого устройства пока нет бэкапа в этой ветке — ничего не восстановлено."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:413
msgid "This device has not completed a run yet."
msgstr "Это устройство ещё не завершило ни одного запуска."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:264
msgid "This is over 2 MB. A real \"sysupgrade -b\" builds this archive entirely in RAM, and past this size it can fail on a low-memory device. This is only a warning -- nothing here is blocked, trim the list above if that matters on this device."
msgstr "Это больше 2 МБ. Настоящий «sysupgrade -b» собирает такой архив целиком в оперативной памяти, и после этого размера он может не выполниться на устройстве с малым объёмом памяти. Это только предупреждение — ничего здесь не блокируется, при необходимости сократите список выше."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:959
msgid "This provider cannot be checked automatically -- tick the box above to confirm the repository is private before saving."
msgstr "Этого провайдера нельзя проверить автоматически — перед сохранением отметьте флажок выше, подтверждающий, что репозиторий приватный."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:868
msgid "This provider has no API to link to a settings page. On %s, append the public key above to the \"git\" user’s ~/.ssh/authorized_keys, ideally prefixed with restrict,command=\"git-shell\" so the key can only run git operations, e.g.:"
msgstr "У этого провайдера нет API, чтобы дать ссылку на страницу настроек. На %s допишите открытый ключ выше в ~/.ssh/authorized_keys пользователя «git», желательно с префиксом restrict,command=\"git-shell\", чтобы ключ мог выполнять только git-операции, например:"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:965
msgid "This provider’s visibility cannot be checked automatically (spec: \"generic — проверить нельзя ни при каких условиях\"). If this repository is actually public, everything below is exposed in plain text to anyone who can read it:"
msgstr "Видимость этого провайдера нельзя проверить автоматически (спецификация: «generic — проверить нельзя ни при каких условиях»). Если этот репозиторий на самом деле публичный, всё перечисленное ниже открыто в виде обычного текста для любого, кто может его прочитать:"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:906
msgid "Token file path"
msgstr "Путь к файлу токена"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/paths.js:255
msgid "Total size of the backup set: %d KB"
msgstr "Общий размер набора резервного копирования: %d КБ"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:578
msgid "Turns the whole package on or off -- scheduled runs, the config-change trigger and manual \"Backup now\" all stay inert while this is unchecked."
msgstr "Включает или выключает пакет целиком — запуски по расписанию, срабатывание при изменении конфигурации и ручное «Создать резервную копию сейчас» бездействуют, пока этот флажок снят."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:684
msgid "Type this device's name (%s) to confirm restoring it."
msgstr "Введите имя этого устройства (%s), чтобы подтвердить восстановление."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:990
msgid "UCI paths to blank out before every commit, e.g. \"wireless.@wifi-iface[*].key\". Applied with uci -c against a scratch copy of the config tree, never touching the router’s own live configuration."
msgstr "Пути UCI, которые нужно обнулять перед каждым коммитом, например «wireless.@wifi-iface[*].key». Применяется через uci -c к черновой копии дерева конфигурации и никогда не затрагивает текущую рабочую конфигурацию роутера."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:592
msgid "Used only when \"Device identifier\" above is set to \"Custom name\"."
msgstr "Используется, только если «Идентификатор устройства» выше установлен в «Своё имя»."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:645
msgid "Valid, but the next run time could not be computed."
msgstr "Корректно, но время следующего запуска вычислить не удалось."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:543
msgid "View diff"
msgstr "Показать diff"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:666
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:970
msgid "WPA pre-shared keys (Wi-Fi passwords)"
msgstr "Общие ключи WPA (пароли Wi-Fi)"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:448
msgid "Waiting for the test to finish…"
msgstr "Ожидание завершения проверки…"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:601
msgid "Watches every UCI config in the backup set and starts a run a short while after any of them changes, instead of waiting for the next scheduled run."
msgstr "Отслеживает каждую конфигурацию UCI из набора резервного копирования и запускает резервное копирование вскоре после любого изменения, вместо ожидания следующего запуска по расписанию."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:615
msgid "Weekly, once in a randomized night window"
msgstr "Еженедельно, один раз в случайное время ночного окна"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:331
msgid "Weekly, once in a randomized night window, per device"
msgstr "Еженедельно, один раз в случайное время ночного окна, своё для каждого устройства"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:596
msgid "Where this device's files live inside the repository. \"{device}\" is replaced with the resolved device identifier."
msgstr "Где внутри репозитория находятся файлы этого устройства. «{device}» заменяется на определённый идентификатор устройства."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:667
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:971
msgid "WireGuard private keys"
msgstr "Приватные ключи WireGuard"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:461
msgid "You can restore this router to any backup listed below, using that backup's own \"Restore\" button. Click \"View diff\" first to see exactly what it would change."
msgstr "Вы можете откатить этот роутер к любой резервной копии из списка ниже, с помощью её собственной кнопки «Восстановить». Сначала нажмите «Показать diff», чтобы увидеть, что именно изменится."

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:315
msgid "a cron expression needs exactly 5 fields (minute hour day-of-month month day-of-week), got %d in \"%s\""
msgstr "cron-выражению нужно ровно 5 полей (минута час день-месяца месяц день-недели), получено %d в «%s»"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:128
msgid "and %d more"
msgstr "и ещё %d"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:305
msgid "busybox crond does not understand \"%s\" (no @-macro support on 25.12); use an explicit expression, e.g. \"0 3 * * *\" for once a day at 03:00"
msgstr "busybox crond не понимает «%s» (в 25.12 нет поддержки @-макросов); используйте явное выражение, например «0 3 * * *» для запуска раз в сутки в 03:00"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:664
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:968
msgid "dropbear private host keys"
msgstr "приватные host keys dropbear"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:940
msgid "every value listed under \"Scrub these UCI options\" below (Wi-Fi pre-shared keys by default)"
msgstr "каждое значение, перечисленное ниже в «Вычищать эти опции UCI» (по умолчанию — общие ключи Wi-Fi)"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:349
msgid "never"
msgstr "никогда"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:336
msgid "next: %s UTC"
msgstr "далее: %s UTC"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:899
msgid "paste a token to enable token authentication"
msgstr "вставьте токен, чтобы включить аутентификацию по токену"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:863
msgid "the server"
msgstr "сервер"

#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/history.js:576
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/overview.js:1049
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:1037
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:1217
#: applications/luci-app-gitbackup/htdocs/luci-static/resources/view/gitbackup/settings.js:1279
msgid "unknown error"
msgstr "неизвестная ошибка"
