#!/bin/sh /etc/rc.common

START=80
STOP=20
USE_PROCD=1

PROG=/usr/sbin/aliddns
PIDFILE=/var/run/aliddns/aliddns.pid

EXTRA_COMMANDS="trigger status_json"
EXTRA_HELP="	trigger         Trigger an immediate DDNS synchronization
	status_json     Print current JSON status"

start_service() {
	config_load aliddns
	local enable
	config_get_bool enable base enable 0

	mkdir -p /var/run/aliddns
	chmod 0700 /var/run/aliddns

	if [ "$enable" -eq 0 ]; then
		rm -f "$PIDFILE"
		return 0
	fi

	procd_open_instance "main"
	procd_set_param command /usr/bin/ucode -g 500 "$PROG" --daemon
	procd_set_param pidfile "$PIDFILE"
	procd_set_param file /etc/config/aliddns
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$PIDFILE"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "aliddns"
}

trigger() {
	if [ -f "$PIDFILE" ]; then
		local pid
		pid="$(cat "$PIDFILE" 2>/dev/null)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -USR1 "$pid" 2>/dev/null && return 0
		fi
	fi
	/usr/bin/ucode "$PROG" --force
}

status_json() {
	/usr/bin/ucode "$PROG" --status
}
