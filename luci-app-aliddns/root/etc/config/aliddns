config base 'base'
	option enable '0'
	option time '10'
	option ttl '600'
	option line 'default'
	option clean '0'
	option hotplug '1'
	option verify_ssl '1'

config record 'main'
	option enabled '1'
	option sub_domain '@'
	option main_domain ''
	option ipv4 '1'
	option interface 'wan'
	option ipv6 '0'
	option interface6 'wan6'
