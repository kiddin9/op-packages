#!/bin/sh
[ ! -f "/usr/share/ucitrack/luci-app-aliddns.json" ] && {
    cat > /usr/share/ucitrack/luci-app-aliddns.json << EEOF
{
    "config": "aliddns",
    "init": "aliddns"
}
EEOF
}

# 1. Clean up legacy v0.4.x cron entries and runtime-generated hotplug scripts
if [ -f /etc/crontabs/root ] && grep -q '/usr/sbin/aliddns' /etc/crontabs/root 2>/dev/null; then
	sed -i '\|/usr/sbin/aliddns|d' /etc/crontabs/root 2>/dev/null || true
	/etc/init.d/cron reload >/dev/null 2>&1 || true
fi

# 2. Seamless migration from legacy v0.4.x single-domain base section to multi-record schema
if [ -f /etc/config/aliddns ]; then
	chmod 0600 /etc/config/aliddns 2>/dev/null || true

	legacy_main="$(uci -q get aliddns.base.main_domain)"
	if [ -n "$legacy_main" ]; then
		legacy_sub="$(uci -q get aliddns.base.sub_domain)"
		[ -z "$legacy_sub" ] && legacy_sub="@"
		legacy_ipv4="$(uci -q get aliddns.base.ipv4)"
		[ -z "$legacy_ipv4" ] && legacy_ipv4="1"
		legacy_iface="$(uci -q get aliddns.base.interface)"
		[ -z "$legacy_iface" ] && legacy_iface="wan"
		legacy_ipv6="$(uci -q get aliddns.base.ipv6)"
		[ -z "$legacy_ipv6" ] && legacy_ipv6="0"
		legacy_iface6="$(uci -q get aliddns.base.interface6)"
		[ -z "$legacy_iface6" ] && legacy_iface6="wan6"

		has_record="$(uci -q show aliddns | grep -c '=record$' || true)"
		if [ "${has_record:-0}" -eq 0 ]; then
			sec="$(uci -q add aliddns record)"
		else
			sec="$(uci -q show aliddns | sed -n 's/^aliddns\.\([^.=]*\)=record$/\1/p' | head -n 1)"
		fi

		if [ -n "$sec" ]; then
			curr_dm="$(uci -q get "aliddns.${sec}.main_domain")"
			if [ -z "$curr_dm" ]; then
				uci -q set "aliddns.${sec}.enabled=1"
				uci -q set "aliddns.${sec}.main_domain=${legacy_main}"
				uci -q set "aliddns.${sec}.sub_domain=${legacy_sub}"
				uci -q set "aliddns.${sec}.ipv4=${legacy_ipv4}"
				uci -q set "aliddns.${sec}.interface=${legacy_iface}"
				uci -q set "aliddns.${sec}.ipv6=${legacy_ipv6}"
				uci -q set "aliddns.${sec}.interface6=${legacy_iface6}"
			fi
		fi

		for opt in main_domain sub_domain ipv4 interface ipv6 interface6 record_id record_id6; do
			uci -q delete "aliddns.base.${opt}" || true
		done

		[ -z "$(uci -q get aliddns.base.ttl)" ] && uci -q set aliddns.base.ttl='600'
		[ -z "$(uci -q get aliddns.base.line)" ] && uci -q set aliddns.base.line='default'
		[ -z "$(uci -q get aliddns.base.hotplug)" ] && uci -q set aliddns.base.hotplug='1'
		[ -z "$(uci -q get aliddns.base.verify_ssl)" ] && uci -q set aliddns.base.verify_ssl='1'
		uci -q commit aliddns
	fi
fi

# 3. Register ucitrack reload hook idempotently
uci -q batch <<-EOF >/dev/null
	delete ucitrack.@aliddns[0]
	delete ucitrack.@aliddns[0]
	add ucitrack aliddns
	set ucitrack.@aliddns[-1].init='aliddns'
	commit ucitrack
EOF

exit 0
