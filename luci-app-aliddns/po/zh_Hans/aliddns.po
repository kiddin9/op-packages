msgid "AliDDNS"
msgstr "阿里云 DDNS"

msgid "Alibaba Cloud Free Edition supports 600–86400 seconds; Paid Editions support down to 1 second."
msgstr "阿里云云解析免费版支持 600–86400 秒，个人版/企业版最低支持 1 秒。"

msgid "Alibaba Cloud RAM AccessKey ID with AliyunDNSFullAccess permission."
msgstr "具备云解析 AliyunDNSFullAccess 权限的阿里云 RAM 子账号 AccessKey ID。"

msgid "All Log Levels"
msgstr "全部日志级别"

msgid "Also send an alert when synchronization fails (rate-limited to once every 30 minutes per domain)."
msgstr "同步异常时也发送告警通知（每个域名内置 30 分钟冷却防刷屏）。"

msgid "Auto Detect (GET for URL templates, POST JSON for IM bots)"
msgstr "智能识别（URL 模板走 GET，钉钉/飞书/企微走 POST JSON）"

msgid "Auto refresh"
msgstr "自动刷新"

msgid "Automatically filters Global Unicast IPv6 (2000::/3) and supports PPPoE dynamic wan_6 and prefix-delegated interfaces."
msgstr "自动筛选公网单播 IPv6（2000::/3），原生支持 PPPoE 动态虚拟接口 wan_6 与前缀委派接口。"

msgid "Automatically synchronize dynamic public IPv4 and IPv6 addresses to Alibaba Cloud DNS via native OpenWrt 25.12 ucode daemon."
msgstr "基于 OpenWrt 25.12 原生 ucode 事件驱动守护进程，自动将动态公网 IPv4 / IPv6 地址同步至阿里云云解析 DNS。"

