#: htdocs/luci-static/resources/protocol/openvpnc.js:57
msgid "OpenVPN Client"
msgstr "OpenVPN 客户端"

#: htdocs/luci-static/resources/protocol/openvpnc.js:87
msgid "OpenVPN configuration"
msgstr "OpenVPN 配置文件"

#: htdocs/luci-static/resources/protocol/openvpnc.js:94
msgid "Current profile: %s"
msgstr "当前配置文件：%s"

#: htdocs/luci-static/resources/protocol/openvpnc.js:95
msgid "No profile uploaded"
msgstr "尚未上传配置文件"

#: htdocs/luci-static/resources/protocol/openvpnc.js:109
msgid "Choose an .ovpn file with embedded certificates and keys. Save to upload it to %s."
msgstr "请选择内嵌证书和密钥的 .ovpn 文件，点击保存后上传到 %s。"

#: htdocs/luci-static/resources/protocol/openvpnc.js:122
msgid "Choose an .ovpn file to upload"
msgstr "请选择要上传的 .ovpn 文件"

#: htdocs/luci-static/resources/protocol/openvpnc.js:127
msgid "Choose a non-empty .ovpn file"
msgstr "请选择非空的 .ovpn 文件"

#: htdocs/luci-static/resources/protocol/openvpnc.js:142
msgid "Username"
msgstr "用户名"

#: htdocs/luci-static/resources/protocol/openvpnc.js:143
msgid "If your VPN requires a username and password, enter both here. OpenVPN saves them in the interface’s .auth file when it starts."
msgstr "如果 VPN 需要用户名和密码，请同时填写。连接启动时会将凭据保存到此接口的 .auth 文件。"

#: htdocs/luci-static/resources/protocol/openvpnc.js:146
msgid "Password"
msgstr "密码"

#: htdocs/luci-static/resources/protocol/openvpnc.js:150
msgid "Allow custom DNS servers"
msgstr "启用自定义 DNS 服务器"

#: htdocs/luci-static/resources/protocol/openvpnc.js:151
msgid "When enabled, the DNS servers entered below will be added to this interface even if the OpenVPN server does not push any DNS settings."
msgstr "启用后，即使 OpenVPN 服务端没有下发 DNS 设置，下方填写的 DNS 服务器也会被加入到此接口中。"

#: htdocs/luci-static/resources/protocol/openvpnc.js:155
msgid "Custom DNS servers"
msgstr "自定义 DNS 服务器"

#: htdocs/luci-static/resources/protocol/openvpnc.js:156
msgid "Enter one or more DNS server addresses separated by spaces or commas, for example: 1.1.1.1,8.8.8.8"
msgstr "输入一个或多个 DNS 服务器地址，使用空格或逗号分隔，例如：1.1.1.1,8.8.8.8"

#: htdocs/luci-static/resources/protocol/openvpnc.js:161
msgid "Allow extra route networks"
msgstr "启用附加路由网段"

#: htdocs/luci-static/resources/protocol/openvpnc.js:162
msgid "When enabled, the custom route networks entered below will be appended after the route networks pushed by the OpenVPN server."
msgstr "启用后，下方填写的自定义路由网段会追加到 OpenVPN 服务端下发的路由网段之后。"

#: htdocs/luci-static/resources/protocol/openvpnc.js:166
msgid "Extra route networks"
msgstr "附加路由网段"

#: htdocs/luci-static/resources/protocol/openvpnc.js:167
msgid "Enter one or more IPv4 CIDR networks separated by spaces or commas, for example: 10.0.0.0/24,172.16.10.0/24"
msgstr "输入一个或多个 IPv4 CIDR 网段，使用空格或逗号分隔，例如：10.0.0.0/24,172.16.10.0/24"

#: htdocs/luci-static/resources/protocol/openvpnc.js:172
msgid "Resolve specific domains via custom DNS"
msgstr "使用自定义 DNS 解析特定域名"

#: htdocs/luci-static/resources/protocol/openvpnc.js:173
msgid "When enabled, dnsmasq will forward the domains entered below to the custom DNS servers through the generated ovpnc.conf file in its active conf-dir directory."
msgstr "启用后，dnsmasq 会在当前生效的 conf-dir 目录中生成 ovpnc.conf，并将下方填写的域名转发到自定义 DNS 服务器。"

#: htdocs/luci-static/resources/protocol/openvpnc.js:178
msgid "Domains resolved by custom DNS"
msgstr "由自定义 DNS 解析的域名"

#: htdocs/luci-static/resources/protocol/openvpnc.js:179
msgid "Enter one or more domains separated by spaces or commas, for example: corp.example.com"
msgstr "输入一个或多个域名，使用空格或逗号分隔，例如：corp.example.com"

#: htdocs/luci-static/resources/protocol/openvpnc.js:184
msgid "Override MTU"
msgstr "自定义 MTU"
