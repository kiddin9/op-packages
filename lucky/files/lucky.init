#!/bin/sh /etc/rc.common
# Copyright (C) 2021-2024 daji <https://github.com/gdy666/lucky>

START=99
USE_PROCD=1

PROG=/usr/bin/lucky
DEFAULT_PRO_CONF='/etc/config/lucky.daji/'

lucky_instance() {
    local cfg="$1"
    local enabled configdir logger

    config_get_bool enabled "$cfg" enabled 0
    config_get configdir "$cfg" configdir "$DEFAULT_PRO_CONF"
    config_get_bool logger "$cfg" logger 1

    [ "$enabled" -eq 1 ] || return 0

    [ -d "$configdir" ] || mkdir -p "$configdir" 2>/dev/null

    procd_open_instance "$cfg"
    procd_set_param command "$PROG" -cd "$configdir"
    procd_set_param respawn
    procd_set_param stdout "$logger"
    procd_set_param stderr "$logger"
    procd_close_instance
}

start_service() {
    # 强制清理可能脱离 procd 管控的独立进程（如通过 Lucky 面板自行更新/重启产生的孤儿进程）
    local pids=$(pidof /usr/bin/lucky)
    [ -n "$pids" ] && kill -9 $pids >/dev/null 2>&1 || true

    config_load lucky
    config_foreach lucky_instance lucky
}

stop_service() {
    local pids=$(pidof /usr/bin/lucky)
    [ -n "$pids" ] && kill -9 $pids >/dev/null 2>&1 || true
}

service_triggers() {
    procd_add_reload_trigger "lucky"
}

reload_service() {
	restart
}
